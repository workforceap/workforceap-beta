---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

// Member journey — single source of truth mirrored from the Next site
// (lib/content/marketingJourneySteps.ts), grouped into three phases.
const PHASES = [
  {
    id: 1,
    label: 'Phase 1 — Get Started',
    title: 'Get Started',
    steps: [
      {
        num: 1,
        title: 'Apply',
        desc: 'Fill out a short online form — no test, no gatekeeping. We use it to learn what matters to you so we can help in ways that fit your life. We follow up with your next step in 1 to 2 business days.',
        why: 'So we can personalize your path instead of sending you into a generic funnel.',
      },
      {
        num: 2,
        title: 'Overview & Eligibility Review',
        desc: 'Review programs, timelines, and eligibility together. This is a conversation, not an exam — we want you to feel steady and clear before you commit.',
        why: 'You deserve to know exactly what you are signing up for.',
      },
      {
        num: 3,
        title: 'Membership Enrollment',
        desc: 'Qualifying members can access training through funded pathways. All members get clear next steps, resources, and support — without hidden fees.',
        why: 'We remove money as a barrier so you can focus on learning.',
      },
      {
        num: 4,
        title: 'Skills Assessment',
        desc: 'Skills and goals evaluation so we can match you with the right career path. Not a pass/fail test — a welcoming way to shape your journey.',
        why: 'The right program for you is the one that fits your situation and goals.',
      },
      {
        num: 5,
        title: 'Interview',
        desc: 'A one-on-one to answer your questions and confirm fit. We’re making sure this is right for you — and that you feel ready for it.',
        why: 'Mutual fit matters. We succeed when you succeed.',
      },
    ],
  },
  {
    id: 2,
    label: 'Phase 2 — Train',
    title: 'Train',
    steps: [
      {
        num: 6,
        title: 'Resources & Workforce Readiness',
        desc: 'Soft skills, job search basics, and workplace expectations — plus loaner laptops, resume support, and on-demand tools. Often the part that helps people feel steady before and after training.',
        why: 'Credentials open doors; readiness and resources help you walk through them.',
      },
      {
        num: 7,
        title: 'Training',
        desc: 'Industry certification courses — taught by certified instructors or approved online platforms. Real credentials employers recognize.',
        why: 'Real credentials, not certificates of attendance.',
      },
      {
        num: 8,
        title: 'Certificate Completion',
        desc: 'Earn credentials recognized by employers — CompTIA, AWS, Google, Microsoft, and more. You leave with proof employers respect.',
        why: 'Your resume needs more than “I took a class.”',
      },
    ],
  },
  {
    id: 3,
    label: 'Phase 3 — Launch Your Career',
    title: 'Launch Your Career',
    steps: [
      {
        num: 9,
        title: 'Job Readiness & Placement Assistance',
        desc: 'Resume review, interview prep, employer-facing support, and job-search guidance after training. We stay focused on practical next steps after you graduate.',
        why: 'We’re invested in your job-search readiness, not just your last exam.',
      },
      {
        num: 10,
        title: 'Career Opportunities & Growth',
        desc: 'Build toward a career that pays. Wage outcomes vary by role, market, experience, and employer, so we focus on helping you show credible skills and keep growing.',
        why: 'This is the outcome we’re both working toward.',
      },
    ],
  },
];

const trainingCards = [
  { ic: 'graduation-cap', cls: 'ic--c', title: 'Program Cost Coverage', desc: 'Approved certification tracks and technical bootcamps are funded through grants and partnerships.' },
  { ic: 'handshake', cls: 'ic--b', title: 'Peer Networks', desc: 'Access to an exclusive community of members and alumni for mentorship and networking.' },
  { ic: 'trending-up', cls: 'ic--g', title: 'Direct Pipeline', desc: 'Support connecting to openings shared through our employer network and placement efforts.' },
  { ic: 'lightbulb', cls: 'ic--gr', title: 'Soft Skill Coaching', desc: 'Dedicated sessions on leadership, communication, and emotional intelligence.' },
];

// Program commitment panel — mirrored from components/portal/ProgramCommitmentPanel.tsx
const WILL_DO = [
  'Career training and professional certificate pathways (Coursera-aligned tracks)',
  'Counselor messaging, application review, and program assignment',
  'AI toolkit for resumes, interview practice, job match insights, and learning support',
  'Job board access, application tracker, and employer pipeline connections where available',
];
const WILL_NOT = [
  'Guaranteed job placement or a specific employer hire',
  'Automatic enrollment in vendor certification exams (PMI, AWS, CompTIA, etc.) without staff confirmation',
  'Legal eligibility determinations for WIOA or other funding — staff review applies',
];
---
<Layout
  title="How It Works — WorkforceAP"
  description="Your path from application through certification and job placement — organized into three phases so you always know what we’re focusing on together."
>
<div class="hiw">

  <!-- ============================================================
       HERO — DEPTH STAGE (shorter band): radial crimson→plum,
       gold/crimson/white auras, luminosity-masked photo, gold pill,
       white headline, and a translucent glass "who can apply" card.
       ============================================================ -->
  <section class="stage">
    <div class="aura aura--1"></div>
    <div class="aura aura--2"></div>
    <div class="aura aura--3"></div>
    <div class="grain"></div>

    <div class="wrap stage-grid">
      <div class="lede">
        <span class="pill"><span class="pill__star"><Icon name="star" size={13} /></span>Member Experience</span>
        <h1>Your path <span class="shimmer">starts here.</span></h1>
        <p class="sub">No gatekeeping. Clear, funded pathways for qualifying members. Just a guided process — from your first conversation with us to your first day on the job (and beyond).</p>
        <div class="acts">
          <a class="dbtn dbtn--solid" href="/find-your-path">Find your career <span>→</span></a>
          <a class="dbtn dbtn--glass" href="/apply">Apply now</a>
          <a class="dbtn dbtn--glass" href="/programs">View programs</a>
        </div>
      </div>

      <!-- Who can apply — translucent glass card -->
      <div class="applyglass">
        <span class="ag-eyebrow"><span class="ag-dot"></span>Who Can Apply</span>
        <h2>Who can apply</h2>
        <p>WorkforceAP is designed for adults who face barriers to employment — including low-income individuals, people with employment gaps, those with limited or no formal work history, justice-involved individuals, dislocated workers, veterans, and adult learners seeking a career change. WIOA eligibility can unlock additional funding.</p>
        <a class="wioa" href="/apply">Check WIOA options →</a>
      </div>
    </div>
  </section>

  <!-- THE JOURNEY — light band, glass/elevated step cards -->
  <section class="band band--surface" id="journey"><div class="wrap">
    <div class="sec-head">
      <span class="kick kick--crimson">The Journey</span>
      <h2>What Happens After You <span class="grad-text">Apply</span></h2>
      <p>Three phases — get oriented, train and earn credentials, then move into work with people beside you the whole way.</p>
    </div>

    {PHASES.map((phase) => (
      <div class="phase">
        <div class="rail">
          <div class="pnum">{phase.id}</div>
          <div class="line" aria-hidden="true"></div>
        </div>
        <div class="pbody">
          <div class="plabel">{phase.label}</div>
          <h3 class="ptitle">{phase.title}</h3>
          <div class="jsteps">
            {phase.steps.map((step) => (
              <div class="si">
                <span class="sidot">{step.num}</span>
                <div>
                  <div class="st">{step.title}</div>
                  <div class="sdesc">{step.desc}</div>
                  <div class="swhy"><b>Why:</b> {step.why}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    ))}

    <!-- Mid-page CTA — avoid dead-end after the timeline -->
    <div class="midcta">
      <p>About ten minutes, no application fee — a conversation, not an exam.</p>
      <div class="acts">
        <a class="btn btn--primary" href="/apply">Apply For Next Cohort</a>
        <a class="btn btn--ghost" href="/find-your-path">Find your career</a>
      </div>
    </div>
  </div></section>

  <!-- CAREER TRAINING BENEFITS — bold light band -->
  <section class="band band--cream"><div class="wrap">
    <div class="sec-head">
      <span class="kick kick--crimson">Career Training Benefits</span>
      <h2>Career Training <span class="grad-text">Benefits</span></h2>
    </div>
    <div class="benefitrows">
      {trainingCards.map((card) => (
        <div class="brow">
          <div class={`bic ${card.cls}`}><Icon name={card.ic} size={22} /></div>
          <div class="btext"><h3>{card.title}</h3><p>{card.desc}</p></div>
        </div>
      ))}
    </div>
  </div></section>

  <!-- SUPPORT FEATURES — light surface band -->
  <section class="band band--surface"><div class="wrap">
    <div class="feat">
      <div class="fcard">
        <div class="ic ic--b"><Icon name="laptop" /></div>
        <h3>Loaner Laptop Program</h3>
        <p>Access to technology shouldn’t be a barrier to education. We provide high-performance laptops to members who need them for the duration of their training program.</p>
        <ul>
          <li><span class="chk"><Icon name="check" size={14} /></span> Pre-configured with all necessary software</li>
          <li><span class="chk"><Icon name="check" size={14} /></span> Technical support included</li>
          <li><span class="chk"><Icon name="check" size={14} /></span> No upfront program cost for qualifying members</li>
        </ul>
      </div>
      <div class="fcard">
        <div class="ic ic--g"><Icon name="calendar" /></div>
        <h3>150-Day Post-Hire Support</h3>
        <p>We don’t just find you a job; we help you keep it. Our support continues for five months after your start date.</p>
        <div class="bgrid">
          <div class="bcell"><div class="blab">Benefit 01</div><div class="bval">Monthly Check-ins</div></div>
          <div class="bcell"><div class="blab">Benefit 02</div><div class="bval">Conflict Resolution</div></div>
          <div class="bcell"><div class="blab">Benefit 03</div><div class="bval">Advancement Coaching</div></div>
        </div>
      </div>
    </div>
  </div></section>

  <!-- PROGRAM COMMITMENT PANEL — bold light band -->
  <section class="band band--cream"><div class="wrap">
    <div class="commit" aria-labelledby="commit-head">
      <h2 id="commit-head">What we will — and will not — promise</h2>
      <p class="commit-intro">WorkforceAP provides <strong>career and employment assistance</strong>: training, tools, and staff support to improve your odds. We are transparent so partners and members can set expectations together.</p>
      <div class="commit-grid">
        <div class="commit-card commit-card--will">
          <h3 class="commit-label commit-label--will">We will</h3>
          <ul>
            {WILL_DO.map((line) => (<li>{line}</li>))}
          </ul>
        </div>
        <div class="commit-card commit-card--wont">
          <h3 class="commit-label commit-label--wont">We will not</h3>
          <ul>
            {WILL_NOT.map((line) => (<li>{line}</li>))}
          </ul>
        </div>
      </div>
    </div>
  </div></section>

  <!-- FINAL CTA — bold full-bleed crimson with photo luminosity -->
  <section class="close">
    <div class="close__media" aria-hidden="true"></div>
    <div class="close__veil" aria-hidden="true"></div>
    <div class="close__inner wrap">
      <h2>Ready to take the first step?</h2>
      <p>The application takes about ten minutes. It’s a conversation, not an exam — and there’s no application fee.</p>
      <div class="acts acts--center">
        <a class="bbtn bbtn--gold" href="/apply">Apply For Next Cohort</a>
        <a class="bbtn bbtn--outline" href="/contact">Speak with an Advisor</a>
      </div>
    </div>
  </section>

</div>

<style>
  /* ===================================================================
     HOW IT WORKS — DEPTH-LED restyle to match the home.
     depth stage hero + glass apply card → light journey/benefit bands
     with elevated cards → bold full-bleed crimson closing CTA.
     =================================================================== */
  .hiw{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}

  /* ---------------- DEPTH HERO STAGE (shorter band) ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:84px 0 96px;
  }
  .stage-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:54px;align-items:center;position:relative;z-index:2}

  /* glow auras — gold + crimson + white */
  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:520px;height:520px;top:-160px;right:-120px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:460px;height:460px;bottom:-200px;left:-140px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:380px;height:380px;top:30%;left:44%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%)}

  /* luminosity-masked real photo bleeding in from the right */
  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:soft-light;pointer-events:none;
    background-image:var(--wap-hero-photo-url);background-size:cover;background-position:center 35%;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,rgba(0,0,0,.35) 28%,#000 72%);
    mask-image:linear-gradient(90deg,transparent 0%,rgba(0,0,0,.35) 28%,#000 72%);opacity:.42}

  /* gold PILL — fully visible, never clipped */
  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:var(--grad-gold);color:var(--gold-ink);font-weight:800;font-size:13px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{font-size:13px;opacity:.95}
  @media(max-width:430px){.pill{white-space:normal;text-align:left}}

  .lede h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(40px,5.4vw,66px);
    line-height:1.03;letter-spacing:-.03em;margin:22px 0 0}
  .shimmer{background:var(--grad-gold-shimmer);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .lede .sub{font-size:19px;line-height:1.55;color:rgba(255,255,255,.84);max-width:34em;margin:22px 0 30px}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}

  /* Who-can-apply — translucent glass card on the stage */
  .applyglass{position:relative;z-index:2;border-radius:22px;padding:30px 32px;
    background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(18px);
    box-shadow:var(--shadow-glass);color:#fff}
  .ag-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:800;letter-spacing:.1em;
    text-transform:uppercase;color:rgba(255,255,255,.8)}
  .ag-dot{width:8px;height:8px;border-radius:50%;background:var(--gold-glow);box-shadow:0 0 10px var(--gold-glow)}
  .applyglass h2{font-family:'Plus Jakarta Sans',sans-serif;font-size:26px;font-weight:800;margin:12px 0 12px}
  .applyglass p{color:rgba(255,255,255,.85);font-size:15.5px;line-height:1.6}
  .wioa{display:inline-flex;margin-top:16px;font-weight:800;color:var(--gold-glow);padding:8px 2px;min-height:44px;align-items:center}

  /* ---------------- LIGHT BANDS ---------------- */
  .band{padding:var(--sec-pad) 0}
  .band--surface{background:var(--surface)}
  .band--cream{background:var(--bg)}

  .sec-head{text-align:center;max-width:760px;margin:0 auto 56px}
  .kick{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin-bottom:16px}
  .kick--crimson{color:var(--crimson)}
  .sec-head h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(32px,4.6vw,54px);line-height:1.04;letter-spacing:-.02em}
  .sec-head p{margin-top:16px;color:var(--muted);font-size:18px;line-height:1.55}
  .grad-text{background:linear-gradient(100deg,var(--crimson),var(--gold-dark));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}

  /* Journey phases */
  .phase{display:grid;grid-template-columns:64px 1fr;gap:24px;max-width:880px;margin:0 auto}
  .rail{display:flex;flex-direction:column;align-items:center}
  .pnum{width:54px;height:54px;border-radius:16px;background:var(--grad);color:#fff;display:grid;place-items:center;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:22px;flex-shrink:0;box-shadow:0 12px 30px -10px rgba(173,44,77,.5)}
  .line{flex:1;width:2px;background:linear-gradient(var(--border),transparent);margin:8px 0}
  .phase:last-of-type .line{display:none}
  .pbody{padding-bottom:40px}
  .plabel{font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--gold-dark)}
  .ptitle{font-family:'Plus Jakarta Sans',sans-serif;font-size:24px;font-weight:800;margin:4px 0 20px}
  .jsteps{display:flex;flex-direction:column;gap:16px}
  .si{display:flex;gap:14px;background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:20px 22px;box-shadow:var(--shadow);transition:transform .2s,box-shadow .25s}
  .si:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg)}
  .band--surface .si{background:var(--bg)}
  .sidot{width:30px;height:30px;border-radius:9px;background:rgba(173,44,77,.1);color:var(--crimson);display:grid;place-items:center;font-weight:800;font-size:14px;flex-shrink:0}
  .st{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:17px;margin-bottom:6px}
  .sdesc{color:var(--muted);font-size:15px}
  .swhy{margin-top:10px;font-size:14px;color:var(--text);background:color-mix(in srgb,var(--gold) 5%,var(--surface-2));border-left:4px solid var(--gold);border-radius:0 8px 8px 0;padding:8px 12px}
  .swhy b{color:var(--gold-dark)}

  /* Mid-page CTA */
  .midcta{max-width:680px;margin:48px auto 0;text-align:center;background:var(--surface-2);border:1px dashed var(--border);border-radius:18px;padding:30px}
  .midcta p{color:var(--muted);font-size:16px;margin-bottom:18px}
  .midcta .acts{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}

  /* Training benefit rows — borderless icon+text rows with a hairline divider
     rhythm (was an icon-in-circle card grid; re-expressed as a flat list so
     this section reads distinctly from the other icon-card grids on the site). */
  .benefitrows{max-width:880px;margin:0 auto;border-top:1px solid var(--border)}
  .brow{display:flex;align-items:flex-start;gap:20px;padding:26px 4px;border-bottom:1px solid var(--border)}
  .bic{width:40px;height:40px;border-radius:11px;display:grid;place-items:center;flex-shrink:0;margin-top:2px}
  .bic.ic--g{color:var(--gold-dark)}
  .bic.ic--c{color:var(--crimson)}
  .bic.ic--b{color:var(--blue)}
  .bic.ic--gr{color:var(--green)}
  .btext h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:18px;font-weight:800;margin-bottom:6px}
  .btext p{color:var(--muted);font-size:15px;line-height:1.55}
  .ic--g{background:rgba(164,127,56,.12)}
  .ic--c{background:rgba(173,44,77,.1)}
  .ic--b{background:rgba(45,90,160,.1)}
  .ic--gr{background:rgba(74,155,79,.12)}
  @media(max-width:560px){.brow{gap:14px}}

  /* Support features */
  .feat{display:grid;grid-template-columns:1fr 1fr;gap:22px}
  .fcard{background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);padding:32px;box-shadow:var(--shadow);transition:transform .2s,box-shadow .25s}
  .fcard:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
  .fcard .ic{width:54px;height:54px;border-radius:15px;display:grid;place-items:center;font-size:24px;margin-bottom:18px}
  .fcard h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:21px;font-weight:800;margin-bottom:10px}
  .fcard p{color:var(--muted);font-size:15px;line-height:1.55}
  .fcard ul{list-style:none;margin-top:18px;display:flex;flex-direction:column;gap:11px}
  .fcard li{display:flex;align-items:center;gap:11px;font-size:15px}
  .fcard li .chk{width:22px;height:22px;border-radius:7px;background:rgba(74,155,79,.15);color:var(--green);display:grid;place-items:center;font-size:13px;flex-shrink:0}
  .bgrid{margin-top:20px;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
  .bcell{background:var(--surface-2);border:1px solid var(--border);border-radius:13px;padding:14px}
  .blab{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--gold-dark);margin-bottom:5px}
  .bval{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:15px}
  @media(max-width:760px){.feat{grid-template-columns:1fr}.bgrid{grid-template-columns:1fr}}

  /* Program commitment panel */
  .commit{max-width:920px;margin:0 auto;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:36px 40px;box-shadow:var(--shadow);border-top:6px solid var(--crimson)}
  .commit h2{font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(24px,3vw,30px);font-weight:800;margin-bottom:12px}
  .commit-intro{color:var(--muted);font-size:16px;line-height:1.55;margin-bottom:24px}
  .commit-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
  .commit-card{background:var(--surface-2);border:1px solid var(--border);border-radius:14px;padding:22px}
  .commit-card--will{border-left:4px solid var(--green);background:color-mix(in srgb,var(--green) 5%,var(--surface-2))}
  .commit-card--wont{border-left:4px solid var(--muted);background:color-mix(in srgb,var(--muted) 5%,var(--surface-2))}
  .commit-label{font-size:13px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;margin-bottom:10px}
  .commit-label--will{color:var(--green)}
  .commit-label--wont{color:var(--muted)}
  .commit-card ul{list-style:disc;padding-left:18px;margin:0;display:flex;flex-direction:column;gap:8px}
  .commit-card li{font-size:15px;line-height:1.5;color:var(--text)}
  @media(max-width:760px){.commit-grid{grid-template-columns:1fr}.commit{padding:26px 24px}}

  /* ---------------- BOLD FULL-BLEED CLOSING CTA ---------------- */
  .close{
    position:relative;overflow:hidden;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
  }
  .close__media{position:absolute;inset:0;background:var(--wap-hero-photo-url-3) center 40%/cover no-repeat}
  .close__veil{position:absolute;inset:0;
    background:var(--wap-hero-close-veil)}
  .close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:88px 24px 96px;max-width:var(--max)}
  .close__inner h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(32px,5vw,60px);line-height:1;letter-spacing:-.03em;margin-bottom:18px}
