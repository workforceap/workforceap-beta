---
import Layout from '../../layouts/Layout.astro';
import { LEADERS, type Leader, type LeaderBioBlock } from '../../data/leadership';

// Statically generate EVERY leader detail page from the real data source.
export function getStaticPaths() {
  return LEADERS.map((leader) => ({
    params: { slug: leader.slug },
    props: { leader },
  }));
}

const { leader } = Astro.props as { leader: Leader };

/** Extract credential suffix like "PMP" or "PMP, ChE" from a name string */
function splitNameCredentials(name: string): { displayName: string; credentials: string | null } {
  const match = name.match(/^(.+?),\s*(.+)$/);
  if (!match) return { displayName: name, credentials: null };
  return { displayName: match[1], credentials: match[2] };
}

function heroBadgeFor(l: Leader): string {
  if (l.heroBadge) return l.heroBadge;
  if (l.founder) return 'Founder & Executive Leadership';
  if (l.role.includes('COO')) return 'Operational Leadership';
  if (l.role.startsWith('Board')) return 'Board of Trustees';
  return 'Leadership';
}

function heroQuoteFor(l: Leader): string {
  return (l.heroQuote ?? l.missionRelevance ?? '').trim();
}

function initialsFor(name: string): string {
  const clean = name.replace(/,.*$/, '').trim();
  const parts = clean.split(/\s+/).filter((p) => !/^(Col\.|Dr\.|Mr\.|Mrs\.|Ms\.)$/i.test(p));
  if (parts.length === 0) return name.slice(0, 2).toUpperCase();
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

const { displayName, credentials } = splitNameCredentials(leader.name);
const heroBadge = heroBadgeFor(leader);
const heroQuote = heroQuoteFor(leader);
const heroStats = leader.stats.slice(0, 2);
const spotlightCards = leader.spotlightCards ?? [];
const partnerTiles = leader.partnerTiles ?? [];
const achievementTiles = leader.achievementTiles ?? [];
const hasSideColumn = spotlightCards.length > 0;
const initials = initialsFor(leader.name);
---
<Layout
  title={`${leader.name} — ${leader.title} | WorkforceAP`}
  description={`Learn more about ${leader.name}, ${leader.title} at Workforce Advancement Project.`}
>
<div class="ld">

  <!-- ============================================================
       HERO — DEPTH STAGE: deep radial crimson→plum band, glow auras,
       luminosity-masked photo, gold verified badge, white headline +
       credentials, role, mission line, hero stat pair, LinkedIn,
       translucent glass pull-quote card.
       ============================================================ -->
  <section class="stage" aria-labelledby="ld-heading">
    <div class="aura aura--1"></div>
    <div class="aura aura--2"></div>
    <div class="aura aura--3"></div>
    <div class="grain" aria-hidden="true"></div>

    <div class="wrap stage-grid">
      <div class="lede">
        <a class="back" href="/leadership">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
          Board &amp; Leadership
        </a>

        <span class="pill">
          <svg class="pill__check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
          {heroBadge}
        </span>

        <h1 id="ld-heading">{displayName}</h1>
        {credentials && <p class="cred-line">{credentials}</p>}

        <p class="role">{leader.title}</p>
        {leader.missionRelevance && <p class="sub">{leader.missionRelevance}</p>}

        {heroStats.length > 0 && (
          <div class="hero-stats">
            {heroStats.map((s) => (
              <div class="hero-stat">
                <span class="hs-value">{s.value}</span>
                <span class="hs-label">{s.label}</span>
              </div>
            ))}
          </div>
        )}

        <div class="hero-acts">
          {leader.linkedin && (
            <a class="linkedin" href={leader.linkedin} target="_blank" rel="noopener noreferrer">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5zM.25 8h4.5v15H.25V8zm7.25 0h4.31v2.05h.06c.6-1.14 2.07-2.34 4.26-2.34 4.56 0 5.4 3 5.4 6.9V23h-4.5v-6.5c0-1.55-.03-3.55-2.16-3.55-2.16 0-2.49 1.69-2.49 3.43V23h-4.5V8z"/></svg>
              LinkedIn Profile
            </a>
          )}
          {(leader.writings?.length ?? 0) > 0 && (
            <a class="linkedin linkedin--ghost" href={leader.writings![0].href}>
              Read whitepaper
            </a>
          )}
        </div>
      </div>

      <aside class="portrait-col">
        <div class="portrait">
          {leader.image
            ? <img class="portrait-img" src={leader.image} alt={`Portrait of ${displayName}`} width="320" height="320" loading="lazy" />
            : <span class="initials" aria-hidden="true">{initials}</span>}
          {leader.founder && <span class="founder">Founder</span>}
        </div>
        {heroQuote && (
          <div class="quote-card">
            <span class="qmark" aria-hidden="true">&ldquo;</span>
            <p>{heroQuote}</p>
          </div>
        )}
      </aside>
    </div>
  </section>

  <!-- ── BIOGRAPHY BENTO ── -->
  <section class="band band--bg"><div class="wrap">
    <div class="sec-head sec-head--left">
      <span class="kick kick--crimson">Biography</span>
      <h2>About {displayName}</h2>
    </div>

    <div class={`bento${!hasSideColumn ? ' bento--full' : ''}`}>
      <div class="bio-main">
        {leader.bioBlocks.map((block: LeaderBioBlock) => {
          if (block.type === 'paragraph') return <p>{block.text}</p>;
          if (block.type === 'heading') return <h3>{block.text}</h3>;
          if (block.type === 'bullets') return (
            <ul>{block.items.map((item) => <li>{item}</li>)}</ul>
          );
          return null;
        })}
      </div>

      {hasSideColumn && (
        <div class="bio-side">
          {spotlightCards.map((card) => (
            <div class={`spot${card.variant === 'accent' ? ' spot--accent' : ''}`}>
              <span class="spot-ic" aria-hidden="true">★</span>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </div></section>

  <!-- ── ORGANIZATIONS & FOCUS AREAS ── -->
  {partnerTiles.length > 0 && (
    <section class="band band--surface"><div class="wrap">
      <div class="sec-head sec-head--left">
        <span class="kick kick--crimson">Organizations &amp; focus areas</span>
        <h2>Where the work has happened</h2>
      </div>
      <div class="tiles">
        {partnerTiles.map((p) => (
          <div class="tile">
            <span class="tile-dot" aria-hidden="true"></span>
            <h3>{p.name}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div></section>
  )}

  <!-- ── HIGHLIGHTS ── -->
  {achievementTiles.length > 0 && (
    <section class="band band--bg"><div class="wrap">
      <div class="sec-head sec-head--left">
        <span class="kick kick--gold">Highlights</span>
        <h2>Notable achievements</h2>
      </div>
      <div class="tiles">
        {achievementTiles.map((a) => (
          <div class="tile tile--gold">
            <span class="tile-dot tile-dot--gold" aria-hidden="true"></span>
            <h3>{a.title}</h3>
            <p>{a.desc}</p>
          </div>
        ))}
      </div>
    </div></section>
  )}

  {(leader.writings?.length ?? 0) > 0 && (
    <section class="band band--bg"><div class="wrap">
      <div class="sec-head sec-head--left">
        <span class="kick kick--gold">Writing</span>
        <h2>From this biography</h2>
      </div>
      <div class="tiles">
        {leader.writings!.map((w) => (
          <a class="tile tile--gold tile-link" href={w.href}>
            <span class="tile-dot tile-dot--gold" aria-hidden="true"></span>
            <h3>{w.title}</h3>
            <p>{w.description}</p>
          </a>
        ))}
      </div>
    </div></section>
  )}

  <!-- ── ALL STATS ── -->
  <section class="band band--surface"><div class="wrap">
    <div class="stats-grid">
      {leader.stats.map((s) => (
        <div class="stat">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </div></section>

  <!-- ============================================================
       CLOSING CTA — bold full-bleed crimson.
       ============================================================ -->
  <section class="close">
    <div class="close__media" aria-hidden="true"></div>
    <div class="close__veil" aria-hidden="true"></div>
    <div class="close__inner wrap">
      <h2>Collaborate for Change</h2>
      <p>Partner with us to expand workforce equity and create pathways to meaningful careers.</p>
      <div class="acts acts--center">
        <a class="bbtn bbtn--gold" href="/contact">Get in Touch</a>
        <a class="bbtn bbtn--outline" href="/leadership">Back to Team</a>
      </div>
    </div>
  </section>

</div>

<style>
  /* ===================================================================
     LEADERSHIP DETAIL — DEPTH-LED, matching /leadership parent.
     depth stage hero (crimson band) with glass pull-quote → alternating
     light bands (biography bento, partner tiles, highlights, stats) →
     bold full-bleed closing crimson CTA.
     =================================================================== */
  .ld{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}

  /* ---------------- DEPTH HERO STAGE ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:80px 0 90px;
  }
  .stage-grid{display:grid;grid-template-columns:1.45fr 1fr;gap:52px;align-items:center;position:relative;z-index:2}

  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:520px;height:520px;top:-180px;right:-120px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:440px;height:440px;bottom:-220px;left:-150px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:360px;height:360px;top:24%;left:46%;background:radial-gradient(circle,rgba(255,255,255,.15),transparent 70%)}

  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:overlay;pointer-events:none;
    background-image:var(--wap-hero-photo-url);background-size:cover;background-position:center;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);opacity:.16}

  .back{display:inline-flex;align-items:center;gap:7px;color:rgba(255,255,255,.9);font-size:13px;font-weight:700;letter-spacing:.02em;padding:6px 2px;margin:-6px 0 14px -2px}
  .back:hover{color:#fff;text-decoration:underline}

  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:linear-gradient(135deg,#e3bd6a,#a47f38);color:#3a2c10;font-weight:800;font-size:13px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__check{flex-shrink:0}
  @media(max-width:430px){.pill{white-space:normal;text-align:left}}

  .lede h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(36px,5vw,60px);
    line-height:1.04;letter-spacing:-.03em;margin:20px 0 0}
  .cred-line{font-size:clamp(13px,1.5vw,16px);font-weight:700;color:#f3d28f;letter-spacing:.06em;text-transform:uppercase;margin-top:10px}
  .lede .role{font-size:18px;font-weight:700;color:#f3d28f;margin:12px 0 0;letter-spacing:.01em}
  .lede .sub{font-size:18px;line-height:1.55;color:rgba(255,255,255,.84);max-width:34em;margin:16px 0 0}

  .hero-stats{display:flex;gap:14px;flex-wrap:wrap;margin-top:26px}
  .hero-stat{background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(10px);
    border-radius:16px;padding:16px 20px;min-width:0}
  .hs-value{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:18px;line-height:1.2;color:#fff}
  .hs-label{display:block;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#f3d28f;margin-top:6px}

  .hero-acts{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
  .linkedin{display:inline-flex;align-items:center;gap:9px;
    background:#fff;color:var(--accent-dark);font-weight:800;font-size:14.5px;
    padding:11px 20px;min-height:44px;box-sizing:border-box;border-radius:999px;box-shadow:0 14px 34px -12px rgba(58,10,30,.5)}
  .linkedin--ghost{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.55);box-shadow:none}
  .linkedin:hover{transform:translateY(-1px)}
  .linkedin:active{transform:translateY(0) scale(.985)}
  .tile-link{display:block;color:inherit;text-decoration:none}

  /* portrait + glass pull-quote companion */
  .portrait-col{display:flex;flex-direction:column;gap:20px;align-items:center}
  .portrait{position:relative;width:160px;height:160px;border-radius:32px;
    background:linear-gradient(135deg,rgba(255,255,255,.22),rgba(255,255,255,.06));
    border:1px solid rgba(255,255,255,.28);display:grid;place-items:center;
    box-shadow:0 24px 60px -24px rgba(58,10,30,.6),0 1px 0 rgba(255,255,255,.25) inset}
  .portrait .initials{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:56px;color:#fff;letter-spacing:-.03em}
  .portrait .portrait-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:inherit;display:block}
  .portrait .founder{position:absolute;bottom:-12px;left:50%;transform:translateX(-50%);white-space:nowrap;
    font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#3a2c10;
    background:linear-gradient(135deg,#e3bd6a,#a47f38);padding:5px 13px;border-radius:999px;
    box-shadow:0 8px 20px -6px rgba(164,127,56,.6)}

  .quote-card{position:relative;background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(18px);
    border-radius:22px;padding:26px 28px;color:#fff;width:100%;
    box-shadow:var(--shadow-glass)}
  .quote-card .qmark{position:absolute;top:6px;left:18px;font-family:Georgia,serif;font-size:54px;line-height:1;color:#f3d28f;opacity:.7}
  .quote-card p{font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:17px;line-height:1.45;color:#fff;margin-top:18px}

  /* ---------------- ALTERNATING LIGHT BANDS ---------------- */
  .band{width:100%;padding:var(--sec-pad,84px) 0}
  .band--bg{background:var(--bg);color:var(--text)}
  .band--surface{background:var(--surface);color:var(--text)}

  .sec-head{max-width:640px;margin:0 auto 44px}
  .sec-head--left{margin-left:0;text-align:left}
  .kick{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin-bottom:14px}
  .kick--crimson{color:var(--crimson)}
  .kick--gold{color:var(--gold-dark)}
  .sec-head h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(28px,3.8vw,42px);line-height:1.04;letter-spacing:-.02em}

  /* ---------------- BIOGRAPHY BENTO ---------------- */
  .bento{display:grid;grid-template-columns:1.7fr 1fr;gap:28px;align-items:start}
  .bento--full{grid-template-columns:1fr;max-width:820px}
  @media(max-width:880px){.bento{grid-template-columns:1fr}}

  .bio-main{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
    padding:38px 36px;box-shadow:var(--shadow);border-top:6px solid var(--crimson)}
  .bio-main p{color:var(--text);font-size:16px;line-height:1.72;margin-bottom:18px}
  .bio-main p:last-child{margin-bottom:0}
  .bio-main h3{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:18px;letter-spacing:-.01em;
    color:var(--crimson);margin:26px 0 12px}
  .bio-main ul{list-style:none;margin:0 0 18px;padding:0}
  .bio-main li{position:relative;padding-left:26px;color:var(--text);font-size:15.5px;line-height:1.65;margin-bottom:12px}
  .bio-main li::before{content:'';position:absolute;left:6px;top:10px;width:7px;height:7px;border-radius:50%;background:var(--crimson)}

  .bio-side{display:flex;flex-direction:column;gap:20px}
  .spot{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:26px 24px;box-shadow:var(--shadow)}
  .spot--accent{background:var(--grad);color:#fff;border:none;box-shadow:var(--shadow-lg)}
  .spot-ic{display:inline-grid;place-items:center;width:42px;height:42px;border-radius:13px;
    background:rgba(173,44,77,.1);color:var(--crimson);font-size:18px;margin-bottom:14px}
  .spot--accent .spot-ic{background:rgba(255,255,255,.18);color:#fff}
  .spot h3{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:18px;letter-spacing:-.01em;margin-bottom:10px}
  .spot p{font-size:14.5px;line-height:1.6;color:var(--muted)}
  .spot--accent p{color:rgba(255,255,255,.9)}

  /* ---------------- TILES (orgs / highlights) ---------------- */
  .tiles{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
  @media(max-width:720px){.tiles{grid-template-columns:1fr}}
  .tile{background:color-mix(in srgb,var(--crimson) 5%,var(--surface));border:1px solid var(--border);border-radius:var(--radius);padding:26px 26px 28px;
    box-shadow:var(--shadow);border-left:4px solid var(--crimson);transition:transform .2s,box-shadow .25s}
  .tile--gold{border-left-color:var(--gold);background:color-mix(in srgb,var(--gold) 5%,var(--surface))}
  .tile:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
  .tile-dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--crimson);margin-bottom:14px}
  .tile-dot--gold{background:var(--gold)}
  .tile h3{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:18px;letter-spacing:-.01em;margin-bottom:8px;color:var(--text)}
  .tile p{font-size:15px;line-height:1.55;color:var(--muted)}

  /* ---------------- STATS ---------------- */
  .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px;justify-content:center;max-width:fit-content;margin:0 auto}
  @media(max-width:880px){.stats-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:480px){.stats-grid{grid-template-columns:1fr}}
  .stat{background:var(--bg);border:1px solid var(--border);border-radius:18px;padding:26px 22px;text-align:center}
  .stat-value{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(18px,2vw,22px);
    line-height:1.2;background:var(--grad-text);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .stat-label{display:block;font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-top:10px}

  /* ---------------- BOLD FULL-BLEED CLOSING CTA ---------------- */
  .close{position:relative;overflow:hidden;width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw}
  .close__media{position:absolute;inset:0;background:var(--wap-hero-photo-url-3) center 40%/cover no-repeat}
  .close__veil{position:absolute;inset:0;
    background:var(--wap-hero-close-veil)}
  .close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:84px 24px 92px;max-width:var(--max)}
  .close__inner h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(32px,5vw,56px);line-height:1;letter-spacing:-.03em;margin-bottom:16px}
  .close__inner p{font-size:clamp(17px,2.2vw,21px);color:rgba(255,255,255,.92);max-width:38em;margin:0 auto 28px;line-height:1.5}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}

  /* ---------------- RESPONSIVE ---------------- */
  @media (prefers-reduced-motion: no-preference){
    .quote-card{animation:ld-float 8s ease-in-out infinite}
    @keyframes ld-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
  }
  @media(max-width:960px){
    .stage{padding:62px 0 74px}
    .stage-grid{grid-template-columns:1fr;gap:36px}
    .portrait-col{align-items:flex-start}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
  }
  @media(max-width:560px){
    .band{padding:58px 0}
    .bio-main{padding:28px 22px}
    .acts .bbtn{width:100%}
  }
</style>
</Layout>
