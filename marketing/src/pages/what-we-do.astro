---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout
  title="What We Do — Workforce Development Training & Industry Certificates"
  description="WorkforceAP is built on 25+ years of workforce development leadership. Employer-aligned training, career support, and funded pathways for qualifying members."
>
<div class="wwd">

  <!-- ============================================================
       HERO — DEPTH STAGE (shorter band): deep radial crimson→plum,
       gold/crimson/white glow auras, luminosity-masked photo,
       gold pill, white text, translucent glass stat card.
       ============================================================ -->
  <section class="stage">
    <div class="aura aura--1"></div>
    <div class="aura aura--2"></div>
    <div class="aura aura--3"></div>
    <div class="grain"></div>

    <div class="wrap stage-grid">
      <div class="lede">
        <span class="pill"><span class="pill__star"><Icon name="star" size={11} /></span>Built on Decades of Workforce Experience</span>
        <h1>Creating <span class="shimmer">Opportunity</span></h1>
        <p class="sub">Employer-aligned training. No cost for members who qualify through scholarship/grant funded membership. Career support throughout the journey. A model that works — and scales.</p>
        <div class="acts">
          <a class="dbtn dbtn--solid" href="/programs">Explore Our Impact <span>→</span></a>
          <a class="dbtn dbtn--glass" href="/contact?topic=partnership">Partner With Us</a>
        </div>
        <div class="proof">
          <div class="proof-i"><b>25+ years</b><span>in workforce development</span></div>
          <div class="proof-i"><b>$0</b><span>for members who qualify through scholarship/grant funded membership</span></div>
          <div class="proof-i"><b>501(c)(3)</b><span>nonprofit, nationwide</span></div>
        </div>
      </div>

      <!-- translucent glass stat card -->
      <div class="deck">
        <div class="gcard">
          <div class="gcard-tag">Years Experience</div>
          <div class="gcard-k">25+</div>
          <div class="gcard-sub">Built on 25+ years of workforce development leadership.</div>
          <div class="gchips">
            <span>Employer-aligned</span>
            <span>Scholarship/grant-funded</span>
            <span>Nationwide</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FIND YOUR PATH -->
  <section class="findband">
    <div class="wrap findpath">
      <p>Not sure where to start?</p>
      <div class="acts">
        <a class="btn btn--primary" href="/find-your-path">Find Your Path Quiz</a>
        <a class="btn btn--ghost" href="/apply">Check WIOA Options</a>
      </div>
    </div>
  </section>

  <!-- LEGACY -->
  <section class="blk blk--surface"><div class="wrap">
    <div class="legacy">
      <div class="legacy__media">
        <div class="legacy__img"></div>
        <div class="legacy__badge">
          <div class="k">25+</div>
          <div class="s">Years Experience</div>
        </div>
      </div>
      <div class="legacy__text">
        <h2>Investing in the Future <span class="grad-text">Workforce</span></h2>
        <blockquote>Built on 25+ years of workforce development leadership across Goodwill, Austin Area Urban League, and state and local initiatives. We know what works. Employers help shape talent pipelines. Grants and partnerships fund access. Members who qualify through scholarship/grant funded membership pay nothing.</blockquote>
        <p>Some programs may align with <strong>WIOA (Workforce Innovation and Opportunity Act)</strong> eligibility criteria, including low-income individuals, dislocated workers, adult learners, and veterans seeking career advancement.</p>
        <div class="legacy__chip">
          <div class="k">Nonprofit &amp; 501(c)(3)</div>
          <div class="s">WorkforceAP is a national nonprofit and 501(c)(3) organization serving communities nationwide.</div>
        </div>
      </div>
    </div>
  </div></section>

  <!-- MAKING AN IMPACT — BENTO -->
  <section class="blk blk--cream"><div class="wrap">
    <div class="head">
      <span class="kick kick--crimson">Our Values</span>
      <h2>What guides <span class="grad-text">everything we do</span></h2>
    </div>
    <ol class="valuelist">
      <li class="vitem"><span class="vnum">01</span><div class="vbody"><h3>Employer-Influenced Curricula</h3><p>Training programs shaped with employer input — Google, IBM, AWS, Microsoft, CompTIA — so credentials map to real hiring needs.</p></div></li>
      <li class="vitem"><span class="vnum">02</span><div class="vbody"><h3>Zero-Barrier Access</h3><p>No cost for members who qualify through scholarship/grant funded membership. No prerequisites. Funding comes from WIOA, grants, employer partners, and community partnerships that can cover access for eligible participants.</p></div></li>
      <li class="vitem"><span class="vnum">03</span><div class="vbody"><h3>Validated Outcomes</h3><p>Industry-recognized certificates. Skills assessments. Job placement support. We track member progress and career outcomes over time.</p></div></li>
      <li class="vitem"><span class="vnum">04</span><div class="vbody"><h3>Regional Scalability</h3><p>A repeatable model built to serve communities nationwide — not just one local market.</p></div></li>
    </ol>
  </div></section>

  <!-- VALUES -->
  <section class="blk blk--surface"><div class="wrap">
    <div class="steps">
      <div class="stepcard"><div class="num">01</div><h3>Access as Foundation</h3><p>Fair access to opportunity. We work with community organizations, public partners, and employers so more people can reach training and careers.</p></div>
      <div class="stepcard"><div class="num">02</div><h3>Outcome Focus</h3><p>Every program, partnership, and investment is designed to expand opportunities, strengthen skills, and deliver meaningful life and career outcomes.</p></div>
      <div class="stepcard"><div class="num">03</div><h3>Key Partnerships</h3><p>Government, Employers, Non-profit &amp; Community Organizations, and Churches — we bring the right people together so members don't have to figure it out alone.</p></div>
    </div>
  </div></section>

  <!-- ============================================================
       CLOSING CTA — BOLD full-bleed crimson, photo luminosity.
       ============================================================ -->
  <section class="close">
    <div class="close__media" aria-hidden="true"></div>
    <div class="close__veil" aria-hidden="true"></div>
    <div class="close__inner wrap">
      <h2>Ready to build your future?</h2>
      <p>Join hundreds of members who've taken the first step toward a meaningful career. Our programs are offered no cost for members who qualify through scholarship/grant funded membership.</p>
      <div class="acts acts--center">
        <a class="bbtn bbtn--gold" href="/apply">Apply Now →</a>
        <a class="bbtn bbtn--outline" href="/programs">Browse Programs</a>
      </div>
    </div>
  </section>

</div>

<style>
  /* ===================================================================
     WHAT-WE-DO — DEPTH aesthetic matching the home.
     shorter depth stage hero → light find band → alternating light
     bands with elevated/bento cards → bold full-bleed crimson CTA.
     =================================================================== */
  .wwd{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}

  /* ---------------- DEPTH HERO STAGE (shorter band) ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:84px 0 92px;
  }
  .stage-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:56px;align-items:center;position:relative;z-index:2}

  /* glow auras — gold + crimson + white */
  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:520px;height:520px;top:-180px;right:-120px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:460px;height:460px;bottom:-220px;left:-140px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:360px;height:360px;top:24%;left:46%;background:radial-gradient(circle,rgba(255,255,255,.15),transparent 70%)}

  /* luminosity-masked real photo bleeding in from the right */
  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:overlay;pointer-events:none;
    background-image:var(--wap-hero-photo-url);background-size:cover;background-position:center;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);opacity:.18}

  /* gold PILL — fully visible, never clipped */
  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;
    background:linear-gradient(135deg,#e3bd6a,#a47f38);color:#3a2c10;font-weight:800;font-size:13px;
    letter-spacing:.02em;line-height:1.15;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{font-size:13px;opacity:.95}

  .lede h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(40px,5.6vw,68px);
    line-height:1.02;letter-spacing:-.03em;margin:22px 0 0}
  .shimmer{background:linear-gradient(100deg,#fff 10%,#f3d28f 50%,#fff 90%);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .lede .sub{font-size:19px;line-height:1.55;color:rgba(255,255,255,.82);max-width:32em;margin:20px 0 28px}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}

  .proof{display:flex;gap:30px;flex-wrap:wrap;margin-top:36px}
  .proof-i{display:flex;flex-direction:column;gap:2px}
  .proof-i b{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:24px;letter-spacing:-.02em}
  .proof-i span{font-size:13px;color:rgba(255,255,255,.7);max-width:13em}

  /* translucent glass stat card */
  .deck{position:relative;min-height:240px;display:flex;justify-content:center}
  .gcard{width:100%;max-width:340px;border-radius:22px;padding:30px 28px;
    background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(18px);
    box-shadow:var(--shadow-glass);color:#fff;
    transform:rotate(-1.5deg)}
  .gcard-tag{font-size:13px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.72)}
  .gcard-k{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:64px;line-height:1;margin:8px 0 10px;
    background:linear-gradient(100deg,#ffd98a,#ffb4c4);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .gcard-sub{font-size:14px;color:rgba(255,255,255,.82);line-height:1.5;margin-bottom:18px}
  .gchips{display:flex;flex-wrap:wrap;gap:8px}
  .gchips span{font-size:13px;font-weight:700;padding:6px 12px;border-radius:999px;
    background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18)}

  @media (prefers-reduced-motion: no-preference){
    .deck{animation:wwd-float 8s ease-in-out infinite}
    @keyframes wwd-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
  }

  /* ---------------- FIND YOUR PATH BAND ---------------- */
  .findband{background:var(--surface);border-top:3px solid var(--gold);border-bottom:1px solid var(--border)}
  .findpath{display:flex;align-items:center;justify-content:center;gap:24px;flex-wrap:wrap;padding:26px 24px}
  .findpath p{font-weight:700;font-size:18px;font-family:'Plus Jakarta Sans',sans-serif}
  .findpath .acts{display:flex;gap:14px;flex-wrap:wrap}

  /* ---------------- ALTERNATING LIGHT BANDS ---------------- */
  .blk{width:100%;padding:var(--sec-pad) 0}
  .blk--surface{background:var(--surface)}
  .blk--cream{background:var(--bg)}

  .head{text-align:center;margin-bottom:52px}
  .head h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(30px,4.4vw,48px);line-height:1.02;letter-spacing:-.02em}
  .kick{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin-bottom:16px}
  .kick--crimson{color:var(--crimson)}

  /* LEGACY */
  .legacy{display:grid;grid-template-columns:.95fr 1.05fr;gap:48px;align-items:center}
  .legacy__media{position:relative}
  .legacy__img{aspect-ratio:4/3;border-radius:var(--radius);background:var(--grad);box-shadow:var(--shadow-lg);position:relative;overflow:hidden}
  .legacy__img::after{content:"";position:absolute;inset:0;background:var(--wap-hero-photo-url-2) center/cover;opacity:.5;mix-blend-mode:luminosity}
  .legacy__badge{position:absolute;bottom:-18px;right:-12px;background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:#fff;padding:16px 22px;border-radius:18px;box-shadow:0 16px 40px -10px rgba(164,127,56,.5);text-align:center}
  .legacy__badge .k{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:32px;line-height:1}
  .legacy__badge .s{font-size:13px;font-weight:600;opacity:.9;margin-top:2px}
  .legacy__text h2{font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(28px,3.6vw,40px);font-weight:800;margin-bottom:18px}
  .legacy__text blockquote{font-size:18px;color:var(--text);border-left:3px solid var(--crimson);padding-left:18px;margin:0 0 18px;font-style:italic}
  .legacy__text p{color:var(--muted);font-size:15px;margin-bottom:18px}
  .legacy__chip{background:var(--surface-2);border:1px solid var(--border);border-radius:16px;padding:18px 20px}
  .legacy__chip .k{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:17px;color:var(--crimson)}
  .legacy__chip .s{color:var(--muted);font-size:14px;margin-top:4px}
  @media(max-width:880px){.legacy{grid-template-columns:1fr;gap:40px}.legacy__badge{right:12px}}

  /* VALUES — numbered editorial list (was an icon-in-circle bento grid;
     re-expressed as a rail of big display numerals + hairline rows so the
     "Our Values" section reads distinctly from the other icon-card grids
     used elsewhere on the site). */
  .valuelist{list-style:none;max-width:840px;margin:0 auto;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
  .vitem{display:grid;grid-template-columns:104px 1fr;gap:28px;padding:34px 4px;border-top:1px solid var(--border)}
  .vitem:first-child{border-top:0}
  .vnum{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:56px;line-height:1;letter-spacing:-.02em;
    background:var(--grad-text);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .vbody h3{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:21px;margin-bottom:8px}
  .vbody p{color:var(--muted);font-size:15.5px;line-height:1.6;max-width:56em}
  @media(max-width:620px){.vitem{grid-template-columns:1fr;gap:10px;padding:26px 4px}.vnum{font-size:38px}}

  /* VALUE STEPS */
  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .stepcard{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:32px 28px;box-shadow:var(--shadow);transition:transform .2s,box-shadow .25s}
  .stepcard:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}
  .stepcard .num{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:34px;line-height:1;margin-bottom:14px;
    background:var(--grad-text);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .stepcard h3{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:19px;margin-bottom:8px}
  .stepcard p{color:var(--muted);font-size:15px;line-height:1.55}
  @media(max-width:880px){.steps{grid-template-columns:1fr}}

  /* ---------------- BOLD FULL-BLEED CLOSING CTA ---------------- */
  .close{
    position:relative;overflow:hidden;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
  }
  .close__media{position:absolute;inset:0;background:var(--wap-hero-photo-url-3) center 40%/cover no-repeat}
  .close__veil{position:absolute;inset:0;
    background:var(--wap-hero-close-veil)}
  .close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:88px 24px 96px;max-width:var(--max)}
  .close__inner h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(32px,5vw,60px);line-height:1;letter-spacing:-.03em;margin-bottom:18px}
  .close__inner p{font-size:clamp(17px,2.2vw,21px);color:rgba(255,255,255,.92);max-width:40em;margin:0 auto 30px;line-height:1.5}

  /* ---------------- RESPONSIVE ---------------- */
  @media(max-width:880px){
    .stage{padding:64px 0 76px}
    .stage-grid{grid-template-columns:1fr;gap:52px}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
    .deck{min-height:0}
    .gcard{max-width:420px;transform:rotate(0)}
  }
  @media(max-width:560px){
    .blk{padding:60px 0}
    .acts .bbtn{width:100%;justify-content:center}
  }
  @media(max-width:430px){.pill{white-space:normal;text-align:left}}
</style>
</Layout>
</content>
</invoke>
