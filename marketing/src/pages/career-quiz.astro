---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CareerQuiz from '../components/CareerQuiz.tsx';
---
<Layout
  title="Free Career Quiz — Find Careers That Fit You — WorkforceAP"
  description="Answer 6 quick questions and see careers and WorkforceAP training — at no cost to members who qualify through scholarship/grant funded membership — that fit your interests. No account required. WorkforceAP is a 501(c)(3) nonprofit."
>
<!-- DEPTH STAGE HERO — compact crimson band, gold pill, glow auras -->
<section class="quiz-hero stage" aria-labelledby="quiz-hero-heading">
  <div class="aura aura--1" aria-hidden="true"></div>
  <div class="aura aura--2" aria-hidden="true"></div>
  <div class="aura aura--3" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>

  <div class="wrap quiz-hero__inner">
    <span class="pill"><span class="pill__star"><Icon name="star" size={12} /></span>Free · 6 questions · no account required</span>
    <h1 id="quiz-hero-heading" class="quiz-hero__heading">Find careers that fit you.</h1>
    <p class="quiz-hero__subhead">
      Answer 6 quick questions and see the interest type — and WorkforceAP training at no cost to members who qualify through scholarship/grant funded membership — that fits you.
    </p>
  </div>
</section>

<!-- QUIZ SECTION — light band, React island -->
<section class="quiz-section band band--surface" aria-label="Career quiz">
  <div class="wrap quiz-wrap">
    <p class="quiz-kicker" role="note">No-cost training for members who qualify through scholarship/grant funded membership · 501(c)(3) nonprofit</p>
    <div class="quiz-flow">
      <CareerQuiz client:visible />
    </div>
  </div>
</section>

<style>
  /* ===================================================================
     CAREER QUIZ — DEPTH-styled. Compact crimson depth-stage hero with
     glow auras + luminosity-masked photo + gold pill, over a light band
     that hosts the React quiz island. Mirrors apply.astro depth language.
     =================================================================== */

  /* ---------------- DEPTH HERO STAGE (compact band) ---------------- */
  .quiz-hero.stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:60px 0 64px;text-align:center;
  }
  .quiz-hero__inner{position:relative;z-index:2;max-width:760px}

  /* glow auras — gold + crimson + white */
  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:460px;height:460px;top:-150px;right:-110px;background:radial-gradient(circle,rgba(196,154,72,.5),transparent 68%)}
  .aura--2{width:420px;height:420px;bottom:-190px;left:-130px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:340px;height:340px;top:24%;left:46%;background:radial-gradient(circle,rgba(255,255,255,.15),transparent 70%)}

  /* luminosity-masked real photo bleeding in from the right */
  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:overlay;pointer-events:none;
    background-image:var(--wap-hero-photo-url);background-size:cover;background-position:center;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);opacity:.15}

  /* gold PILL — fully visible, never clipped */
  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;
    background:var(--grad-gold);color:var(--gold-ink);font-weight:800;font-size:13px;
    letter-spacing:.02em;line-height:1.2;padding:9px 17px;border-radius:999px;margin-bottom:20px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{font-size:13px;opacity:.95}
  @media(max-width:520px){.pill{white-space:normal;text-align:left}}

  .quiz-hero__heading{font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(30px,5vw,48px);font-weight:800;line-height:1.05;letter-spacing:-.025em}
  .quiz-hero__subhead{margin:16px auto 0;font-size:clamp(16px,2.2vw,19px);color:rgba(255,255,255,.88);line-height:1.5;max-width:34em}

  /* ---------------- LIGHT QUIZ BAND ---------------- */
  .quiz-section{padding:var(--sec-pad) 0}
  .quiz-wrap{max-width:680px;margin:0 auto}
  .quiz-kicker{font-size:13px;font-weight:700;color:var(--gold-dark);background:rgba(164,127,56,.1);border:1px solid rgba(164,127,56,.22);border-radius:999px;padding:8px 16px;display:inline-block;margin-bottom:18px}

  /* ---------------- QUIZ ISLAND (scoped .cq-* visual language) ---------------- */
  .quiz-flow :global(.cq-card){
    background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
    border-top:5px solid var(--crimson);padding:28px;box-shadow:var(--shadow-lg);
  }
  .quiz-flow :global(.cq-head){display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:16px}
  .quiz-flow :global(.cq-kicker){font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--crimson)}
  .quiz-flow :global(.cq-head h3){font-family:'Plus Jakarta Sans',sans-serif;font-size:22px;font-weight:800;margin-top:6px;line-height:1.2}
  .quiz-flow :global(.cq-progress){font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:20px;color:var(--gold-dark);flex-shrink:0}

  .quiz-flow :global(.cq-bar){height:8px;border-radius:999px;background:var(--border);overflow:hidden;margin-bottom:18px}
  .quiz-flow :global(.cq-bar i){display:block;height:100%;background:var(--grad);border-radius:999px;transition:width .25s ease}

  .quiz-flow :global(.cq-count){font-size:13px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--crimson);margin-bottom:10px}

  .quiz-flow :global(.cq-q){border:0;padding:0;margin:0;min-width:0}
  .quiz-flow :global(.cq-q legend){font-family:'Plus Jakarta Sans',sans-serif;font-size:18px;font-weight:800;line-height:1.35;color:var(--text);padding:0}
  .quiz-flow :global(.cq-prompt){display:block;margin-top:8px;font-family:'Inter',sans-serif;font-size:18px;font-weight:600;color:var(--text)}

  .quiz-flow :global(.cq-opts){display:grid;gap:10px;margin-top:18px}
  .quiz-flow :global(.cq-opt){
    width:100%;text-align:left;padding:14px 18px;border:1.5px solid var(--border);border-radius:13px;
    background:var(--surface-2);font-family:inherit;font-size:16px;font-weight:600;color:var(--text);cursor:pointer;
    transition:border-color .16s,background .16s,transform .12s,box-shadow .16s;
  }
  .quiz-flow :global(.cq-opt:hover){border-color:var(--crimson);background:#fff;transform:translateY(-1px);box-shadow:var(--shadow)}
  .quiz-flow :global(.cq-opt:focus-visible){outline:3px solid rgba(173,44,77,.35);outline-offset:2px;border-color:var(--crimson)}

  /* ---- result ---- */
  .quiz-flow :global(.cq-result__type){font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(26px,5vw,36px);font-weight:900;line-height:1.1;margin:6px 0 18px}
  .quiz-flow :global(.cq-grad){background:var(--grad-text);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .quiz-flow :global(.cq-areas){list-style:none;padding:0;margin:0 0 20px;display:grid;gap:12px}
  .quiz-flow :global(.cq-area){background:var(--surface-2);border:1px solid var(--border);border-left:4px solid var(--crimson);border-radius:14px;padding:14px 16px}
  .quiz-flow :global(.cq-area__name){display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:16px;color:var(--text)}
  .quiz-flow :global(.cq-area__blurb){display:block;margin-top:4px;font-size:14px;color:var(--muted);line-height:1.45}
  .quiz-flow :global(.cq-result__lead){color:var(--muted);font-size:15px;line-height:1.55;margin-bottom:22px}
  .quiz-flow :global(.cq-actions){display:flex;gap:12px;flex-wrap:wrap}
  .quiz-flow :global(.cq-actions .btn){flex:1;min-width:180px;justify-content:center}
  .quiz-flow :global(.cq-restart){display:inline-flex;align-items:center;min-height:44px;padding:6px 4px;margin-top:18px;background:none;border:0;color:var(--crimson);font-weight:700;font-size:14px;text-decoration:underline;cursor:pointer;font-family:inherit}
  .quiz-flow :global(.cq-restart:focus-visible){outline:3px solid rgba(173,44,77,.35);outline-offset:2px;border-radius:6px}
  .quiz-flow :global(.cq-fine){margin-top:18px;font-size:13px;color:var(--muted);line-height:1.5}

  @media(max-width:560px){
    .quiz-flow :global(.cq-actions .btn){flex:1 1 100%}
  }
</style>
</Layout>
