---
import Layout from '../../layouts/Layout.astro';
import {
  BLOG_POSTS,
  getPublishedPosts,
  getRelatedPosts,
  resolveHeroImage,
  formatPublishedDate,
  type BlogPost,
} from '../../data/blog';

// Statically generate every published post (mirrors the Next generateStaticParams,
// which enumerates published posts from the DB).
export function getStaticPaths() {
  return getPublishedPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}
const { post } = Astro.props;

const hero = resolveHeroImage(post);
const dateStr = formatPublishedDate(post.publishedAt);
const subtitle = [post.authorName, dateStr].filter(Boolean).join(' · ');
const related = getRelatedPosts(post.slug, post.category, 3);

// --- Minimal, safe Markdown → HTML for the post body --------------------------
// The Next route renders post.content with react-markdown + remark-gfm. The seed
// copy only uses: paragraphs (blank-line separated), **bold** inline, and `- ` /
// `* ` bullet lists. We render exactly those, escaping all other HTML so the copy
// stays verbatim and safe.
function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}
function inline(s: string): string {
  // escape first, then re-introduce only **bold**
  return escapeHtml(s).replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}
function renderMarkdown(md: string): string {
  const blocks = md.split(/\n{2,}/);
  const out: string[] = [];
  for (const block of blocks) {
    const lines = block.split('\n');
    // Render each block line-by-line, grouping consecutive `- `/`* ` bullet lines
    // into a <ul> and the rest into a <p> (with <br> for single newlines). This
    // matches how remark-gfm turns the seed copy's mixed label + bullet blocks
    // into a paragraph followed by a list.
    let i = 0;
    while (i < lines.length) {
      if (/^\s*[-*]\s+/.test(lines[i])) {
        const items: string[] = [];
        while (i < lines.length && /^\s*[-*]\s+/.test(lines[i])) {
          items.push(`<li>${inline(lines[i].replace(/^\s*[-*]\s+/, ''))}</li>`);
          i++;
        }
        out.push(`<ul>${items.join('')}</ul>`);
      } else {
        const para: string[] = [];
        while (i < lines.length && !/^\s*[-*]\s+/.test(lines[i])) {
          para.push(inline(lines[i]));
          i++;
        }
        out.push(`<p>${para.join('<br>')}</p>`);
      }
    }
  }
  return out.join('\n');
}
const bodyHtml = renderMarkdown(post.content);

const title = `${post.title} | WorkforceAP Blog`;
---
<Layout title={title} description={post.excerpt}>
<div class="blogpost">

  <!-- ============================================================
       COMPACT CRIMSON STAGE HERO — depth band with auras + grain,
       gold meta pill, white title + excerpt.
       ============================================================ -->
  <section class="stage">
    <div class="aura aura--1"></div>
    <div class="aura aura--2"></div>
    <div class="aura aura--3"></div>
    <div class="grain"></div>

    <div class="wrap stage-inner">
      <a class="backlink" href="/blog"><span aria-hidden="true">←</span> Back to Blog</a>
      <span class="pill"><span class="pill__star" aria-hidden="true">★</span>{post.category}</span>
      <h1>{post.title}</h1>
      <p class="meta">{subtitle}</p>
    </div>
  </section>

  <!-- ===== BODY — light band, article + related rail ===== -->
  <section class="blk blk--cream">
    <div class="wrap layout">
      <article class="article">
        <div class="cover">
          <img src={hero.src} alt={hero.alt} width="800" height="450" loading="eager" />
        </div>

        <div class="prose" set:html={bodyHtml}></div>

        <!-- Closing CTA card (verbatim copy from the Next detail page) -->
        <section class="cta-card">
          <h3>Ready to take the next step?</h3>
          <p>
            WorkforceAP offers no-cost career training paths for <a href="/apply" class="cta-link">qualifying members</a> — with guided tools, advisor support, and employer-aligned credentials.
          </p>
          <div class="cta-acts">
            <a class="btn btn--primary" href="/find-your-path">Find Your Path</a>
            <a class="btn btn--ghost" href="/apply">Apply Now</a>
          </div>
        </section>
      </article>

      {related.length > 0 && (
        <aside class="related">
          <h3>Related Posts</h3>
          <ul>
            {related.map((r) => (
              <li><a href={`/blog/${r.slug}`}>{r.title}</a></li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </section>

  <!-- ============================================================
       CLOSING CTA — BOLD full-bleed crimson with photo luminosity.
       ============================================================ -->
  <section class="close">
    <div class="close__media" aria-hidden="true"></div>
    <div class="close__veil" aria-hidden="true"></div>
    <div class="close__inner wrap">
      <h2>Explore your career path</h2>
      <p>
        WorkforceAP offers no-cost career training paths for <a href="/apply" class="cta-link">qualifying members</a> — with guided tools, advisor support, and employer-aligned credentials.
      </p>
      <div class="acts acts--center">
        <a class="bbtn bbtn--gold" href="/programs">Explore Programs</a>
        <a class="bbtn bbtn--outline" href="/blog">More Articles</a>
      </div>
    </div>
  </section>

</div>

<style>
  .blogpost{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}

  /* ---------------- COMPACT DEPTH HERO STAGE ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:64px 0 72px;
  }
  .stage-inner{position:relative;z-index:2;max-width:840px}

  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:520px;height:520px;top:-160px;right:-120px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:460px;height:460px;bottom:-200px;left:-140px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:360px;height:360px;top:24%;left:44%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%)}

  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:overlay;pointer-events:none;
    background-image:var(--wap-hero-photo-url);background-size:cover;background-position:center;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);opacity:.16}

  .backlink{display:inline-flex;align-items:center;gap:7px;color:rgba(255,255,255,.82);font-weight:600;font-size:14px;margin-bottom:18px;padding:8px 0;min-height:44px;box-sizing:border-box}
  .backlink:hover{color:#fff}
  .backlink span{font-size:16px}

  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:var(--grad-gold);color:var(--gold-ink);font-weight:800;font-size:13px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{font-size:13px;opacity:.95}

  .stage-inner h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(30px,4.6vw,52px);
    line-height:1.06;letter-spacing:-.03em;margin:18px 0 0}
  .meta{font-size:15px;color:rgba(255,255,255,.8);margin:16px 0 0;font-weight:600}

  /* ---------------- LIGHT BODY BLOCK ---------------- */
  .blk{width:100%;padding:var(--sec-pad) 0}
  .blk--cream{background:var(--bg);color:var(--text)}
  .layout{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:48px;align-items:start;max-width:1060px}

  .article{min-width:0;max-width:68ch}
  .cover{border-radius:var(--radius);overflow:hidden;aspect-ratio:16/9;margin-bottom:32px;box-shadow:var(--shadow)}
  .cover img{width:100%;height:100%;object-fit:cover;display:block}

  /* prose */
  .prose{font-size:17px;line-height:1.72;color:var(--text)}
  .prose :global(p){margin:0 0 1.25em}
  .prose :global(strong){font-weight:700;color:var(--text)}
  .prose :global(ul){margin:0 0 1.25em;padding-left:1.25em}
  .prose :global(li){margin:0 0 .5em}
  .prose :global(li)::marker{color:var(--crimson)}

  /* closing CTA card (elevated, in-flow) */
  .cta-card{
    margin-top:48px;background:var(--surface);border:1px solid var(--border);
    border-radius:var(--radius);padding:36px 32px;box-shadow:var(--shadow);
    border-top:5px solid var(--crimson);
  }
  .cta-card h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:24px;font-weight:800;margin-bottom:10px}
  .cta-card p{color:var(--muted);font-size:16px;margin-bottom:22px;line-height:1.6}
  .cta-acts{display:flex;gap:12px;flex-wrap:wrap}
  .cta-link{color:inherit;text-decoration:underline;text-decoration-style:dotted;text-underline-offset:3px}

  /* related rail (elevated) */
  .related{
    position:sticky;top:96px;background:var(--surface);border:1px solid var(--border);
    border-radius:var(--radius);padding:26px 24px;box-shadow:var(--shadow);border-top:5px solid var(--gold);
  }
  .related h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:18px;font-weight:800;margin-bottom:16px}
  .related ul{list-style:none;display:flex;flex-direction:column;gap:14px}
  .related a{color:var(--text);font-weight:600;font-size:15px;line-height:1.4;display:block}
  .related a:hover{color:var(--crimson)}

  /* ---------------- BOLD FULL-BLEED CLOSING CTA ---------------- */
  .close{position:relative;overflow:hidden;width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw}
  .close__media{position:absolute;inset:0;background:var(--wap-hero-photo-url-3) center 40%/cover no-repeat}
  .close__veil{position:absolute;inset:0;
    background:var(--wap-hero-close-veil)}
  .close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:80px 24px 88px;max-width:var(--max)}
  .close__inner h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(30px,5vw,52px);line-height:1;letter-spacing:-.03em;margin-bottom:18px}
  .close__inner p{font-size:clamp(16px,2.1vw,20px);color:rgba(255,255,255,.92);max-width:40em;margin:0 auto 28px;line-height:1.5}
  .close .cta-link{color:inherit;text-decoration:underline;text-decoration-style:dotted;text-underline-offset:3px}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}

  /* ---------------- RESPONSIVE ---------------- */
  @media(max-width:880px){
    .stage{padding:52px 0 60px}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
    .layout{grid-template-columns:1fr;gap:36px}
    .related{position:static}
  }
  @media(max-width:560px){
    .cta-acts .btn,.acts .bbtn{width:100%;justify-content:center}
  }
</style>
</Layout>
