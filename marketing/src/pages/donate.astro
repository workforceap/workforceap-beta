---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Partner & Employer Giving | Sponsor a Cohort — WorkforceAP"
  description="Fund a full year of employer-aligned training, AI career coaching, and job placement. Partner and employer giving plus Bronze–Platinum Community Champion sponsorship tiers for Workforce Advancement Project, a 501(c)(3) nonprofit (EIN 41-2612389)."
>
<section class="wap-give" id="partner-sponsorship">

  <!-- HERO -->
  <div class="wg-hero">
    <div class="wg-wrap">
      <img class="wg-hero-logo" src="/images/wap_logo.png" alt="Workforce Advancement Project" width="126" height="64" />
      <span class="wg-eyebrow">Partner &amp; Employer Giving</span>
      <h1>Sponsor a cohort. Fund real futures.</h1>
      <p class="wg-lead">Your organization can fund a full year of employer-aligned training, AI career coaching, and job placement for people who couldn&rsquo;t otherwise afford it &mdash; at no cost to them. Every seat is a life moved toward work.</p>
      <div class="wg-cta-row">
        <a class="wg-btn wg-btn-gold" href="https://www.zeffy.com/en-US/donation-form/donate-for-classes-on-workforceaporg" target="_blank" rel="noopener">Donate securely online →</a>
        <a class="wg-btn wg-btn-ghost" href="#inquiry">Talk about corporate giving</a>
      </div>
      <div class="wg-trust">
        <span class="wg-chip"><b>501(c)(3)</b> nonprofit</span>
        <span class="wg-chip">EIN <b>41-2612389</b></span>
        <span class="wg-chip">Gifts may be <b>tax-deductible</b></span>
      </div>
    </div>
  </div>

  <!-- PROGRAMS (slide 1) -->
  <div class="wg-band">
    <div class="wg-wrap">
      <div class="wg-head">
        <span class="wg-eyebrow">Ways organizations give</span>
        <h2>Flexible programs for sponsoring or training your people</h2>
        <p>Whether you&rsquo;re upskilling your own workforce, supporting laid-off workers, or funding seats for the community, there&rsquo;s a path that fits. Seats are sold in groups of 5, with volume discounts as you scale.</p>
      </div>
      <div class="wg-programs">

        <div class="wg-prog">
          <div class="wg-prog-top">
            <h3>Partnership<span class="wg-prog-sub">Student Management &amp; Training</span></h3>
            <div class="wg-price"><span class="amt">$200</span> <span class="per">/ seat / month</span></div>
          </div>
          <ul>
            <li>Seats sold in groups of 5</li>
            <li>12-month minimum term</li>
            <li>Interchangeable seats, no penalty</li>
            <li>All career paths + AI coaching + 150-day post-hire</li>
            <li>Loaner laptop included</li>
          </ul>
          <div class="wg-prog-foot">
            <a class="wg-btn wg-btn-outline wg-btn-sm" href="#inquiry" data-tier="Partnership">Start a partnership</a>
          </div>
        </div>

        <div class="wg-prog">
          <div class="wg-prog-top">
            <h3>Employment / Benefit<span class="wg-prog-sub">Reemployment &amp; Layoff Assistance</span></h3>
            <div class="wg-price"><span class="amt">$2,400</span> <span class="per">/ worker / year</span></div>
          </div>
          <ul>
            <li>Flat 12-month rate, no monthly billing</li>
            <li>Seats sold in groups of 5</li>
            <li>Unlimited training &amp; certificates</li>
            <li>Resume, interview &amp; job placement</li>
            <li>Loaner laptop + 150-day post-hire</li>
          </ul>
          <div class="wg-prog-foot">
            <a class="wg-btn wg-btn-outline wg-btn-sm" href="#inquiry" data-tier="Employment">Set up a benefit</a>
          </div>
        </div>

        <div class="wg-prog">
          <div class="wg-prog-top">
            <h3>Community Champion<span class="wg-prog-sub">Cohort Sponsorship</span></h3>
            <div class="wg-price"><span class="amt">$2,400</span> <span class="per">/ seat / year</span></div>
          </div>
          <ul>
            <li>Tax-deductible 501(c)(3) giving</li>
            <li>Funds a full year for one member</li>
            <li>Co-branded recognition</li>
            <li>Quarterly impact reports</li>
          </ul>
          <div class="wg-prog-foot">
            <a class="wg-btn wg-btn-maroon wg-btn-sm" href="#tiers">See sponsorship tiers ↓</a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- TIERS (slide 2) -->
  <div class="wg-band wg-band-cream" id="tiers">
    <div class="wg-wrap">
      <div class="wg-head center">
        <span class="wg-eyebrow">Tax-deductible giving</span>
        <h2>Become a Community Champion &mdash; sponsor a cohort</h2>
        <p>Choose a sponsorship tier and fund a group of members for a full year. Larger commitments unlock volume discounts, so every dollar stretches further into the community.</p>
      </div>
      <div class="wg-tiers">

        <div class="wg-tier">
          <div class="wg-tier-top wg-t-bronze">
            <div class="wg-tier-name">Bronze</div>
            <div class="wg-seats">5 Seats</div>
            <div class="wg-term">1-Year Sponsorship</div>
          </div>
          <div class="wg-tier-body">
            <div class="wg-tier-price">$12,000</div>
            <div class="wg-seat-rate">$2,400 / seat / year</div>
            <div class="wg-rate-label">Standard rate</div>
            <div class="wg-lives">5 lives transformed</div>
            <ul class="wg-incl">
              <li>Unlimited training &amp; certs</li>
              <li>All 19 learning paths</li>
              <li>AI coaching &amp; readiness</li>
              <li>Job placement support</li>
              <li>Quarterly impact report</li>
            </ul>
          </div>
          <div class="wg-tier-foot">
            <a class="wg-btn wg-btn-outline wg-btn-sm" href="#inquiry" data-tier="Bronze">Sponsor Bronze</a>
          </div>
        </div>

        <div class="wg-tier">
          <div class="wg-tier-top wg-t-silver">
            <div class="wg-tier-name">Silver</div>
            <div class="wg-seats">10 Seats</div>
            <div class="wg-term">1-Year Sponsorship</div>
          </div>
          <div class="wg-tier-body">
            <div class="wg-tier-price">$21,600</div>
            <div class="wg-seat-rate">$2,160 / seat / year</div>
            <div class="wg-rate-label">10% group discount</div>
            <div class="wg-save">Save $2,400</div>
            <div class="wg-lives">10 lives transformed</div>
            <ul class="wg-incl">
              <li>Unlimited training &amp; certs</li>
              <li>All 19 learning paths</li>
              <li>AI coaching &amp; readiness</li>
              <li>Job placement support</li>
              <li>Quarterly impact report</li>
            </ul>
          </div>
          <div class="wg-tier-foot">
            <a class="wg-btn wg-btn-outline wg-btn-sm" href="#inquiry" data-tier="Silver">Sponsor Silver</a>
          </div>
        </div>

        <div class="wg-tier feat">
          <div class="wg-badge">Best value</div>
          <div class="wg-tier-top wg-t-gold">
            <div class="wg-tier-name">Gold</div>
            <div class="wg-seats">25 Seats</div>
            <div class="wg-term">1-Year Sponsorship</div>
          </div>
          <div class="wg-tier-body">
            <div class="wg-tier-price">$48,000</div>
            <div class="wg-seat-rate">$1,920 / seat / year</div>
            <div class="wg-rate-label">20% group discount</div>
            <div class="wg-save">Save $12,000</div>
            <div class="wg-lives">25 lives transformed</div>
            <ul class="wg-incl">
              <li>Unlimited training &amp; certs</li>
              <li>All 19 learning paths</li>
              <li>AI coaching &amp; readiness</li>
              <li>Job placement support</li>
              <li>Quarterly impact report</li>
            </ul>
          </div>
          <div class="wg-tier-foot">
            <a class="wg-btn wg-btn-gold wg-btn-sm" href="#inquiry" data-tier="Gold">Sponsor Gold</a>
          </div>
        </div>

        <div class="wg-tier">
          <div class="wg-tier-top wg-t-platinum">
            <div class="wg-tier-name">Platinum</div>
            <div class="wg-seats">50 Seats</div>
            <div class="wg-term">1-Year Sponsorship</div>
          </div>
          <div class="wg-tier-body">
            <div class="wg-tier-price">$84,000</div>
            <div class="wg-seat-rate">$1,680 / seat / year</div>
            <div class="wg-rate-label">30% group discount</div>
            <div class="wg-save">Save $36,000</div>
            <div class="wg-lives">50 lives transformed</div>
            <ul class="wg-incl">
              <li>Unlimited training &amp; certs</li>
              <li>All 19 learning paths</li>
              <li>AI coaching &amp; readiness</li>
              <li>Job placement support</li>
              <li>Quarterly impact report</li>
            </ul>
          </div>
          <div class="wg-tier-foot">
            <a class="wg-btn wg-btn-maroon wg-btn-sm" href="#inquiry" data-tier="Platinum">Sponsor Platinum</a>
          </div>
        </div>

      </div>
      <p class="wg-foot-note">Volume discounts: Silver receives 10% off &bull; Gold 20% off &bull; Platinum 30% off. Custom and multi-cohort commitments are welcome &mdash; <a href="#inquiry" style="color:var(--maroon);font-weight:700;">talk with our team</a>.</p>
    </div>
  </div>

  <!-- WHY / IMPACT -->
  <div class="wg-band">
    <div class="wg-wrap">
      <div class="wg-head center">
        <span class="wg-eyebrow">Your impact</span>
        <h2>Why champion a cohort?</h2>
        <p>Every sponsored seat funds a full year of workforce readiness for someone who couldn&rsquo;t otherwise afford it &mdash; and you see exactly where your gift goes.</p>
      </div>
      <div class="wg-value">
        <div class="wg-vcard">
          <div class="wg-vicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1 2.7 2.5 6 2.5s6-1.5 6-2.5v-5"/></svg></div>
          <h3>What each seat funds</h3>
          <p>12 months of unlimited training, all 19 learning paths, AI career coaching, resume &amp; interview prep, job placement, and 150-day post-hire support.</p>
        </div>
        <div class="wg-vcard">
          <div class="wg-vicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.5"/><line x1="8.5" y1="15.5" x2="15.5" y2="8.5"/><circle cx="9" cy="9" r="1.2"/><circle cx="15" cy="15" r="1.2"/></svg></div>
          <h3>Volume discounts</h3>
          <p>Silver: 10% off &bull; Gold: 20% off &bull; Platinum: 30% off. Scale your commitment and every dollar stretches further into the community.</p>
        </div>
        <div class="wg-vcard">
          <div class="wg-vicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5"/><path d="M8.5 12.3 7 21l5-2.7L17 21l-1.5-8.7"/></svg></div>
          <h3>Co-branded recognition</h3>
          <p>Your name on dashboards, impact reports, and graduate certificates &mdash; meaningful visibility across the WorkforceAP network.</p>
        </div>
        <div class="wg-vcard">
          <div class="wg-vicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l3 3v16l-2.3-1.4L13 21l-2.5-1.4L8 21l-2-1.4z"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="9" y1="12" x2="15" y2="12"/></svg></div>
          <h3>501(c)(3) tax-deductible</h3>
          <p>Registered nonprofit, EIN 41-2612389. A receipt is provided for every gift &mdash; the deduction your CFO will love.</p>
        </div>
        <div class="wg-vcard">
          <div class="wg-vicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="20" x2="4" y2="13"/><line x1="10" y1="20" x2="10" y2="7"/><line x1="16" y1="20" x2="16" y2="11"/><line x1="20" y1="20" x2="20" y2="4"/></svg></div>
          <h3>Stories you can share</h3>
          <p>Real members. Real placements. Real results. Outcomes data and member stories are shared back to you each quarter.</p>
        </div>
        <div class="wg-vcard">
          <div class="wg-vicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5.5A2.5 2.5 0 0 1 10.5 3h3A2.5 2.5 0 0 1 16 5.5V7"/><line x1="3" y1="12.5" x2="21" y2="12.5"/></svg></div>
          <h3>Employer-connected</h3>
          <p>Training is aligned to hiring, so your investment turns directly into job outcomes &mdash; not just certificates.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- INQUIRY FORM -->
  <div class="wg-band" id="inquiry">
    <div class="wg-wrap">
      <div class="wg-head center">
        <span class="wg-eyebrow">Start your sponsorship</span>
        <h2>Tell us how you&rsquo;d like to give</h2>
        <p>Share a few details and our team will follow up with next steps, an invoice or receipt, and a sponsorship built around your goals.</p>
      </div>
      <div class="wg-form-wrap">
        <form id="wgInquiry" novalidate>
          <div class="wg-form-grid">
            <div class="wg-field"><label for="wgName">Full name *</label><input id="wgName" name="name" type="text" autocomplete="name" required></div>
            <div class="wg-field"><label for="wgOrg">Organization *</label><input id="wgOrg" name="org" type="text" autocomplete="organization" required></div>
            <div class="wg-field"><label for="wgEmail">Work email *</label><input id="wgEmail" name="email" type="email" autocomplete="email" required></div>
            <div class="wg-field"><label for="wgPhone">Phone</label><input id="wgPhone" name="phone" type="tel" autocomplete="tel"></div>
            <div class="wg-field"><label for="wgInterest">I&rsquo;m interested in *</label>
              <select id="wgInterest" name="interest" required>
                <option value="" selected disabled>Select an option&hellip;</option>
                <option>Partnership &mdash; $200 / seat / month</option>
                <option>Employment / Benefit &mdash; $2,400 / worker / year</option>
                <option>Bronze &mdash; 5 seats ($12,000)</option>
                <option>Silver &mdash; 10 seats ($21,600)</option>
                <option>Gold &mdash; 25 seats ($48,000)</option>
                <option>Platinum &mdash; 50 seats ($84,000)</option>
                <option>Custom / not sure yet</option>
              </select>
            </div>
            <div class="wg-field"><label for="wgSeats">Approx. seats</label><input id="wgSeats" name="seats" type="number" min="1" placeholder="Optional"></div>
            <div class="wg-field full"><label for="wgMsg">Anything else?</label><textarea id="wgMsg" name="message" placeholder="Tell us about your goals, timeline, or any questions."></textarea></div>
          </div>
          <div class="wg-form-actions">
            <button type="submit" class="wg-btn wg-btn-gold">Send inquiry →</button>
            <span class="wg-form-note">Submitting opens your email app with the details ready to send to our team. Prefer to write directly? <a href="mailto:info@workforceap.org">info@workforceap.org</a></span>
          </div>
          <p class="wg-form-ok" id="wgOk"><b>Thanks!</b> Your email should have opened &mdash; just hit send and we&rsquo;ll be in touch.</p>
        </form>
      </div>
    </div>
  </div>

  <!-- FINAL CTA -->
  <div class="wg-band wg-band-cream">
    <div class="wg-wrap">
      <div class="wg-final">
        <h2>Ready to fund futures?</h2>
        <p>Become a Community Champion today. Make a secure gift online, or reach out to build a sponsorship that fits your organization.</p>
        <div class="wg-cta-row">
          <a class="wg-btn wg-btn-gold" href="https://www.zeffy.com/en-US/donation-form/donate-for-classes-on-workforceaporg" target="_blank" rel="noopener">Donate securely online →</a>
          <a class="wg-btn wg-btn-ghost" href="#inquiry">Talk about corporate giving</a>
        </div>
        <p class="wg-final-alt">Prefer to talk it through? Email <a href="mailto:info@workforceap.org?subject=Community%20Champion%20cohort%20sponsorship">info@workforceap.org</a> or call <a href="tel:+15127771808">(512) 777-1808</a>.</p>
      </div>
      <p class="wg-foot-note">Workforce Advancement Project is a 501(c)(3) nonprofit. EIN: 41-2612389. Contributions are intended to support WorkforceAP&rsquo;s mission and may be tax-deductible to the extent allowed by law. <b>Empowering People. Advancing Futures.</b></p>
    </div>
  </div>

</section>
</Layout>

<style>
  .wap-give{
    --maroon:#7A1530; --maroon-dark:#5E0F24; --maroon-deep:#4A0E0E;
    --gold:#D4A017; --gold-dark:#B8860B; --gold-soft:#F5E6C8;
    --cream:#FAF5E8; --cream-2:#F3ECDD; --ink:#2B2B2B; --muted:#6B6B6B;
    --line:#E6DECF; --green:#1F7A3A; --white:#ffffff;
    --serif:Georgia,"Times New Roman",serif;
    --sans:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    --wrap:1180px; --radius:16px;
    --shadow:0 10px 30px rgba(74,14,14,.10);
    --shadow-lg:0 22px 55px rgba(74,14,14,.18);
    font-family:var(--sans); color:var(--ink); line-height:1.6;
    -webkit-font-smoothing:antialiased; text-align:left;
  }
  .wap-give *{box-sizing:border-box;}
  .wap-give img{max-width:100%;display:block;}
  .wap-give h1,.wap-give h2,.wap-give h3,.wap-give h4{font-family:var(--serif);line-height:1.15;margin:0;color:var(--maroon-dark);font-weight:700;}
  .wap-give p{margin:0;}
  .wap-give a{text-decoration:none;}
  .wg-wrap{max-width:var(--wrap);margin:0 auto;padding:0 22px;}
  .wg-eyebrow{display:inline-block;font-family:var(--sans);font-weight:700;letter-spacing:.14em;text-transform:uppercase;font-size:0.8125rem;}

  /* Buttons */
  .wg-btn{display:inline-flex;align-items:center;gap:.5em;font-family:var(--sans);font-weight:700;
    font-size:1rem;padding:.85em 1.5em;border-radius:999px;text-decoration:none;border:2px solid transparent;
    cursor:pointer;transition:transform .15s ease,box-shadow .15s ease,background .15s ease;white-space:nowrap;}
  .wg-btn:hover{transform:translateY(-2px);}
  .wg-btn-gold{background:var(--gold);color:var(--maroon-deep);box-shadow:0 8px 20px rgba(212,160,23,.35);}
  .wg-btn-gold:hover{background:#e2b02a;}
  .wg-btn-ghost{background:transparent;color:var(--white);border-color:rgba(255,255,255,.6);}
  .wg-btn-ghost:hover{background:rgba(255,255,255,.12);}
  .wg-btn-maroon{background:var(--maroon);color:var(--white);box-shadow:0 8px 20px rgba(122,21,48,.28);}
  .wg-btn-maroon:hover{background:var(--maroon-dark);}
  .wg-btn-outline{background:transparent;color:var(--maroon);border-color:var(--maroon);}
  .wg-btn-outline:hover{background:var(--maroon);color:#fff;}
  .wg-btn-sm{font-size:.92rem;padding:.7em 1.25em;}

  /* HERO */
  .wg-hero{background:radial-gradient(120% 140% at 80% -10%,#8d1c39 0%,var(--maroon) 42%,var(--maroon-dark) 100%);
    color:var(--white);position:relative;overflow:hidden;border-radius:0;}
  .wg-hero::after{content:"";position:absolute;left:0;right:0;bottom:0;height:6px;
    background:linear-gradient(90deg,var(--gold),var(--gold-soft),var(--gold));}
  .wg-hero .wg-wrap{padding-top:56px;padding-bottom:60px;position:relative;z-index:1;}
  .wg-hero-logo{height:64px;width:auto;margin-bottom:26px;}
  .wg-hero .wg-eyebrow{color:var(--gold-soft);}
  .wg-hero h1{color:#fff;font-size:clamp(2rem,4.6vw,3.2rem);margin:.35em 0 .45em;max-width:16ch;}
  .wg-hero .wg-lead{font-size:clamp(1.05rem,1.7vw,1.28rem);max-width:60ch;color:#f4e7ea;}
  .wg-cta-row{display:flex;flex-wrap:wrap;gap:14px;margin-top:30px;}
  .wg-trust{display:flex;flex-wrap:wrap;align-items:center;gap:10px 18px;margin-top:26px;font-size:.9rem;color:#f0dfe3;}
  .wg-trust b{color:#fff;}
  .wg-chip{display:inline-flex;align-items:center;gap:.5em;background:rgba(255,255,255,.12);
    border:1px solid rgba(255,255,255,.22);padding:.4em .9em;border-radius:999px;}

  /* Section shells */
  .wg-band{padding:66px 0;}
  .wg-band-cream{background:var(--cream);}
  .wg-head{max-width:760px;margin-bottom:40px;}
  .wg-head.center{margin-left:auto;margin-right:auto;text-align:center;}
  .wg-head .wg-eyebrow{color:var(--gold-dark);}
  .wg-head h2{font-size:clamp(1.7rem,3.2vw,2.4rem);margin:.3em 0 .5em;}
  .wg-head p{color:var(--muted);font-size:1.08rem;}

  /* Program cards (slide 1) */
  .wg-programs{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .wg-prog{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;
    box-shadow:var(--shadow);display:flex;flex-direction:column;}
  .wg-prog-top{background:linear-gradient(160deg,var(--maroon) 0%,var(--maroon-dark) 100%);color:#fff;padding:26px 24px 22px;text-align:center;}
  .wg-prog-top h3{color:#fff;font-size:1.3rem;}
  .wg-prog-sub{display:block;font-family:var(--sans);font-weight:600;color:var(--gold-soft);font-size:.9rem;margin-top:4px;}
  .wg-price{margin-top:16px;font-family:var(--serif);font-weight:700;line-height:1;}
  .wg-price .amt{font-size:2.5rem;}
  .wg-price .per{font-size:.95rem;font-family:var(--sans);font-weight:600;color:#f0dfe3;}
  .wg-prog ul{list-style:none;margin:0;padding:24px 24px 8px;display:flex;flex-direction:column;gap:12px;flex:1;}
  .wg-prog li{position:relative;padding-left:30px;font-weight:600;font-size:.98rem;color:var(--ink);}
  .wg-prog li::before{content:"✓";position:absolute;left:0;top:-1px;color:var(--gold-dark);font-weight:900;}
  .wg-prog .wg-prog-foot{padding:8px 24px 26px;}
  .wg-prog .wg-btn{width:100%;justify-content:center;}

  /* Tier cards (slide 2) */
  .wg-tiers{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;align-items:stretch;}
  .wg-tier{background:#fff;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);
    display:flex;flex-direction:column;overflow:hidden;position:relative;}
  .wg-tier.feat{border:2px solid var(--gold);box-shadow:var(--shadow-lg);}
