</style>

<script is:inline>
(function(){
  var RECIPIENT = "info@workforceap.org";
  var scope = document.getElementById("partner-sponsorship") || document;
  var form  = scope.querySelector("#wgInquiry");
  var select = scope.querySelector("#wgInterest");

  // Preselect the interest dropdown when a program/tier button is clicked
  scope.querySelectorAll("[data-tier]").forEach(function(link){
    link.addEventListener("click", function(){
      if(!select) return;
      var tier = link.getAttribute("data-tier");
      for(var i=0;i<select.options.length;i++){
        if(select.options[i].text.indexOf(tier) === 0){ select.selectedIndex = i; break; }
      }
    });
  });

  if(form){
    form.addEventListener("submit", function(e){
      e.preventDefault();
      var val = function(id){ var el = scope.querySelector("#"+id); return el ? el.value.trim() : ""; };
      // Basic required-field check
      if(!val("wgName") || !val("wgOrg") || !val("wgEmail") || !val("wgInterest")){
        form.reportValidity ? form.reportValidity() : alert("Please complete the required fields.");
        return;
      }
      var interest = val("wgInterest") || "Not specified";
      var subject  = "Sponsorship / donation inquiry — " + interest;
      var body = [
        "New donation / sponsorship inquiry from the WorkforceAP donate page:",
        "",
        "Name: "         + val("wgName"),
        "Organization: " + val("wgOrg"),
        "Email: "        + val("wgEmail"),
        "Phone: "        + (val("wgPhone") || "—"),
        "Interested in: "+ interest,
        "Approx. seats: "+ (val("wgSeats") || "—"),
        "",
        "Message:",
        (val("wgMsg") || "—")
      ].join("\n");
      var href = "mailto:" + RECIPIENT +
                 "?subject=" + encodeURIComponent(subject) +
                 "&body="    + encodeURIComponent(body);
      window.location.href = href;
      var ok = scope.querySelector("#wgOk");
      if(ok) ok.classList.add("show");
    });
  }
})();
</script>
