---
import Layout from '../layouts/Layout.astro';

const evidenceQuestions = [
  {
    number: '01',
    title: 'Who is included?',
    question: 'Start with the people behind the percentage.',
    detail: 'Name the program, enrollment dates, number of people who started, and reporting period. Explain who is excluded and why. A result for graduates answers a different question from a result for everyone who enrolled.',
    evidence: 'Look for: cohort dates · participant count · denominator · exclusions',
  },
  {
    number: '02',
    title: 'What did people complete?',
    question: 'Distinguish finishing training from earning a credential.',
    detail: 'Report course completion and credential attainment separately, with the requirements for each. Show people still training or who withdrew, so a completion rate has context.',
    evidence: 'Look for: completed ÷ enrolled · credentials earned · time to complete',
  },
  {
    number: '03',
    title: 'Did training lead to paid work?',
    question: 'An employer connection is one step toward an outcome.',
    detail: 'Separate job referrals, offers, and confirmed job starts. State whether employment is related to the training, whether it is full-time or part-time, and when follow-up happened—for example, 90 or 180 days after completion.',
    evidence: 'Look for: confirmed starts · job type · follow-up window · people reached',
  },
  {
    number: '04',
    title: 'Did earnings improve?',
    question: 'Compare the same people before and after.',
    detail: 'Show median wages and median wage changes using people with both before-and-after records. Include the sample size, hours worked, and whether figures are hourly or annualized. Market salary estimates describe occupations; they do not measure member earnings.',
    evidence: 'Look for: paired wage records · median change · hours · sample size',
  },
  {
    number: '05',
    title: 'Did progress last?',
    question: 'A first job matters. Staying employed matters too.',
    detail: 'Define the follow-up period and whether retention means the same job or continued employment. Include people who changed roles, lost work, or could not be reached. Missing follow-up is unknown, rather than automatic success or failure.',
    evidence: 'Look for: retention definition · follow-up dates · missing responses',
  },
  {
    number: '06',
    title: 'How was it checked?',
    question: 'Make the source and its limits visible.',
    detail: 'Identify whether records came from members, credential providers, or employers. Distinguish staff review from independent evaluation. Include the report date, method, corrections, and privacy protections for small groups.',
    evidence: 'Look for: data source · review method · limitations · publication date',
  },
];
---

<Layout
  title="Impact & transparency — WorkforceAP"
  description="Understand WorkforceAP’s public reporting status, what career outcomes should show, and the questions to ask before choosing a training program."
>
  <section class="impact-hero" aria-labelledby="impact-title">
    <div class="wrap">
      <p class="impact-kicker">Impact & transparency</p>
      <div class="impact-intro">
        <div>
          <h1 id="impact-title">Progress that lasts.<br /><span>Proof that holds up.</span></h1>
          <p class="impact-lead">A credential is a milestone. The goal is work that improves a person’s options, income, and future.</p>
          <div class="impact-actions">
            <a class="btn btn--primary" href="/programs">Explore career paths <span aria-hidden="true">→</span></a>
            <a class="impact-text-link" href="#reading-results">Know what to ask</a>
          </div>
        </div>
        <aside class="publication-status" aria-labelledby="publication-title">
          <p class="impact-label">Public reporting status</p>
          <h2 id="publication-title">Outcome report<br />not yet published</h2>
          <p>Cohort-level completion, employment, wage, and retention results are not published on this page.</p>
          <p>That means public results are unavailable here. It does not establish how many people have participated or what their outcomes were.</p>
          <a class="impact-text-link" href="/contact">Ask about available evidence <span aria-hidden="true">→</span></a>
        </aside>
      </div>
    </div>
  </section>

  <section class="band band--surface" aria-labelledby="available-title">
    <div class="wrap impact-split">
      <div class="impact-section-intro">
        <p class="impact-kicker">What you can review today</p>
        <h2 id="available-title">Understand the offer<br />before you apply.</h2>
        <p>Program information can help you decide whether a pathway fits your life. Employment results answer a separate question.</p>
      </div>
      <dl class="available-facts">
        <div>
          <dt>A nonprofit model</dt>
          <dd>WorkforceAP is a 501(c)(3) nonprofit. <a href="/about">Meet the organization</a></dd>
        </div>
        <div>
          <dt>No cost for qualifying members</dt>
          <dd>Training is offered at no cost to members who qualify through scholarship/grant funded membership. <a href="/faq">Review cost and eligibility questions</a></dd>
        </div>
        <div>
          <dt>Recognized credentials</dt>
          <dd>Explore pathways featuring IBM, Google, Microsoft, AWS, and CompTIA credentials. <a href="/programs">Check individual program details</a></dd>
        </div>
        <div>
          <dt>A real team reviews your application</dt>
          <dd>Apply in about five minutes; a real team reviews it and follows up by email. <a href="/how-it-works">See the next steps</a></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="band" id="reading-results" aria-labelledby="results-title">
    <div class="wrap">
      <div class="impact-section-intro impact-section-intro--wide">
        <p class="impact-kicker">A guide to evaluating results</p>
        <h2 id="results-title">Six questions behind<br />a meaningful outcome.</h2>
        <p>Use these questions when reviewing any training provider. They describe what a useful report should contain—not results WorkforceAP has measured or a reporting schedule it has announced.</p>
      </div>
      <ol class="evidence-list">
        {evidenceQuestions.map((item) => (
          <li>
            <span class="evidence-number" aria-hidden="true">{item.number}</span>
            <div class="evidence-title">
              <h3>{item.title}</h3>
              <p>{item.question}</p>
            </div>
            <div class="evidence-detail">
              <p>{item.detail}</p>
              <p class="evidence-check">{item.evidence}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band band--surface" aria-labelledby="stories-title">
    <div class="wrap impact-split">
      <div class="impact-section-intro">
        <p class="impact-kicker">People behind the results</p>
        <h2 id="stories-title">A story belongs<br />to the person who lived it.</h2>
      </div>
      <div class="impact-prose">
        <p>No member stories are published on this page. A story should be shared with the member’s consent and staff review, with clear context about their training and career path.</p>
        <p>One person’s experience can show what is possible. It cannot establish the result a typical member should expect.</p>
        <a class="impact-text-link" href="/contact">Contact the team about a member story <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="impact-next" aria-labelledby="next-title">
    <div class="wrap">
      <div class="impact-section-intro impact-section-intro--wide">
        <p class="impact-kicker">Take the next step</p>
        <h2 id="next-title">Turn a good question<br />into a useful conversation.</h2>
      </div>
      <div class="impact-next-links">
        <a href="/program-comparison">
          <span class="impact-label">For career changers</span>
          <strong>Find a path that fits your life <span aria-hidden="true">↗</span></strong>
          <span>Compare training, credentials, and time commitment.</span>
        </a>
        <a href="/contact">
          <span class="impact-label">For funders & community partners</span>
          <strong>Ask for the evidence you need <span aria-hidden="true">↗</span></strong>
          <span>Discuss available program information, outcome documentation, and your reporting needs.</span>
        </a>
      </div>
    </div>
  </section>

  <style>
    .impact-hero{padding:72px 0 80px;background:linear-gradient(115deg,var(--bg),var(--surface-2));border-bottom:1px solid var(--border)}
    .impact-kicker,.impact-label{font-size:13px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
    .impact-kicker{color:var(--crimson);margin-bottom:20px}
    .impact-label{color:var(--muted)}
    .impact-intro{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:64px;align-items:start}
    .impact-intro h1{font-size:clamp(40px,4.7vw,64px);font-weight:800;line-height:1.08;letter-spacing:-.045em}
    .impact-intro h1 span{display:inline-block;color:var(--crimson);text-wrap:balance}
    .impact-lead{max-width:32em;font-size:20px;color:var(--muted);margin-top:24px}
    .impact-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin-top:32px}
    .impact-text-link{display:inline-flex;align-items:center;gap:8px;min-height:44px;color:var(--crimson);font-weight:700;text-decoration:underline;text-underline-offset:5px}
    .publication-status{padding:24px 0 0;border-top:3px solid var(--crimson)}
    .publication-status h2{font-size:28px;line-height:1.15;margin:16px 0 20px}
    .publication-status p:not(.impact-label){color:var(--muted);margin-bottom:16px;font-size:16px}
    .impact-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:80px;align-items:start}
    .impact-section-intro h2{font-size:clamp(30px,3.2vw,44px);line-height:1.15;letter-spacing:-.035em}
    .impact-section-intro>p:last-child{color:var(--muted);font-size:18px;margin-top:20px;max-width:42em}
    .impact-section-intro--wide{max-width:760px;margin-bottom:40px}
    .available-facts>div{padding:22px 0;border-bottom:1px solid var(--border)}
    .available-facts>div:first-child{padding-top:0}
    .available-facts dt{font-family:'Plus Jakarta Sans',sans-serif;font-size:20px;line-height:1.3;font-weight:800;margin-bottom:10px}
    .available-facts dd{color:var(--muted);font-size:16px}
    .available-facts a{color:var(--crimson);text-decoration:underline;text-underline-offset:3px}
    .evidence-list{list-style:none;border-top:1px solid var(--border)}
    .evidence-list>li{display:grid;grid-template-columns:48px minmax(0,.8fr) minmax(0,1.25fr);gap:32px;padding:32px 0;border-bottom:1px solid var(--border)}
    .evidence-number{font-family:'Plus Jakarta Sans',sans-serif;color:var(--crimson);font-size:24px;font-weight:800;font-variant-numeric:tabular-nums;line-height:1.3}
    .evidence-title h3{font-size:23px;line-height:1.2}
    .evidence-title p{color:var(--muted);font-size:16px;margin-top:12px;max-width:24em}
    .evidence-detail p{font-size:16px;color:var(--muted)}
    .evidence-detail .evidence-check{color:var(--text);font-size:14px;font-weight:600;margin-top:16px}
    .impact-prose p{font-size:18px;color:var(--muted);margin-bottom:20px}
    .impact-next{padding:68px 0 80px;background:var(--bg)}
    .impact-next-links{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
    .impact-next-links>a{padding:32px 40px 32px 0;display:flex;flex-direction:column;align-items:start;gap:14px}
    .impact-next-links>a+a{padding-left:40px;border-left:1px solid var(--border)}
    .impact-next-links strong{font-family:'Plus Jakarta Sans',sans-serif;color:var(--crimson);font-size:23px;line-height:1.3;text-decoration:underline;text-underline-offset:5px}
    .impact-next-links>a>span:last-child{font-size:16px;color:var(--muted)}
    .impact-text-link:hover,.available-facts a:hover,.impact-next-links>a:hover strong{color:var(--accent-dark);text-decoration-thickness:2px}
    .impact-text-link:focus-visible,.available-facts a:focus-visible,.impact-next-links>a:focus-visible,.impact-actions .btn:focus-visible{outline:3px solid var(--crimson);outline-offset:5px}
    #reading-results{scroll-margin-top:96px}
    @media(max-width:880px){
      .impact-hero{padding:48px 0 56px}
      .impact-intro,.impact-split{grid-template-columns:1fr;gap:40px}
      .publication-status{max-width:640px}
      .evidence-list>li{grid-template-columns:40px minmax(0,1fr);gap:16px 24px}
      .evidence-detail{grid-column:2}
      .evidence-title p{max-width:none}
      .impact-next-links strong{font-size:21px}
    }
    @media(max-width:560px){
      .impact-intro h1{font-size:40px}
      .impact-lead{font-size:18px}
      .impact-actions{gap:12px 24px}
      .impact-actions .btn{width:100%;justify-content:center}
      .impact-section-intro h2{font-size:32px}
      .evidence-list>li{gap:14px 16px;padding:28px 0}
      .evidence-title h3{font-size:21px}
      .evidence-detail{grid-column:1/-1}
      .impact-next-links{grid-template-columns:1fr}
      .impact-next-links>a{padding:28px 0}
      .impact-next-links>a+a{padding:28px 0;border-left:0;border-top:1px solid var(--border)}
    }
  </style>
</Layout>
