---
import Layout from '../layouts/Layout.astro';
import InterestProfilerQuiz from '../components/InterestProfilerQuiz.tsx';
import Icon from '../components/Icon.astro';
---
<Layout
  title="O*NET Interest Profiler — Free Career Quiz — WorkforceAP"
  description="Rate 30 activities and discover your RIASEC interest profile. See how your interests line up with WorkforceAP programs — no account required."
>
<!-- DEPTH STAGE HERO (compact crimson band) -->
<section class="ip-hero stage" aria-labelledby="ip-hero-heading">
  <div class="aura aura--1" aria-hidden="true"></div>
  <div class="aura aura--2" aria-hidden="true"></div>
  <div class="aura aura--3" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>

  <div class="wrap stage-grid">
    <div class="ip-hero__inner">
      <span class="pill"><span class="pill__star"><Icon name="star" size={12} /></span>Free career quiz · no account required</span>
      <h1 id="ip-hero-heading" class="ip-hero__heading">O*NET Interest Profiler — discover your career interests.</h1>
      <p class="ip-hero__subhead">Rate 30 activities and discover your RIASEC interest profile. See how your interests line up with WorkforceAP programs — no account required.</p>
      <p class="ip-hero__help">Questions? Call <a href="tel:+15127771808">(512) 777-1808</a></p>
      <a class="dbtn dbtn--solid ip-hero__cta" href="#ip-quiz">Start the quiz <span>→</span></a>
    </div>

    <!-- depth glass card -->
    <aside class="hero-glass" aria-hidden="true">
      <div class="hg-head">
        <div class="hg-ic"><Icon name="target" /></div>
        <div>
          <b>RIASEC interest profile</b>
          <span>From the U.S. Department of Labor's O*NET.</span>
        </div>
      </div>
      <div class="hg-meter">
        <span>Activities to rate</span>
        <strong>30</strong>
      </div>
      <div class="hg-chips">
        <span>~10 min</span>
        <span>No account</span>
        <span>O*NET</span>
      </div>
    </aside>
  </div>
</section>

<!-- QUIZ SECTION -->
<section id="ip-quiz" class="band band--surface ip-quiz-section" aria-label="Interest Profiler quiz">
  <div class="wrap ip-quiz-wrap">
    <p class="ip-kicker">U.S. Department of Labor O*NET Interest Profiler™ · 30 activities</p>
    <div class="ip-island">
      <InterestProfilerQuiz client:visible />
    </div>
  </div>
</section>

<style>
  /* ===================================================================
     INTEREST PROFILER — DEPTH-LED page. Compact crimson depth-stage hero
     (glow auras + luminosity-masked photo + gold pill + glass card) over a
     light quiz band that hosts the React island. Matches /apply depth design.
     =================================================================== */

  /* ---------------- DEPTH HERO STAGE ---------------- */
  .ip-hero.stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:64px 0 72px;text-align:left;
  }
  .stage-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:52px;align-items:center;position:relative;z-index:2}

  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:460px;height:460px;top:-150px;right:-110px;background:radial-gradient(circle,rgba(196,154,72,.5),transparent 68%)}
  .aura--2{width:420px;height:420px;bottom:-190px;left:-130px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:340px;height:340px;top:24%;left:46%;background:radial-gradient(circle,rgba(255,255,255,.15),transparent 70%)}

  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:overlay;pointer-events:none;
    background-image:var(--wap-hero-photo-url);background-size:cover;background-position:center;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);opacity:.17}

  .ip-hero__inner{max-width:none;position:relative;z-index:2}

  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;
    background:var(--grad-gold);color:var(--gold-ink);font-weight:800;font-size:13px;
    letter-spacing:.02em;line-height:1.2;padding:9px 17px;border-radius:999px;margin-bottom:20px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{font-size:13px;opacity:.95}
  @media(max-width:520px){.pill{white-space:normal;text-align:left}}

  .ip-hero__heading{font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(30px,5vw,48px);font-weight:800;line-height:1.05;letter-spacing:-.025em}
  .ip-hero__subhead{margin-top:16px;font-size:clamp(16px,2.2vw,19px);color:rgba(255,255,255,.86);line-height:1.5;max-width:34em}
  .ip-hero__help{margin-top:18px;font-size:14px;color:rgba(255,255,255,.86)}
  .ip-hero__help a{color:#fff;font-weight:700;text-decoration:underline}

  .ip-hero__cta{margin-top:26px}

  .hero-glass{position:relative;z-index:2;border-radius:22px;padding:26px;
    background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.2);backdrop-filter:blur(18px);
    box-shadow:var(--shadow-glass);color:#fff}
  .hg-head{display:flex;align-items:flex-start;gap:13px;margin-bottom:18px}
  .hg-ic{flex-shrink:0;width:38px;height:38px;border-radius:11px;display:grid;place-items:center;
    background:rgba(196,154,72,.28);border:1px solid rgba(243,210,143,.45);color:var(--gold-glow);font-weight:800;font-size:17px}
  .hg-head b{display:block;font-weight:700;font-size:15px}
  .hg-head span{font-size:13px;color:rgba(255,255,255,.78)}
  .hg-meter{display:flex;align-items:baseline;justify-content:space-between;padding:14px 16px;border-radius:13px;
    background:rgba(0,0,0,.18);border:1px solid rgba(255,255,255,.12);margin-bottom:14px}
  .hg-meter span{font-size:13px;color:rgba(255,255,255,.8)}
  .hg-meter strong{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:26px;color:var(--gold-glow)}
  .hg-chips{display:flex;flex-wrap:wrap;gap:8px}
  .hg-chips span{font-size:13px;font-weight:700;padding:6px 12px;border-radius:999px;
    background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18)}

  @media(max-width:880px){
    .stage-grid{grid-template-columns:1fr;gap:36px}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
    .hero-glass{max-width:420px}
  }

  /* ---------------- LIGHT QUIZ BAND ---------------- */
  .ip-quiz-section{padding:var(--sec-pad) 0}
  .ip-quiz-wrap{max-width:720px;margin:0 auto}
  .ip-kicker{font-size:13px;font-weight:700;color:var(--gold-dark);background:rgba(164,127,56,.1);border:1px solid rgba(164,127,56,.22);border-radius:999px;padding:8px 16px;display:inline-block;margin-bottom:18px}

  /* ===================================================================
     QUIZ ISLAND (.ipq-*) — depth styling in the established .elig-* idiom
     =================================================================== */
  .ip-island :global(.ipq-card){
    background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
    padding:28px;box-shadow:var(--shadow-lg);
  }
  .ip-island :global(.ipq-h){font-family:'Plus Jakarta Sans',sans-serif;font-size:24px;font-weight:800;margin-bottom:8px}
  .ip-island :global(.ipq-lede){color:var(--muted);font-size:15px;line-height:1.65;margin-bottom:18px}
  .ip-island :global(.ipq-status){color:var(--muted);font-size:15px;padding:8px 0}
  .ip-island :global(.ipq-err){color:#b91c1c;font-weight:600;margin-bottom:1rem}
  .ip-island :global(.ipq-fine){font-size:13px;color:var(--muted);line-height:1.6}
  .ip-island :global(.ipq-fine a),
  .ip-island :global(.ipq-fine code){color:inherit}
  .ip-island :global(.ipq-fine a){text-decoration:underline}
  .ip-island :global(.ipq-link){color:var(--crimson);font-weight:700;text-decoration:underline}
  .ip-island :global(.ipq-muted){color:var(--muted)}

  /* progress bar */
  .ip-island :global(.ipq-progress){height:8px;border-radius:5px;background:var(--border);overflow:hidden;margin-bottom:20px}
  .ip-island :global(.ipq-progress i){display:block;height:100%;background:var(--grad);transition:width .35s cubic-bezier(.2,.7,.3,1)}

  /* question card */
  .ip-island :global(.ipq-q){border:1px solid var(--border);background:var(--surface-2);border-radius:14px;padding:18px 18px 20px;margin-bottom:18px;border-left:4px solid var(--crimson)}
  .ip-island :global(.ipq-q__area){font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--crimson);margin:0 0 8px}
  .ip-island :global(.ipq-q__text){margin:0;font-size:17px;line-height:1.5;font-weight:600;color:var(--text)}

  /* likert options */
  .ip-island :global(.ipq-fieldset){border:0;padding:0;margin:0 0 18px}
  .ip-island :global(.ipq-legend){font-size:13px;font-weight:700;color:var(--text);margin-bottom:12px;padding:0}
  .ip-island :global(.ipq-opts){display:flex;flex-direction:column;gap:9px}
  .ip-island :global(.ipq-opt){position:relative;display:flex;align-items:center;gap:12px;padding:13px 15px;border-radius:12px;
    border:1.5px solid var(--border);background:#fff;cursor:pointer;font-size:15px;
    transition:border-color .15s,background .15s,box-shadow .15s}
  .ip-island :global(.ipq-opt:hover){border-color:var(--crimson)}
  .ip-island :global(.ipq-opt.is-on){border-color:var(--crimson);background:rgba(173,44,77,.06);box-shadow:0 0 0 3px rgba(173,44,77,.08)}
  .ip-island :global(.ipq-opt input){position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}
  .ip-island :global(.ipq-opt:focus-within){outline:2px solid var(--crimson);outline-offset:2px}
  .ip-island :global(.ipq-opt__num){width:28px;height:28px;border-radius:50%;display:grid;place-items:center;flex-shrink:0;
    background:var(--border);color:var(--muted);font-size:13px;font-weight:800;transition:background .15s,color .15s}
  .ip-island :global(.ipq-opt.is-on .ipq-opt__num){background:var(--crimson);color:#fff}
  .ip-island :global(.ipq-opt__label){font-weight:500;color:var(--text)}
  .ip-island :global(.ipq-opt.is-on .ipq-opt__label){font-weight:600;color:var(--crimson)}

  /* nav row */
  .ip-island :global(.ipq-nav){display:flex;flex-wrap:wrap;gap:12px;align-items:center}
  .ip-island :global(.ipq-nav .btn:disabled){opacity:.5;cursor:not-allowed;transform:none}
  .ip-island :global(.ipq-count){font-size:13px;color:var(--muted)}

  /* result screen */
  .ip-island :global(.ipq-cta){margin-bottom:24px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
  .ip-island :global(.ipq-cta__alt){font-size:14px;color:var(--muted)}
  .ip-island :global(.ipq-cta__alt a){color:var(--crimson);font-weight:700;text-decoration:underline}
  .ip-island :global(.ipq-section){margin-bottom:28px}
  .ip-island :global(.ipq-h3){font-family:'Plus Jakarta Sans',sans-serif;font-size:18px;font-weight:800;margin-bottom:12px}
  .ip-island :global(.ipq-section__note){margin-bottom:10px}

  .ip-island :global(.ipq-bars){list-style:none;padding:0;margin:0}
  .ip-island :global(.ipq-bar-row){margin-bottom:13px}
  .ip-island :global(.ipq-bar-head){display:flex;justify-content:space-between;margin-bottom:5px}
  .ip-island :global(.ipq-bar-name){font-weight:700;font-size:15px}
  .ip-island :global(.ipq-bar-score){color:var(--muted);font-size:14px;font-weight:600}
  .ip-island :global(.ipq-bar-track){height:9px;border-radius:5px;background:var(--border);overflow:hidden}
  .ip-island :global(.ipq-bar-track i){display:block;height:100%;background:var(--grad)}

  .ip-island :global(.ipq-careers){padding-left:1.25rem;line-height:1.7;color:var(--text);font-size:15px;margin:0}
  .ip-island :global(.ipq-programs){list-style:none;padding:0;margin:0}
  .ip-island :global(.ipq-programs li){margin-bottom:8px}

  .ip-island :global(.ipq-save){display:flex;gap:14px;align-items:flex-start;padding:16px 18px;margin-bottom:22px;
    background:rgba(173,44,77,.07);border:1px solid rgba(173,44,77,.15);border-radius:14px}
  .ip-island :global(.ipq-save__ic){flex-shrink:0;font-size:22px;line-height:1;color:var(--crimson);margin-top:2px}
  .ip-island :global(.ipq-save__title){font-weight:800;font-size:14.5px;color:var(--text);margin:0 0 4px}
  .ip-island :global(.ipq-save__body){font-size:13px;color:var(--muted);margin:0;line-height:1.55}

  @media(max-width:560px){
    .ip-island :global(.ipq-card){padding:20px}
  }
</style>
</Layout>
