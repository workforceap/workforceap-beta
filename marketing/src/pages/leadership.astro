---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { LEADERS } from '../data/leadership';

// Leadership content is the single source of truth in src/data/leadership.ts
// (the LEADERS array, also used by /leadership/[slug].astro). Derive the three
// listing groups here so names/roles/bios never drift from the canonical data.
const executives = LEADERS.filter((l) => ['michael-brown', 'adriane-brown'].includes(l.slug));
const boardMembers = LEADERS.filter((l) => l.role.startsWith('Board'));
const leadConsultants = LEADERS.filter((l) => l.section === 'consultant' || l.role === 'Lead Consultant');
---
<Layout
  title="Board & Leadership — WorkforceAP"
  description="Meet the leadership team behind WorkforceAP — decades of workforce experience, employer-side tech credibility, military discipline, and nationwide community impact."
>
<div class="lead">

  <!-- ============================================================
       HERO — DEPTH STAGE (shorter band): deep radial crimson→plum,
       gold/crimson/white glow auras, luminosity-masked photo,
       white headline + gold pill + translucent glass quote card.
       ============================================================ -->
  <section class="stage">
    <div class="aura aura--1"></div>
    <div class="aura aura--2"></div>
    <div class="aura aura--3"></div>
    <div class="grain" aria-hidden="true"></div>

    <div class="wrap stage-grid">
      <div class="lede">
        <span class="pill"><span class="pill__star" aria-hidden="true"><Icon name="star" size={12} /></span>Our Leadership</span>
        <h1>Stewards of the <span class="shimmer">Future Workforce.</span></h1>
        <p class="sub">Our governance team combines decades of workforce development leadership, employer-side tech credibility, military and operations discipline, and deep community roots — connecting workforce training to real outcomes across the nation.</p>
      </div>

      <aside class="quote-card">
        <div class="qhead">
          <span class="qbadge" aria-hidden="true">
            <Icon name="check-circle" size={18} />
          </span>
          <span class="qlabel">Established 2025</span>
        </div>
        <blockquote>This isn't a generic nonprofit team. These are people who've run programs at scale, led at Goodwill and Urban League, built systems at IBM and Microsoft, commanded in the Army and at AWS — and who show up nationwide.</blockquote>
      </aside>
    </div>
  </section>

  <!-- EXECUTIVE COUNCIL -->
  <section class="band band--bg"><div class="wrap">
    <div class="sec-head">
      <span class="kick kick--crimson">Executive Council</span>
      <h2>Operational Leadership</h2>
    </div>
    <div class="tri lead-exec">
      {executives.map((leader) => (
        <a class="acard person" href={`/leadership/${leader.slug}`} aria-label={`View profile of ${leader.name}`}>
          <div class="portrait">
            {leader.image
              ? <img class="portrait-img" src={leader.image} alt={`Portrait of ${leader.name.replace(/,.*$/, '')}`} width="176" height="176" loading="lazy" />
              : <span class="initials" aria-hidden="true">{leader.initials}</span>}
            {leader.founder && <span class="founder">Founder</span>}
          </div>
          <span class="role">{leader.role}</span>
          <h3>{leader.name}</h3>
          <p class="mission">{leader.missionRelevance}</p>
          <p>{leader.cardBio}</p>
          <span class="go">View profile <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </div></section>

  <!-- BOARD OF TRUSTEES -->
  <section class="band band--surface"><div class="wrap">
    <div class="sec-head">
      <span class="kick kick--crimson">Board of Trustees</span>
      <h2>Strategic Governance</h2>
    </div>
    <div class="tri">
      {boardMembers.map((leader) => (
        <a class="acard person" href={`/leadership/${leader.slug}`} aria-label={`View profile of ${leader.name}`}>
          <div class="portrait">
            {leader.image
              ? <img class="portrait-img" src={leader.image} alt={`Portrait of ${leader.name.replace(/,.*$/, '')}`} width="176" height="176" loading="lazy" />
              : <span class="initials" aria-hidden="true">{leader.initials}</span>}
          </div>
          <span class="role">{leader.role}</span>
          <h3>{leader.name}</h3>
          <p class="mission">{leader.missionRelevance}</p>
          <p>{leader.cardBio}</p>
          <span class="go">View profile <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </div></section>

  <!-- LEAD CONSULTANT -->
  <section class="band band--bg"><div class="wrap">
    <div class="sec-head">
      <span class="kick kick--crimson">Advisory</span>
      <h2>Lead Consultant</h2>
    </div>
    <div class="tri">
      {leadConsultants.map((leader) => (
        <a class="acard person" href={`/leadership/${leader.slug}`} aria-label={`View profile of ${leader.name}`}>
          <div class="portrait">
            {leader.image
              ? <img class="portrait-img" src={leader.image} alt={`Portrait of ${leader.name.replace(/,.*$/, '')}`} width="176" height="176" loading="lazy" />
              : <span class="initials" aria-hidden="true">{leader.initials}</span>}
          </div>
          <span class="role">{leader.role}</span>
          <h3>{leader.name}</h3>
          <p class="mission">{leader.missionRelevance}</p>
          <p>{leader.cardBio}</p>
          <span class="go">View profile <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </div></section>

  <!-- ============================================================
       CLOSING CTA — BOLD full-bleed crimson, photo luminosity.
       ============================================================ -->
  <section class="close">
    <div class="close__media" aria-hidden="true"></div>
    <div class="close__veil" aria-hidden="true"></div>
    <div class="close__inner wrap">
      <h2>Join the Mission</h2>
      <p>Whether you want to partner, volunteer, serve on the board, or support workforce development nationwide — we want to hear from you.</p>
      <div class="acts acts--center">
        <a class="bbtn bbtn--gold" href="/contact">Get in Touch</a>
        <a class="bbtn bbtn--outline" href="/programs">View Programs</a>
      </div>
    </div>
  </section>

</div>

<style>
  /* ===================================================================
     LEADERSHIP — DEPTH-LED.
     shorter depth stage hero (crimson band) with glass quote card →
     alternating light bands with elevated leader cards →
     bold full-bleed closing crimson CTA.
     =================================================================== */
  .lead{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}

  /* ---------------- DEPTH HERO STAGE (shorter band) ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:84px 0 92px;
  }
  .stage-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:52px;align-items:center;position:relative;z-index:2}

  /* glow auras — gold + crimson + white */
  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:520px;height:520px;top:-180px;right:-120px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:440px;height:440px;bottom:-220px;left:-150px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:360px;height:360px;top:24%;left:46%;background:radial-gradient(circle,rgba(255,255,255,.15),transparent 70%)}

  /* luminosity-masked real photo bleeding in from the right */
  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:overlay;pointer-events:none;
    background-image:var(--wap-hero-photo-url);background-size:cover;background-position:center;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);opacity:.16}

  /* gold PILL — fully visible, never clipped */
  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:linear-gradient(135deg,#e3bd6a,#a47f38);color:#3a2c10;font-weight:800;font-size:13px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{font-size:13px;opacity:.95}
  @media(max-width:430px){.pill{white-space:normal;text-align:left}}

  .lede h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(38px,5.4vw,64px);
    line-height:1.04;letter-spacing:-.03em;margin:22px 0 0}
  .shimmer{background:linear-gradient(100deg,#fff 10%,#f3d28f 50%,#fff 90%);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .lede .sub{font-size:19px;line-height:1.55;color:rgba(255,255,255,.84);max-width:34em;margin:22px 0 0}

  /* translucent glass quote card — hero companion */
  .quote-card{background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(18px);
    border-radius:22px;padding:30px;color:#fff;
    box-shadow:var(--shadow-glass)}
  .qhead{display:flex;align-items:center;gap:12px;margin-bottom:16px}
  .qbadge{width:40px;height:40px;border-radius:12px;background:rgba(127,227,137,.18);color:#caffce;
    border:1px solid rgba(120,220,130,.4);display:grid;place-items:center;flex-shrink:0}
  .qlabel{font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#f3d28f}
  .quote-card blockquote{font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:20px;line-height:1.42;color:#fff}
  .quote-card blockquote::before{content:'\201C';color:#f3d28f}
  .quote-card blockquote::after{content:'\201D';color:#f3d28f}

  /* ---------------- ALTERNATING LIGHT BANDS ---------------- */
  .band{width:100%;padding:var(--sec-pad) 0}
  .band--bg{background:var(--bg);color:var(--text)}
  .band--surface{background:var(--surface);color:var(--text)}

  /* left-align over the left-aligned leader-card grids below — a centered
     kicker/heading above a left-set grid of cards was the one remaining
     symmetric mismatch on this page. */
  .sec-head{text-align:left;max-width:640px;margin:0 0 52px}
  .kick{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin-bottom:16px}
  .kick--crimson{color:var(--crimson)}
  .sec-head h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(32px,4.4vw,50px);line-height:1.02;letter-spacing:-.02em}

  /* ---------------- ELEVATED LEADER CARDS ---------------- */
  .tri{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .lead-exec{grid-template-columns:repeat(2,1fr)}
  @media(max-width:880px){.tri{grid-template-columns:1fr}.lead-exec{grid-template-columns:1fr}}

  .acard{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:34px 30px;
    box-shadow:var(--shadow);border-top:6px solid var(--crimson);transition:transform .2s,box-shadow .25s}
  .acard:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}
  .band--surface .tri .acard:nth-child(2){border-top-color:var(--blue)}
  .band--surface .tri .acard:nth-child(3){border-top-color:var(--gold)}

  .person{display:flex;flex-direction:column}
  .portrait{position:relative;width:88px;height:88px;border-radius:20px;background:var(--grad);display:grid;place-items:center;margin-bottom:22px;box-shadow:0 12px 30px -10px rgba(173,44,77,.5)}
  .portrait .initials{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:30px;color:#fff;letter-spacing:-.02em}
  .portrait .portrait-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:inherit;display:block}
  .portrait .founder{position:absolute;bottom:-9px;left:50%;transform:translateX(-50%);white-space:nowrap;font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#fff;background:linear-gradient(135deg,var(--gold),var(--gold-dark));padding:4px 11px;border-radius:999px;box-shadow:0 8px 20px -6px rgba(164,127,56,.6)}

  .person .role{font-size:13px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--crimson)}
  .person h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:22px;font-weight:800;margin:6px 0 12px;letter-spacing:-.01em}
  .person .mission{color:var(--text);font-weight:600;font-size:15px;line-height:1.55;margin-bottom:12px}
  .person p{color:var(--muted);font-size:15px;line-height:1.55;margin-bottom:16px}
  .person .go{margin-top:auto;font-weight:800;color:var(--crimson);font-size:15px}
  .person:hover .go{color:var(--accent-dark)}

  /* ---------------- BOLD FULL-BLEED CLOSING CTA ---------------- */
  .close{
    position:relative;overflow:hidden;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
  }
  .close__media{position:absolute;inset:0;background:var(--wap-hero-photo-url-3) center 40%/cover no-repeat}
  .close__veil{position:absolute;inset:0;
    background:var(--wap-hero-close-veil)}
  .close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:92px 24px 100px;max-width:var(--max)}
  .close__inner h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(34px,5.5vw,62px);line-height:1;letter-spacing:-.03em;margin-bottom:16px}
  .close__inner p{font-size:clamp(17px,2.2vw,21px);color:rgba(255,255,255,.92);max-width:38em;margin:0 auto 30px;line-height:1.5}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}

  /* ---------------- RESPONSIVE ---------------- */
  @media (prefers-reduced-motion: no-preference){
    .quote-card{animation:lead-float 8s ease-in-out infinite}
    @keyframes lead-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
  }
  @media(max-width:960px){
    .stage{padding:64px 0 76px}
    .stage-grid{grid-template-columns:1fr;gap:36px}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
  }
  @media(max-width:560px){
    .band{padding:60px 0}
    .acts .bbtn{width:100%;justify-content:center}
  }
</style>
</Layout>
</content>
</invoke>
