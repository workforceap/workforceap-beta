---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { PROGRAMS, partnerBadge, type Program } from '../../data/programs';

// ── Static generation: one page per program slug (all 21) ──
export function getStaticPaths() {
  return PROGRAMS.map((program) => ({
    params: { slug: program.slug },
    props: { program },
  }));
}

interface Props { program: Program }
const { program } = Astro.props;

const display = program.title;
const badge = partnerBadge(program);
const extra = program.extra;
const curriculumOwnerVerified = program.curriculum?.status === 'owner-verified';

// A missing difficulty score is not evidence of an admission prerequisite.
const preparationCopy = program.syllabus?.recommendedPrerequisite
  ?? (program.syllabus
    ? 'The published syllabus does not list a recommended prerequisite. Ask an advisor to confirm preparation and program fit.'
    : 'Ask an advisor to confirm the preparation and program fit for your background.');
// Older planning notes include unsupported comparative pay claims.
const bestFor = program.slug === 'aws-cloud-technology-amazon'
  ? 'Tech-curious learners ready for cloud.'
  : extra?.bestFor;
const rampNote = program.slug === 'cybersecurity-professional-certificate-google'
  ? 'Assumes basic computer comfort.'
  : extra?.rampNote;

// Funding copy (verbatim from the Next detail page)
const fundingCopy = program.fundingSource
  ? `Available at no cost through ${program.fundingSource} funding for qualifying members.`
  : 'No-cost training for qualifying members.';

// Language support (verbatim labels from the Next ProgramDetailClient)
type LangLevel = 'full' | 'subtitles' | 'ai-subtitles' | 'none';
const langLabels: Record<'es' | 'pt' | 'fr', string> = { es: 'Spanish', pt: 'Portuguese', fr: 'French' };
const ls = program.languagesSupported;
const activeLangs = ls
  ? (['es', 'pt', 'fr'] as const)
      .map((code) => ({ code, level: ls[code] as LangLevel }))
      .filter((e) => e.level !== 'none')
  : [];
function langChip(label: string, level: LangLevel): string {
  if (level === 'full') return `${label} (full)`;
  if (level === 'subtitles') return `${label} (subtitles)`;
  return `${label} (auto-subtitles)`;
}

const skills = program.skills.filter((s) => s.trim().length > 0);

// Per-course MSSC assessment alignment, for curriculum-backed programs
// (CPT, CLT). Keyed the same way the catalog joins course content, so a
// reordered course list still lines up with its alignment.
const normalizeCourseName = (name: string) =>
  name
    .toLowerCase()
    .replace(/&/g, ' and ')
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
const courseAlignment = new Map<string, string[]>(
  (program.curriculum?.courses ?? []).map((c) => [
    normalizeCourseName(c.name),
    c.certificationAlignment,
  ]),
);

const coursePreview = program.courses.slice(0, 4);
const extraCourses = program.courses.length - 4;
const linkedContentProvider = program.courses.find((course) => course.provider?.license)?.provider;

const rawRef = Astro.url.searchParams.get('ref') ?? '';
const partnerRef = /^[a-z0-9-]{1,64}$/i.test(rawRef.trim()) ? rawRef.trim().toLowerCase() : '';
const applyHref = partnerRef
  ? `/apply?ref=${encodeURIComponent(partnerRef)}&program=${encodeURIComponent(program.slug)}`
  : `/apply?program=${program.slug}`;
const applyHomeHref = partnerRef ? `/apply?ref=${encodeURIComponent(partnerRef)}` : '/apply';

// One-stop external course (ops 9/2/26: Digital Literacy → Microsoft's free
// course). The primary CTA opens the course directly; applying to WorkforceAP
// for member support stays available as the secondary action.
const externalCourseUrl = program.externalCourseUrl ?? '';
const primaryHref = externalCourseUrl || applyHref;
const primaryLabel = externalCourseUrl ? 'Start the free course' : 'Apply Now';
const primaryAttrs = externalCourseUrl ? { target: '_blank', rel: 'noopener noreferrer' } : {};

const pageTitle = `${display} Training & Certification`;
const metaDescription = `Explore ${display}: ${program.duration}, course content, and program preparation. Training at no cost for members who qualify through scholarship/grant funded membership.`;
---
<Layout title={pageTitle} description={metaDescription}>
<div class="pdepth">

<!-- ════════════════ HERO — compact crimson DEPTH stage ════════════════ -->
<section class="stage">
  <div class="aura aura--1"></div>
  <div class="aura aura--2"></div>
  <div class="grain"></div>

  <div class="wrap stage-inner">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>›</span><a href="/programs">Programs</a><span>›</span><span class="cur">{display}</span>
    </nav>
    <span class="cat-pill" style={`background:${program.categoryColor}`}>{program.categoryLabel}</span>
    <h1>{display}</h1>
    <p class="meta">{program.duration}</p>
    <p class="partner">{badge}</p>
    {extra && (
      <div class="fit">
        <p><strong>Best for:</strong> {bestFor}</p>
        <p><strong>Roles to research:</strong> {extra.jobOutcomes.join(' · ')}</p>
        {rampNote && <p><strong>Preparation:</strong> {rampNote}</p>}
      </div>
    )}
    <div class="hero-acts">
      <a class="dbtn dbtn--solid" href={primaryHref} {...primaryAttrs}>{primaryLabel} <span>→</span></a>
      {externalCourseUrl
        ? <a class="dbtn dbtn--hero-secondary" href={applyHref}>Apply for WorkforceAP member support</a>
        : <a class="dbtn dbtn--hero-secondary" href="/find-your-path">Not sure? Take the pathfinder quiz</a>}
    </div>
  </div>
</section>

<!-- ════════════════ PILOT NOTE ════════════════ -->
<section class="band band--surface" style="padding-top:0">
  <div class="wrap">
    <p class="pilot">★ Pilot program — reviewed by a real team, with a decision by email.</p>
  </div>
</section>

<!-- ════════════════ BODY — main + sidebar ════════════════ -->
<section class="band band--surface" style="padding-top:24px">
  <div class="wrap grid">
    <div class="main">
      <p class="lead">{program.description}</p>

      {program.syllabus && (
        <div class="card">
          <p class="eyebrow">Official program syllabus</p>
          <h2 class="card-h">Training details</h2>
          <div class="quad">
            <div>
              <h3>Delivery format</h3>
              <p>{program.syllabus.deliveryFormat}</p>
            </div>
            <div>
              <h3>Total hours</h3>
              <p>{program.syllabus.totalHoursLabel}</p>
            </div>
            <div>
              <h3>Training providers</h3>
              <p>{program.syllabus.providers}</p>
            </div>
            <div>
              <h3>Published tuition and fees</h3>
              <p>${program.syllabus.tuitionAndFees.toLocaleString('en-US')}</p>
              <p>Qualifying WorkforceAP members are not billed for covered training.</p>
            </div>
          </div>
          {program.syllabus.recommendedPrerequisite && (
            <p class="muted"><strong>Recommended prerequisite:</strong> {program.syllabus.recommendedPrerequisite}</p>
          )}
        </div>
      )}

      {program.curriculum && (
        <div class="card">
          <p class="eyebrow">WorkforceAP-authored curriculum</p>
          <h2 class="card-h">Training details</h2>
          {curriculumOwnerVerified ? (
            <div class="quad">
              <div>
                <h3>Delivery format</h3>
                <p>{program.curriculum.deliveryFormat}</p>
              </div>
              <div>
                <h3>Total hours</h3>
                <p>{program.curriculum.totalHoursLabel}</p>
              </div>
              <div>
                <h3>Certification this training prepares you to pursue.</h3>
                <p>{program.curriculum.credential}</p>
              </div>
              <div>
                <h3>Published tuition and fees</h3>
                <p>${program.curriculum.tuitionAndFees.toLocaleString('en-US')}</p>
                <p>Qualifying WorkforceAP members are not billed for covered training.</p>
              </div>
            </div>
          ) : (
            <>
              <p class="muted">
                <strong>No program-owner-supplied syllabus is on file for this program.</strong>{' '}
                The course outline below is authored by WorkforceAP. Hours, delivery format,
                and tuition and fees remain pending program-owner verification and are not
                published here as verified program facts.
              </p>
              <div class="quad quad-pending">
                <div>
                  <h3>Certification this training prepares you to pursue.</h3>
                  <p>{program.curriculum.credential}</p>
                </div>
              </div>
            </>
          )}
          <h3 class="cert-h">What the certification assesses</h3>
          <div class="chiprow">
            {program.curriculum.certificationTargets.map((t) => <span class="skill">{t}</span>)}
          </div>
          {program.curriculum.certificationReference && (
            <p class="muted">
              Assessment source:{' '}
              <a href={program.curriculum.certificationReference.url}>
                {program.curriculum.certificationReference.title}
              </a>{' '}
              (verified {program.curriculum.certificationReference.verifiedOn}).
            </p>
          )}
        </div>
      )}

      <!-- Program snapshot -->
      <div class="card">
        <p class="eyebrow">Program snapshot</p>
        <h2 class="card-h">What you should know before you apply</h2>
        <div class="trio">
          <div>
            <h3>Best fit</h3>
            <p>{bestFor ?? `Members exploring ${program.categoryLabel.toLowerCase()} training with a clear first credential.`}</p>
          </div>
          <div>
            <h3>Typical roles</h3>
            <p>{extra?.jobOutcomes?.length ? extra.jobOutcomes.join(' · ') : `Early-career ${program.categoryLabel.toLowerCase()} roles tied to this training path.`}</p>
          </div>
          <div>
            <h3>Course preview</h3>
            <ul class="prev">
              {coursePreview.map((c) => <li>{c.name}</li>)}
            </ul>
            {extraCourses > 0 && (
              <p class="prev-more">Plus {extraCourses} more course{extraCourses === 1 ? '' : 's'} in the full path.</p>
            )}
          </div>
        </div>
      </div>

      <!-- Languages -->
      <div class="block">
        <h2 class="block-h">Languages</h2>
        {activeLangs.length === 0 ? (
          <p class="muted">This program is offered in English.</p>
        ) : (
          <div class="chiprow">
            <span class="lchip">English</span>
            {activeLangs.map((e) => <span class="lchip">{langChip(langLabels[e.code], e.level)}</span>)}
          </div>
        )}
      </div>

      {linkedContentProvider?.license && (
        <div class="card card--low">
          <p class="eyebrow">Course provider and license</p>
          <h2 class="card-h">Linked DigitalLearn materials</h2>
          <p>
            {linkedContentProvider.attribution}{' '}
            DigitalLearn identifies its course content as{' '}
            <a href={linkedContentProvider.license.url} target="_blank" rel="noopener noreferrer">
              {linkedContentProvider.license.name}
            </a>
            {linkedContentProvider.license.termsUrl && (
              <> in its <a href={linkedContentProvider.license.termsUrl} target="_blank" rel="noopener noreferrer">provider terms</a></>
            )}.
          </p>
          <p class="muted">
            WorkforceAP links to original provider pages; it does not iframe, copy, host, adapt, or imply endorsement of provider videos. Provider-side progress and certificates are not synced or promised.
          </p>
        </div>
      )}

      <!-- Skills -->
      {skills.length > 0 && (
        <div class="block">
          <h2 class="block-h">Skills you’ll learn</h2>
          <div class="chiprow">
            {skills.map((s) => <span class="skill">{s}</span>)}
          </div>
        </div>
      )}

      <!-- Course list -->
      <div class="block">
        <h2 class="block-h">Course list</h2>
        <div class="courses">
          {program.courses.map((c, i) => (
            <details class="course">
              <summary>
                <span class="cnum">{i + 1}.</span>
                <span class="cname">{c.name}</span>
                {(!program.curriculum || curriculumOwnerVerified) && (
                  <span class="chrs">~{c.estimatedHours} hrs</span>
                )}
                <span class="cmark" aria-hidden="true">+</span>
              </summary>
              {(c.description || c.lessons?.length || courseAlignment.get(normalizeCourseName(c.name))?.length) && (
                <div class="cbody">
                  {c.description && <p>{c.description}</p>}
                  {c.lessons?.length && (
                    <p class="calign">
                      <strong>Lessons ({c.provider?.name ?? 'online'}):</strong>{' '}
                      {c.lessons.map((l) => `${l.title} (${l.minutes} min)`).join(' · ')}
                    </p>
                  )}
                  {courseAlignment.get(normalizeCourseName(c.name))?.length && (
                    <p class="calign">
                      <strong>Prepares you for:</strong>{' '}
                      {courseAlignment.get(normalizeCourseName(c.name))!.join(' · ')}
                    </p>
                  )}
                </div>
              )}
            </details>
          ))}
        </div>
      </div>

      <!-- Before you apply -->
      {extra && (
        <div class="card card--low">
          <p class="eyebrow">Before you apply</p>
          <h2 class="card-h">What to expect from this program</h2>
          <div class="quad">
            <div>
              <h3>Preparation</h3>
              <p>{preparationCopy}</p>
            </div>
            <div>
              <h3>Time commitment</h3>
              <p>{program.duration}. {program.courses.length} course{program.courses.length > 1 ? 's' : ''} in the full path.</p>
            </div>
            {rampNote && (
              <div>
                <h3>What you should know first</h3>
                <p>{rampNote}</p>
              </div>
            )}
            <div>
              <h3>Funding</h3>
              <p>{fundingCopy}</p>
              <p>Program costs are covered by grants, scholarships, partnerships, and donations — never billed to qualifying members.</p>
            </div>
          </div>
        </div>
      )}

      <!-- Career outcomes -->
      {extra?.jobOutcomes && extra.jobOutcomes.length > 0 && (
        <div class="card">
          <p class="eyebrow">Career research</p>
          <h2 class="card-h">Explore roles connected to these skills</h2>
          <div class="roles">
            {extra.jobOutcomes.map((role) => (
              <div class="role"><span class="role-ic" aria-hidden="true"><Icon name="briefcase" size={20} /></span><p>{role}</p></div>
            ))}
          </div>
          <p class="roles-note">Job requirements and pay vary by employer, location, and experience. A certificate alone does not guarantee a role or salary. <a href="/salary-guide">Research occupations, wages, and entry requirements</a>, then discuss your next step with an advisor.</p>
        </div>
      )}

      <!-- Bottom CTA -->
      <div class="bottomcta">
        <h3>Ready to start your career in {program.categoryLabel}?</h3>
        <p>Applications take about 5 minutes. No cost for <a href={applyHomeHref}>qualifying members</a>. A counselor reviews every application and you'll hear by email.</p>
        <a class="btn btn--primary btn--lg" href={primaryHref} {...primaryAttrs}>{primaryLabel}</a>
        <div class="cta-links">
          {externalCourseUrl && <a href={applyHref}>Want a WorkforceAP advisor alongside the course? Apply here</a>}
          <a href="/find-your-path">Not sure this is right? Take the pathfinder quiz</a>
          <a href="/program-comparison">Compare programs side-by-side</a>
        </div>
      </div>

      <!-- Related resources -->
      <div class="block resources">
        <h3 class="res-h">Have Questions?</h3>
        <div class="reslinks">
          <a href="/faq"><span><Icon name="book-open" size={16} /></span><span>Read FAQ</span><span class="arr">→</span></a>
          <a href="/how-it-works"><span><Icon name="clock" size={16} /></span><span>How It Works</span><span class="arr">→</span></a>
          <a href="/salary-guide"><span><Icon name="dollar" size={16} /></span><span>Pay and job research</span><span class="arr">→</span></a>
          <a href="/blog"><span><Icon name="briefcase" size={16} /></span><span>Career Tips</span><span class="arr">→</span></a>
        </div>
      </div>
    </div>

    <aside class="sidebar">
      <div class="scard">
        <div class="smeta">
          <span><Icon name="clock" size={16} /> {program.duration}</span>
          <a class="sresearch" href="/salary-guide">Research pay and job requirements</a>
        </div>
        <span class="spartner">{badge}</span>
        <a class="btn btn--primary sapply" href={primaryHref} {...primaryAttrs}>{primaryLabel}</a>
        {externalCourseUrl
          ? <p class="snote">Free, self-paced Microsoft course — opens in a new tab. <a href={applyHref}>Apply</a> if you also want WorkforceAP member support.</p>
          : <p class="snote">No cost to members who qualify through scholarship/grant funded membership.</p>}
        <a class="squiz" href="/find-your-path">Not sure? Take the pathfinder quiz →</a>
        <a class="scompare" href="/program-comparison">Open comparison tool (featured tracks)</a>
      </div>
    </aside>
  </div>
</section>

<!-- ════════════════ CLOSING CTA — crimson band ════════════════ -->
<section class="close">
  <div class="close__media" aria-hidden="true"></div>
  <div class="close__veil" aria-hidden="true"></div>
  <div class="close__inner wrap">
    <span class="pill pill--solid"><span class="pill__star">★</span>Reviewed by a real team — decision by email</span>
    <h2>Ready to start?</h2>
    <p>Apply in minutes. A member advisor reviews every application and follows up by email.</p>
    <div class="acts acts--center">
      <a class="bbtn bbtn--gold" href={primaryHref} {...primaryAttrs}>{primaryLabel} →</a>
      <a class="bbtn bbtn--outline" href="/programs">Browse all programs</a>
    </div>
  </div>
</section>

</div>

<style>
  .pdepth{--glass-line:rgba(255,255,255,.18)}

  /* ---------------- compact crimson DEPTH hero ---------------- */
  .stage{position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:54px 0 60px}
  .stage-inner{position:relative;z-index:2;max-width:880px}
  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:460px;height:460px;top:-160px;right:-110px;background:radial-gradient(circle,rgba(196,154,72,.5),transparent 68%)}
  .aura--2{width:420px;height:420px;bottom:-200px;left:-130px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:overlay;pointer-events:none;
    background-image:var(--wap-hero-photo-url);background-size:cover;background-position:center;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);opacity:.16}

  .crumbs{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:13px;color:rgba(255,255,255,.78);margin-bottom:18px}
  .crumbs a{color:rgba(255,255,255,.88);font-weight:600}
  .crumbs a:hover{color:#fff;text-decoration:underline}
  .crumbs .cur{color:rgba(255,255,255,.85)}

  .cat-pill{display:inline-block;color:#fff;padding:5px 14px;border-radius:999px;font-size:13px;font-weight:700;margin-bottom:14px}
  .stage h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(30px,4.6vw,50px);line-height:1.05;letter-spacing:-.02em;margin:0 0 12px}
  .meta{font-size:18px;color:rgba(255,255,255,.9);margin-bottom:4px}
  .partner{font-size:14px;color:rgba(255,255,255,.72);margin-bottom:18px}
  .fit{background:var(--accent-dark);border:1px solid var(--glass-line);border-radius:16px;padding:18px 20px;margin-bottom:22px;box-shadow:var(--shadow-glass)}
  .fit p{font-size:14.5px;line-height:1.55;color:rgba(255,255,255,.92)}
  .fit p + p{margin-top:8px}
  .fit strong{color:var(--gold-glow)}
  .hero-acts{display:flex;gap:14px;flex-wrap:wrap}
  .dbtn--hero-secondary{background:var(--accent-dark);color:#fff;border-color:rgba(255,255,255,.72);box-shadow:0 12px 30px -10px rgba(58,10,30,.45)}
  .dbtn--hero-secondary:hover{background:var(--crimson)}

  /* ---------------- body bands ---------------- */
  .band{padding:var(--sec-pad) 0}
  .band--surface{background:var(--surface)}

  .pilot{display:inline-block;font-size:13px;font-weight:700;color:var(--gold-dark);background:rgba(164,127,56,.1);border:1px solid rgba(164,127,56,.25);border-radius:999px;padding:8px 16px;margin-top:24px}

  .grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:40px;align-items:start}
  @media(max-width:900px){.grid{grid-template-columns:1fr}}

  .lead{font-size:18px;line-height:1.65;color:var(--text);margin-bottom:28px}

  /* content cards */
  .card{border:1px solid var(--border);border-radius:var(--radius);background:var(--surface-2);padding:26px;margin-bottom:24px}
  .card--low{background:var(--surface)}
  .eyebrow{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--crimson);margin-bottom:6px}
  .card-h{font-family:'Plus Jakarta Sans',sans-serif;font-size:22px;font-weight:800;margin-bottom:18px}

  .trio{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px}
  .trio h3,.quad h3{font-size:15px;font-weight:800;margin-bottom:8px}
  .trio p,.quad p{font-size:14.5px;color:var(--muted);line-height:1.6}
  .prev{margin:0;padding-left:18px;color:var(--muted);font-size:14px;line-height:1.7}
  .prev-more{font-size:13px;color:var(--muted);margin-top:8px}

  .quad{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:20px}
  /* The pending variant holds a single cell and follows a paragraph that has no
     bottom margin, so it needs the same rhythm .cert-h uses. */
  .quad-pending{margin-top:20px}
  .stars{display:flex;gap:4px;margin-bottom:8px}
  .star{color:var(--border);font-size:18px}
  .star.on{color:var(--gold)}

  .block{margin-bottom:28px}
  .block-h{font-family:'Plus Jakarta Sans',sans-serif;font-size:18px;font-weight:800;margin-bottom:12px}
  .muted{color:var(--muted);font-size:14.5px}
  .chiprow{display:flex;flex-wrap:wrap;gap:9px}
  .lchip{background:var(--surface-2);border:1px solid var(--border);color:var(--text);padding:6px 12px;border-radius:8px;font-size:14px}
  .skill{background:rgba(173,44,77,.08);border:1px solid rgba(173,44,77,.18);color:var(--crimson);padding:6px 12px;border-radius:8px;font-size:14px;font-weight:600}

  /* course accordion (pure CSS via <details>) */
  .courses{border:1px solid var(--border);border-radius:14px;overflow:hidden;background:var(--surface)}
  .course{border-bottom:1px solid var(--border)}
  .course:last-child{border-bottom:none}
  .course summary{display:flex;align-items:center;gap:10px;padding:14px 18px;cursor:pointer;font-weight:500;list-style:none}
  .course summary::-webkit-details-marker{display:none}
  .course summary:hover{background:var(--surface-2)}
  .cnum{color:var(--muted);font-weight:700}
  .cname{flex:1}
  .chrs{font-size:13px;color:var(--muted)}
  .cmark{color:var(--muted);font-size:18px;flex-shrink:0;width:16px;text-align:center}
  .course[open] .cmark{transform:rotate(45deg)}
  .cbody{padding:0 18px 16px 40px;font-size:14px;color:var(--muted);line-height:1.6}
  .cbody p+p{margin-top:8px}
  .calign{font-size:13.5px}
  .calign strong{color:var(--text)}
  .cert-h{font-size:15px;font-weight:800;margin:20px 0 10px}

  /* career outcome roles */
