---
import Layout from '../../layouts/Layout.astro';
import { PROGRAMS } from '../../data/programs';
import { verifiedProgramPriceRows } from '../../data/programPriceList';

// ── ETPL / WIOA program price list ──
// TWC (ETPL review) requires published price and contact-hour facts to be
// verifiable. A draft curriculum must never enter this official document:
// owner-pending records stay explicitly withheld until their source facts are
// verified and the record is promoted to `owner-verified`.
const rows = verifiedProgramPriceRows(PROGRAMS);
const ownerPendingPrograms = PROGRAMS
  .filter((p) => !p.syllabus && p.curriculum?.status !== 'owner-verified')
  .map((p) => p.title)
  .sort((a, b) => a.localeCompare(b));

// Hardcoded rather than `new Date()` — this is a content-verified date, not
// a build date. `new Date()` would silently re-date the document on every
// build even when nothing changed. Update this string when program pricing
// or contact hours change (and re-verify the table below against the
// syllabus at the same time).
const CONTENT_VERIFIED = 'August 30, 2026';
const pageTitle = 'Program Price List — Workforce Advancement Project';
const metaDescription =
  'Official Workforce Advancement Project program price list: program names, contact hours, and maximum program cost for workforce boards and funding partners.';
---
<Layout title={pageTitle} description={metaDescription}>
<Fragment slot="head">
  <!-- Internal/funder document: deliberately unlisted. No inbound links on the
       public site; kept out of search indexes. Shared directly with TWC /
       workforce boards (EdVera attachments) by URL or as a printed PDF. -->
  <meta name="robots" content="noindex, nofollow" />
</Fragment>
<div class="plist">
  <section class="head">
    <div class="wrap">
      <nav class="crumbs print-hide" aria-label="Breadcrumb">
        <a href="/">Home</a><span>›</span><a href="/programs">Programs</a><span>›</span><span class="cur">Price list</span>
      </nav>
      <p class="org">Workforce Advancement Project</p>
      <h1>Program Price List</h1>
      <p class="sub">
        207 Settlers Valley Drive Suite C, Pflugerville, TX 78660 · 512-825-2896 ·
        <a href="https://www.workforceap.org">www.workforceap.org</a>
      </p>
      <p class="salutation">To Whom It May Concern (Texas Workforce Commission / Workforce Solutions):</p>
      <p class="note">
        This document is the official program price list of Workforce Advancement Project, a
        501(c)(3) nonprofit (EIN 41-2612389), provided for TWC / Workforce Solutions administrative
        validation of program costs (EdVera Program Details Forms). Training is provided at
        <strong>no cost to qualifying members</strong> — programs are funded through grants,
        scholarships, partnerships, and donations. The maximum program cost below is the amount
        billed to workforce boards and other funding partners (WIOA/ETPL), never to members.
        Only records eligible for publication are included below. A draft curriculum is
        withheld until its hours and tuition are owner-verified.
      </p>
      {ownerPendingPrograms.length > 0 && (
        <p class="withheld">
          <strong>Withheld pending program-owner verification:</strong>{' '}
          {ownerPendingPrograms.join('; ')}. No program-owner-supplied syllabus or owner-verified curriculum is on file
          for these programs. Their hours, delivery format, and tuition and fees are not
          published as official price-list facts.
        </p>
      )}
      <p class="updated">Last updated: {CONTENT_VERIFIED}</p>
      <button class="printbtn print-hide" onclick="window.print()">Print or save as PDF</button>
    </div>
  </section>

  <section class="body">
    <div class="wrap">
      <div class="tablewrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Program</th>
              <th scope="col">Duration</th>
              <th scope="col" class="num">Contact hours</th>
              <th scope="col" class="num">Maximum program cost</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td><a href={`/programs/${r.slug}`}>{r.title}</a></td>
                <td>{r.duration}</td>
                <td class="num">{r.contactHours}</td>
                <td class="num">${r.maximumProgramCost.toLocaleString('en-US')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="sigblock">
        <p>Respectfully,</p>
        <div class="sigline" aria-hidden="true"></div>
        <p class="signame">Michael A. Brown, PMP, ChE</p>
        <p class="sigtitle">Executive Director, Workforce Advancement Project</p>
        <p class="sigtitle">michael.brown@workforceap.org · (512) 825-2896</p>
        <p class="sigdate">Date: ____________________</p>
      </div>
      <p class="foot print-hide">
        Questions about program pricing, bid letters, or ETPL documentation:
        <a href="/contact">contact us</a> or call 512-825-2896.
      </p>
    </div>
  </section>
</div>

<style>
  .plist{background:var(--surface)}
  .head{padding:48px 0 8px}
  .crumbs{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:13px;color:var(--muted);margin-bottom:18px}
  .crumbs a{color:var(--crimson);font-weight:600}
  .org{font-size:13px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--crimson);margin-bottom:6px}
  h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(28px,4vw,42px);letter-spacing:-.02em;margin:0 0 8px}
  .sub{font-size:14px;color:var(--muted);margin-bottom:16px}
  .sub a{color:var(--crimson)}
  .note{font-size:14.5px;line-height:1.6;color:var(--text);max-width:60em;background:var(--surface-2);border:1px solid var(--border);border-radius:12px;padding:14px 18px;margin-bottom:12px}
  .withheld{font-size:14px;line-height:1.6;color:var(--text);max-width:60em;border-left:4px solid var(--crimson);padding:10px 14px;margin:0 0 12px;background:var(--surface-2)}
  .updated{font-size:13px;color:var(--muted);margin-bottom:14px}
  .printbtn{background:var(--crimson);color:#fff;border:none;border-radius:10px;padding:10px 20px;font-size:14px;font-weight:700;cursor:pointer}
  .printbtn:hover{opacity:.92}

  .body{padding:24px 0 64px}
  .tablewrap{overflow-x:auto;border:1px solid var(--border);border-radius:14px;background:var(--surface)}
  table{width:100%;border-collapse:collapse;font-size:14.5px}
  th,td{padding:12px 16px;text-align:left;border-bottom:1px solid var(--border)}
  th{background:var(--surface-2);font-weight:800;font-size:13px;letter-spacing:.04em;text-transform:uppercase;color:var(--muted)}
  tbody tr:last-child td{border-bottom:none}
  td a{color:var(--crimson);font-weight:600}
  .num{text-align:right;white-space:nowrap}
  .foot{margin-top:18px;font-size:13.5px;color:var(--muted)}
  .foot a{color:var(--crimson)}
  .salutation{font-size:14.5px;font-weight:600;margin-bottom:10px}
  .sigblock{margin-top:34px;font-size:14.5px;line-height:1.5}
  .sigline{width:260px;border-bottom:1px solid var(--text);margin:34px 0 6px}
  .signame{font-weight:800;margin:0}
  .sigtitle{margin:0;color:var(--muted);font-size:13.5px}
  .sigdate{margin-top:12px;color:var(--muted);font-size:13.5px}

  @media print{
    .print-hide{display:none !important}
    .head{padding-top:12px}
    .note{border:none;background:none;padding:0}
    .tablewrap{border:none}
    td a{color:inherit;text-decoration:none;font-weight:600}
  }
</style>
</Layout>
