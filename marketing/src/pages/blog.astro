---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getPublishedPosts, getCategories, resolveHeroImage, formatPublishedDate } from '../data/blog';

const posts = getPublishedPosts();
const categories = getCategories();
const hasPosts = posts.length > 0;

// Quick resource nav cards (mirrors the Next BlogListingClient quick-resources).
const quickCards = [
  { href: '/programs', icon: 'graduation-cap', title: hasPosts ? 'Explore Programs' : 'Start with Programs', sub: '20 career training options', cls: 'ic--c' },
  { href: '/faq', icon: 'help-circle', title: hasPosts ? 'Read FAQ' : 'Get Answers Fast', sub: 'Common questions answered', cls: 'ic--g' },
];

const cards = posts.map((p) => ({ ...p, hero: resolveHeroImage(p), date: formatPublishedDate(p.publishedAt) }));
---
<Layout
  title="Workforce Development Blog | Career Tips & Training News"
  description="Career tips, program spotlights, success stories, and workforce insights from Workforce Advancement Project. Career training advice, job-readiness guidance, and workforce insights for individuals nationwide."
>
<div class="blogmix">

  <!-- ============================================================
       HERO — DEPTH STAGE (shorter): deep radial crimson→plum band,
       gold/crimson/white glow auras, luminosity-masked photo,
       gold pill, white title + intro, glass status card.
       ============================================================ -->
  <section class="stage">
    <div class="aura aura--1"></div>
    <div class="aura aura--2"></div>
    <div class="aura aura--3"></div>
    <div class="grain"></div>

    <div class="wrap stage-grid">
      <div class="lede">
        <span class="pill"><span class="pill__star"><Icon name="star" size={12} /></span>Career Resources · WorkforceAP</span>
        <h1>Career <span class="shimmer">Resources</span></h1>
        <p class="sub">Career tips, program spotlights, success stories, and workforce insights — plus programs, FAQ, and application help when you're ready.</p>
      </div>

      <!-- glass status card -->
      <div class="hcard">
        <div class="hcard-row">
          <span class="hcard-ic" aria-hidden="true"><Icon name="newspaper" size={28} /></span>
          <span class="dot-live">Latest articles</span>
        </div>
        <div class="hcard-big">{posts.length} articles published</div>
        <p class="hcard-p">Read the latest, then browse programs or start your application.</p>
        <div class="hcard-chips">
          <span>Career tips</span>
          <span>Program spotlights</span>
          <span>Workforce insights</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== BODY — light band with glass/elevated cards ===== -->
  <section class="blk blk--cream">
    <div class="wrap" style="max-width:1100px">
      <!-- Quick resource nav cards -->
      <div class="blog-quick">
        {quickCards.map((c) => (
          <a class="qcard" href={c.href}>
            <span class={`ic ${c.cls}`} aria-hidden="true"><Icon name={c.icon} /></span>
            <span class="qtext">
              <span class="qt">{c.title}</span>
              <span class="qs">{c.sub}</span>
            </span>
            <span class="qarr" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      {categories.length > 0 && (
        <div class="cats" role="group" aria-label="Filter posts by category">
          <button type="button" class="cat-chip is-active" data-cat="all" aria-pressed="true">All</button>
          {categories.map((cat) => <button type="button" class="cat-chip" data-cat={cat} aria-pressed="false">{cat}</button>)}
        </div>
      )}

      <!-- Post grid -->
      <div class="post-grid">
        {cards.map((p) => (
          <article class="post-card" data-cat={p.category ?? ''}>
            <a class="post-link" href={`/blog/${p.slug}`}>
              <div class="post-cover">
                <img src={p.hero.src} alt={p.hero.alt} width="1600" height="900" loading="lazy" />
                {p.category && <span class="post-cat">{p.category}</span>}
              </div>
              <h2 class="post-title">{p.title}</h2>
              <p class="post-excerpt">{p.excerpt}</p>
              <div class="post-meta">{p.authorName} · {p.date}</div>
              <span class="post-cta" aria-hidden="true">Read more: {p.title} →</span>
            </a>
          </article>
        ))}
      </div>

      <!-- Updates via contact -->
      <div class="updates-card">
        <span class="updates-ic" aria-hidden="true"><Icon name="mail" size={28} /></span>
        <h2>Want updates?</h2>
        <p>
          Ask to be notified about new articles and program news — our team responds
          within a few business days.
        </p>
        <a class="btn btn--primary" href="/contact">Contact us for updates</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CLOSING CTA — BOLD full-bleed crimson, photo luminosity.
       ============================================================ -->
  <section class="close">
    <div class="close__media" aria-hidden="true"></div>
    <div class="close__veil" aria-hidden="true"></div>
    <div class="close__inner wrap">
      <h2>Ready to take the next step?</h2>
      <p>
        WorkforceAP offers no-cost career training paths for <a href="/apply" class="cta-link">qualifying members</a> — with guided tools, advisor support, and employer-aligned credentials.
      </p>
      <div class="acts acts--center">
        <a class="bbtn bbtn--gold" href="/find-your-path">Find Your Path</a>
        <a class="bbtn bbtn--outline" href="/programs">Explore Programs</a>
        <a class="bbtn bbtn--outline" href="/apply">Apply Now</a>
      </div>
    </div>
  </section>

</div>

<style>
  /* ===================================================================
     BLOGMIX — DEPTH-LED to match the home.
     shorter depth stage hero → light body with glass + post cards →
     bold full-bleed crimson closing CTA.
     =================================================================== */
  .blogmix{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}

  /* ---------------- DEPTH HERO STAGE (shorter) ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:80px 0 88px;
  }
  .stage-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;position:relative;z-index:2}

  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:520px;height:520px;top:-160px;right:-120px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:460px;height:460px;bottom:-200px;left:-140px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:360px;height:360px;top:24%;left:44%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%)}

  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:overlay;pointer-events:none;
    background-image:var(--wap-hero-photo-url);background-size:cover;background-position:center;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);opacity:.18}

  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:linear-gradient(135deg,#e3bd6a,#a47f38);color:#3a2c10;font-weight:800;font-size:13px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{font-size:13px;opacity:.95}
  @media(max-width:430px){.pill{white-space:normal;text-align:left}}

  .lede h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(40px,5.5vw,64px);
    line-height:1.03;letter-spacing:-.03em;margin:20px 0 0}
  .shimmer{background:linear-gradient(100deg,#fff 10%,#f3d28f 50%,#fff 90%);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .lede .sub{font-size:19px;line-height:1.55;color:rgba(255,255,255,.82);max-width:32em;margin:20px 0 0}

  .hcard{position:relative;border-radius:22px;padding:28px;
    background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(18px);
    box-shadow:var(--shadow-glass);color:#fff}
  .hcard-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
  .hcard-ic{display:inline-flex}
  .dot-live{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:#fff;
    background:rgba(74,155,79,.32);border:1px solid rgba(120,220,130,.4);padding:4px 10px;border-radius:999px}
  .dot-live::before{content:"";width:7px;height:7px;border-radius:50%;background:#7fe389;box-shadow:0 0 8px #7fe389}
  .hcard-big{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:24px;margin-bottom:8px}
  .hcard-p{font-size:15px;line-height:1.55;color:rgba(255,255,255,.8);margin-bottom:18px}
  .hcard-chips{display:flex;flex-wrap:wrap;gap:8px}
  .hcard-chips span{font-size:13px;font-weight:700;padding:6px 12px;border-radius:999px;
    background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18)}

  /* ---------------- LIGHT BODY BLOCK ---------------- */
  .blk{width:100%;padding:var(--sec-pad) 0}
  .blk--cream{background:var(--bg);color:var(--text)}

  /* quick nav cards (elevated) */
  .blog-quick{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:30px}
  .qcard{
    display:flex;align-items:center;gap:16px;
    background:var(--surface);border:1px solid var(--border);
    border-radius:var(--radius);padding:22px 24px;box-shadow:var(--shadow);
    border-top:5px solid var(--crimson);
    transition:transform .18s,box-shadow .2s,border-color .2s;
  }
  .qcard:nth-child(2){border-top-color:var(--gold)}
  .qcard:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:rgba(173,44,77,.3)}
  .qcard .ic{width:50px;height:50px;border-radius:13px;display:grid;place-items:center;flex-shrink:0}
  .qcard .ic--c{background:rgba(173,44,77,.12)}
  .qcard .ic--g{background:rgba(164,127,56,.14)}
  .qtext{flex:1;display:flex;flex-direction:column;gap:3px}
  .qt{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:18px}
  .qs{color:var(--muted);font-size:14px}
  .qarr{color:var(--crimson);font-size:22px;font-weight:700;flex-shrink:0}

  /* category chips */
  .cats{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px}
  .cat-chip{font-size:13px;font-weight:700;padding:7px 14px;border-radius:999px;
    background:rgba(173,44,77,.08);border:1px solid rgba(173,44,77,.18);color:var(--crimson)}
  .cat-chip{cursor:pointer;background:none;font:inherit}
  .cat-chip.is-active{background:var(--crimson);color:#fff;border-color:var(--crimson)}

  /* post grid */
  .post-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:24px;margin-bottom:40px}
  .post-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
    box-shadow:var(--shadow);overflow:hidden;transition:transform .18s,box-shadow .2s,border-color .2s}
  .post-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:rgba(173,44,77,.3)}
  .post-link{display:flex;flex-direction:column;height:100%}
  .post-cover{position:relative;aspect-ratio:16/9;overflow:hidden;background:var(--surface-2)}
  .post-cover img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
  @media (prefers-reduced-motion: no-preference){.post-card:hover .post-cover img{transform:scale(1.05)}}
  .post-cat{position:absolute;left:12px;top:12px;font-size:13px;font-weight:800;letter-spacing:.02em;
    padding:5px 11px;border-radius:999px;background:rgba(26,20,20,.72);color:#fff;backdrop-filter:blur(6px)}
  .post-title{font-family:'Plus Jakarta Sans',sans-serif;font-size:18px;font-weight:800;line-height:1.25;
    margin:18px 20px 0;color:var(--text)}
  .post-excerpt{color:var(--muted);font-size:14.5px;line-height:1.55;margin:10px 20px 0;flex:1}
  .post-meta{color:var(--muted);font-size:13px;font-weight:600;margin:16px 20px 0}
  .post-cta{display:inline-block;margin:12px 20px 22px;color:var(--crimson);font-weight:700;font-size:14px}

  /* updates card (elevated) */
  .updates-card{
    text-align:center;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
    padding:40px 28px;box-shadow:var(--shadow);border-top:5px solid var(--gold);
  }
  .updates-ic{width:60px;height:60px;border-radius:16px;margin:0 auto 16px;
    background:rgba(164,127,56,.14);color:var(--gold-dark);display:grid;place-items:center}
  .updates-card h2{font-family:'Plus Jakarta Sans',sans-serif;font-size:26px;font-weight:800;margin-bottom:10px}
  .updates-card p{color:var(--muted);font-size:16px;max-width:36em;margin:0 auto 22px}

  /* ---------------- BOLD FULL-BLEED CLOSING CTA ---------------- */
  .close{position:relative;overflow:hidden;width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw}
  .close__media{position:absolute;inset:0;background:var(--wap-hero-photo-url-3) center 40%/cover no-repeat}
  .close__veil{position:absolute;inset:0;
    background:var(--wap-hero-close-veil)}
  .close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:88px 24px 96px;max-width:var(--max)}
  .close__inner h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(34px,5.5vw,60px);line-height:.98;letter-spacing:-.03em;margin-bottom:18px}
  .close__inner p{font-size:clamp(17px,2.2vw,21px);color:rgba(255,255,255,.92);max-width:40em;margin:0 auto 30px;line-height:1.5}
  .cta-link{color:inherit;text-decoration:underline;text-decoration-style:dotted;text-underline-offset:3px}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}

  /* ---------------- RESPONSIVE ---------------- */
  @media(max-width:880px){
    .stage{padding:64px 0 72px}
    .stage-grid{grid-template-columns:1fr;gap:44px}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
  }
  @media(max-width:760px){
    .blog-quick{grid-template-columns:1fr}
  }
  @media(max-width:560px){
    .acts .bbtn{width:100%;justify-content:center}
  }
</style>
<script is:inline>
  // Progressive enhancement: blog category chips filter the post grid.
  // Without JS the chips are inert and all posts stay visible.
  (function () {
    var chips = Array.prototype.slice.call(document.querySelectorAll('.cats .cat-chip'));
    var posts = Array.prototype.slice.call(document.querySelectorAll('.post-grid .post-card'));
    if (!chips.length || !posts.length) return;
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var cat = chip.getAttribute('data-cat');
        chips.forEach(function (c) {
          var active = c === chip;
          c.classList.toggle('is-active', active);
          c.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        posts.forEach(function (p) {
          p.style.display = cat === 'all' || p.getAttribute('data-cat') === cat ? '' : 'none';
        });
      });
    });
  })();
</script>
</Layout>
