---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

// Real copy mined from messages/en.json → marketing.partners (truth-locked).
const partnerLanes = [
  'State-of-the-art workforce readiness resources',
  'Educational resources and support partnership',
  "Refer members and track your clients' progress",
  'See the difference a workforce system makes',
  'Social service organizations',
];

const partnerSignupHref = '/partners#partner-signup';
const partnerLoginHref = '/login?redirectTo=/partner';
const partnershipContactHref = '/contact?topic=partnership';
const employersHref = '/employers';

const orgTypes = [
  'Select…',
  'Nonprofit',
  'Church / faith organization',
  'Community center',
  'Workforce board',
  'School / college',
  'Veterans organization',
  'Other',
];
const monthly = ['Select…', '1–5', '6–15', '16–30', '30+'];

// Captcha config resolved at BUILD time (Astro pages cannot read
// NEXT_PUBLIC_* at runtime; the Vercel buildCommand runs this build in the
// same env as the Next app). If NEXT_PUBLIC_CAPTCHA_ENABLED=true in
// production, /api/partner/signup rejects tokenless submissions —
// captcha-enabled deployments MUST expose PUBLIC_TURNSTILE_SITE_KEY (or
// NEXT_PUBLIC_TURNSTILE_SITE_KEY) to the marketing build so the widget renders.
const CAPTCHA_ENABLED =
  (import.meta.env.PUBLIC_CAPTCHA_ENABLED ?? process.env.NEXT_PUBLIC_CAPTCHA_ENABLED) === 'true';
const TURNSTILE_SITE_KEY = (
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ??
  process.env.NEXT_PUBLIC_TURNSTILE_SITE_KEY ??
  ''
).trim();
const SHOW_TURNSTILE = CAPTCHA_ENABLED && TURNSTILE_SITE_KEY.length > 0;
---
<Layout
  title="Community & Employer Partners"
  description="Partner with WorkforceAP: employers hire talent, referral orgs send candidates, workforce boards align, funders support scale. Clear next steps for each."
>
<div class="pdepth">

  <!-- ============================================================
       HERO — DEPTH STAGE (shorter): deep radial crimson→plum band,
       gold/crimson/white glow auras, luminosity-masked photo,
       gold pill, white text + translucent glass card.
       ============================================================ -->
  <header class="stage">
    <div class="aura aura--1"></div>
    <div class="aura aura--2"></div>
    <div class="aura aura--3"></div>
    <div class="grain"></div>

    <div class="wrap stage-grid">
      <div class="lede">
        <span class="pill"><span class="pill__star"><Icon name="star" size={11} /></span>A Legacy of Opportunity</span>
        <h1>Build Your Community's <span class="shimmer">Future</span></h1>
        <p class="sub">Community partners refer the people we serve. Training centers, public agencies, and funders each have a clear path too.</p>
        <div class="acts">
          <a class="dbtn dbtn--solid" href={partnerSignupHref}>Become a partner <span>→</span></a>
          <a class="dbtn dbtn--glass" href={partnerLoginHref}>See partner portal</a>
        </div>
      </div>

      <!-- translucent glass card -->
      <div class="hero-card">
        <div class="hc-row">
          <small>Partner portal</small>
          <span class="dot-live">Live</span>
        </div>
        <div class="hc-big">Sign up. Refer. Track. Report.</div>
        <div class="hc-track">
          <i class="t-done"></i><i class="t-done"></i><i class="t-now"></i><i></i>
        </div>
        <div class="hc-labels"><span>Sign up</span><span>Refer</span><span>Track</span><span>Report</span></div>
        <div class="hc-meter">
          <span>Cost to refer</span>
          <strong>$0</strong>
        </div>
        <div class="hc-chips">
          <span>Real-time tracking</span>
          <span>Zero referral fees</span>
          <span>1–2 day setup</span>
        </div>
      </div>
    </div>
  </header>

  <!-- PARTNERSHIP LANES -->
  <div class="creds"><div class="wrap" style="display:block">
    <div class="row" style="display:flex">
      <div class="lab">Built for the partnership lanes we serve</div>
      {partnerLanes.map((lane) => <span class="lane">{lane}</span>)}
    </div>
  </div></div>

  <!-- HOW PARTNERSHIPS START -->
  <section class="band band--cream"><div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">How partnerships start</span>
      <h2>How <span class="grad-text">partnerships</span> start</h2>
      <p>Three steps. Start referring as soon as your portal is live; we'll confirm by email.</p>
    </div>
    <div class="steps" style="grid-template-columns:repeat(3,1fr)">
      <div class="stepcard"><div class="num">1</div><h3>Email or sign up</h3><p>Fill the signup form below or email partners@workforceap.org with a quick note about your org.</p></div>
      <div class="stepcard"><div class="num">2</div><h3>Get portal access</h3><p>We review your request, provision your partner portal, and email you your unique referral link.</p></div>
      <div class="stepcard"><div class="num">3</div><h3>Start referring</h3><p>Send referrals via the portal, your link, or a CSV upload. Watch milestones land in real time.</p></div>
    </div>
  </div></section>

  <!-- WHY PARTNERS PICK WORKFORCEAP -->
  <section class="band band--surface"><div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Why partners pick WorkforceAP</span>
      <h2>Why partners pick <span class="grad-text">WorkforceAP</span></h2>
      <p>Built for the people who refer, fund, and follow up on outcomes.</p>
    </div>
    <div class="vgrid">
      <div class="vcard"><div class="ic ic--c"><Icon name="trending-up" /></div><div><h3>Real-time 1:1 tracking</h3><p>See every referral move from intake to placement. No more emailing for status updates — your dashboard always knows.</p></div></div>
      <div class="vcard"><div class="ic ic--g"><Icon name="file-text" /></div><div><h3>Outcome reporting for funders</h3><p>Export enrollment, completion, and placement data in funder-ready formats. WIOA-aligned where applicable.</p></div></div>
      <div class="vcard"><div class="ic ic--b"><Icon name="lock" /></div><div><h3>FERPA-conscious privacy</h3><p>Member consent gates every data exchange. You see what you need; nothing you do not.</p></div></div>
      <div class="vcard"><div class="ic ic--gr"><Icon name="dollar" /></div><div><h3>Zero referral fees</h3><p>We never charge to refer. Funding flows to partners after verified placement — never from member fees.</p></div></div>
    </div>
  </div></section>

  <!-- WALKTHROUGH CTA -->
  <section class="band band--cream"><div class="wrap" style="max-width:760px">
    <div class="demo-cta">
      <div class="demo-ic"><Icon name="rocket" /></div>
      <div class="demo-body">
        <span class="eyebrow">Want a walkthrough?</span>
        <h2>Request a partner portal walkthrough</h2>
        <p>We will walk you through the referral flow, milestone notifications, and the reports funders ask for.</p>
      </div>
      <a class="btn btn--primary" href={partnershipContactHref}>Request a walkthrough →</a>
    </div>
  </div></section>

  <!-- PARTNERSHIP PATHWAYS -->
  <section id="partner-types" class="band band--surface"><div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Partnership Pathways</span>
      <h2>Partnership <span class="grad-text">Pathways</span></h2>
    </div>
    <div class="pgrid">
      <div class="pcard">
        <div class="ic ic--c"><Icon name="users" /></div>
        <span class="typetag">You are:</span>
        <h3>Referral Partners</h3>
        <div class="who">Nonprofits, social services, churches, reentry programs, community centers, workforce centers, federal one-stop centers.</div>
        <p class="why">Refer clients who need career training. We follow up on every referral by email. There is no cost to refer. You get updates when referred individuals complete programs.</p>
        <a class="go" href={partnerSignupHref}>Register your organization →</a>
      </div>
      <div class="pcard">
        <div class="ic ic--b"><Icon name="graduation-cap" /></div>
        <span class="typetag">You are:</span>
        <h3>Training Centers</h3>
        <div class="who">Educational institutions, community colleges, vocational schools, digital literacy centers.</div>
        <p class="why">Co-deliver employer-recognized certification programs. We bring the employer pipeline; you bring the learning environment.</p>
        <a class="go" href={partnershipContactHref}>Explore Co-Delivery →</a>
      </div>
      <div class="pcard">
        <div class="ic ic--gr"><Icon name="building" /></div>
        <span class="typetag">You are:</span>
        <h3>Public Agencies</h3>
        <div class="who">Workforce Solutions, TWC, WIOA providers, government workforce programs.</div>
        <p class="why">Align your participants with employer-recognized in-demand certifications. We handle training and placement; you strengthen outcomes for your population.</p>
        <a class="go" href={partnershipContactHref}>Discuss Alignment →</a>
      </div>
      <div class="pcard">
        <div class="ic ic--g"><Icon name="heart" /></div>
        <span class="typetag">You are:</span>
        <h3>Philanthropic Funders</h3>
        <div class="who">Foundations, corporate giving, impact investors, individual donors.</div>
        <p class="why">Fund a model that works. Employer-aligned training, no debt for qualifying members, measurable job outcomes. We're growing nationwide and building toward national scale.</p>
        <a class="go" href={partnershipContactHref}>Learn How to Support →</a>
      </div>
    </div>
  </div></section>

  <!-- REFERRAL PARTNER SIGNUP -->
  <section id="partner-signup" class="band band--cream" style="scroll-margin-top:5rem"><div class="wrap">
    <div class="signup">
      <div class="signup-intro">
        <span class="eyebrow">Referral partners</span>
        <h2 style="margin-top:12px">Register your organization</h2>
        <p class="signup-sub">Refer members and track outcomes from intake to placement. Submit the form — we review it and email you when your partner portal is ready.</p>
        <p class="signup-alt">Already registered? <a href={partnerLoginHref}>Partner sign in</a></p>
        <p class="signup-alt">Training centers, public agencies, and funders: <a href={partnershipContactHref}>contact us for the right path</a></p>
      </div>

      <!-- Partner signup form — wired to POST /api/partner/signup (same contract as components/partner/PartnerSignupForm.tsx) -->
      <form class="signup-form" id="partner-signup-form" method="post" novalidate>
        <div class="fg">
          <label for="ps-org">Organization name *</label>
          <input id="ps-org" name="organization_name" required />
        </div>
        <div class="fg">
          <label for="ps-contact">Contact name *</label>
          <input id="ps-contact" name="contact_name" required />
        </div>
        <div class="fg">
          <label for="ps-email">Contact email *</label>
          <input id="ps-email" name="contact_email" type="email" required />
        </div>
        <div class="fg">
          <label for="ps-phone">Contact phone</label>
          <input id="ps-phone" name="contact_phone" type="tel" />
        </div>
        <div class="fg">
          <label for="ps-type">Organization type *</label>
          <select id="ps-type" name="org_type" required>
            {orgTypes.map((o, i) => i === 0 ? <option value="" disabled selected>{o}</option> : <option>{o}</option>)}
          </select>
        </div>
        <div class="fg">
          <label for="ps-area">City / county you serve *</label>
          <input id="ps-area" name="serve_area" required />
        </div>
        <div class="fg">
          <label for="ps-monthly">Estimated monthly referrals *</label>
          <select id="ps-monthly" name="expected_monthly" required>
            {monthly.map((o, i) => i === 0 ? <option value="" disabled selected>{o}</option> : <option>{o}</option>)}
          </select>
        </div>
        <div class="fg">
          <label for="ps-hear">How did you hear about WorkforceAP?</label>
          <textarea id="ps-hear" name="hear_about" rows="3"></textarea>
        </div>
        <div class="fg">
          <label for="ps-password">Create password *</label>
          <input id="ps-password" name="password" type="password" required />
          <small class="hint">Must be at least 8 characters</small>
        </div>
        <div class="fg">
          <label for="ps-confirm">Confirm password *</label>
          <input id="ps-confirm" name="confirm_password" type="password" required />
        </div>
        {SHOW_TURNSTILE && (
          <div class="fg">
            <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light"></div>
          </div>
        )}
        <p class="form-status form-status--err" id="partner-signup-error" role="alert" hidden></p>
        <button type="submit" class="btn btn--primary" style="width:100%;justify-content:center">Create partner account</button>
        <p class="fineprint">By signing up, you agree to our Terms of Service and Privacy Policy.</p>
      </form>
      <p class="form-status form-status--ok" id="partner-signup-success" role="status" hidden></p>
    </div>
  </div></section>

  {SHOW_TURNSTILE && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script is:inline>
    // Partner signup → POST /api/partner/signup (progressive enhancement;
    // Astro pages and the Next.js API share the same production origin). The
    // payload matches the route's zod schema (camelCase keys); on success we
    // redirect to /partners/thank-you. Captcha: when
    // NEXT_PUBLIC_CAPTCHA_ENABLED is true the Turnstile widget renders at
    // build time (see frontmatter) and its token is sent as turnstileToken;
    // captcha-enabled deployments must set PUBLIC_TURNSTILE_SITE_KEY /
    // NEXT_PUBLIC_TURNSTILE_SITE_KEY in the marketing build env or the API
    // rejects submissions (400).
    (function () {
      var form = document.getElementById('partner-signup-form');
      if (!form || !window.fetch) return;
      var button = form.querySelector('button[type=submit]');
      var errEl = document.getElementById('partner-signup-error');
      var okEl = document.getElementById('partner-signup-success');
      var idleLabel = button ? button.textContent : '';

      function showError(msg) {
        if (!errEl) return;
        errEl.textContent = msg;
        errEl.hidden = false;
      }

      function setPending(pending) {
        if (!button) return;
        button.disabled = pending;
        button.textContent = pending ? 'Creating your account…' : idleLabel;
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (errEl) errEl.hidden = true;
        if (!form.reportValidity()) return;

        var fd = new FormData(form);
        var password = String(fd.get('password') || '');
        var confirmPassword = String(fd.get('confirm_password') || '');

        var payload = {
          organizationName: String(fd.get('organization_name') || '').trim(),
          contactName: String(fd.get('contact_name') || '').trim(),
          contactEmail: String(fd.get('contact_email') || '').trim().toLowerCase(),
          contactPhone: String(fd.get('contact_phone') || '').trim() || null,
          orgType: String(fd.get('org_type') || '').trim(),
          serveArea: String(fd.get('serve_area') || '').trim(),
          expectedMonthly: String(fd.get('expected_monthly') || '').trim(),
          hearAbout: String(fd.get('hear_about') || '').trim() || null,
          password: password,
        };

        if (!payload.organizationName || !payload.contactName || !payload.contactEmail ||
            !payload.orgType || !payload.serveArea || !payload.expectedMonthly) {
          showError('Please fill in all required fields.');
          return;
        }
        if (password.length < 8) {
          showError('Password must be at least 8 characters.');
          return;
        }
        if (password !== confirmPassword) {
          showError('Passwords do not match.');
          return;
        }
        // Turnstile injects a hidden input named cf-turnstile-response when
        // the widget is present; this route expects it as turnstileToken.
        var token = String(fd.get('cf-turnstile-response') || '').trim();
        if (token) payload.turnstileToken = token;

        setPending(true);
        fetch('/api/partner/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        })
          .then(function (res) {
            return res.json().catch(function () { return {}; }).then(function (data) {
              if (!res.ok) {
                throw new Error(typeof data.error === 'string' ? data.error : 'Something went wrong. Please try again.');
              }
              if (okEl) {
                okEl.textContent = 'Your partner account has been created — redirecting…';
                okEl.hidden = false;
              }
              window.location.assign('/partners/thank-you');
            });
          })
          .catch(function (err) {
            setPending(false);
            if (window.turnstile && typeof window.turnstile.reset === 'function') {
              try { window.turnstile.reset(); } catch (_) { /* ignore */ }
            }
            showError(err && err.message ? err.message : 'Network error. Please try again.');
          });
      });
    })();
  </script>

  <!-- DIGITAL INTEGRATION, HUMAN IMPACT -->
  <section class="band band--surface"><div class="wrap">
    <div class="split">
      <div>
        <div class="sec-head" style="text-align:left;margin:0 0 24px">
          <span class="eyebrow">Digital Integration,</span>
          <h2 style="margin-top:14px">Digital Integration, <span class="grad-text">Human Impact</span></h2>
        </div>
        <div class="feat-rows">
          <div class="feat-row">
            <span class="ic ic--c"><Icon name="pencil" /></span>
            <div><h3>Smart Intake</h3><p>Structured enrollment and eligibility screening reduces onboarding time by 60%, letting counselors focus on high-touch support.</p></div>
          </div>
          <div class="feat-row">
            <span class="ic ic--b"><Icon name="bar-chart" /></span>
            <div><h3>Real-Time Dashboards</h3><p>Partners access live data on referral status, enrollment progress, certification completions, and placement outcomes.</p></div>
          </div>
          <div class="feat-row">
            <span class="ic ic--gr"><Icon name="check-circle" /></span>
            <div><h3>Verification &amp; Reporting</h3><p>Automated credential verification and WIOA-compliant reporting ensures accountability across every partnership.</p></div>
          </div>
        </div>
      </div>
      <figure class="split-fig" aria-hidden="true"></figure>
    </div>
  </div></section>

  <!-- PARTNER FAQ -->
  <section class="band band--cream"><div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Partner FAQ</span>
      <h2>Partner <span class="grad-text">FAQ</span></h2>
    </div>
    <div class="faq">
      <details>
        <summary>Can we co-brand the referral experience?<span class="pl">+</span></summary>
        <p>Yes. Strategic partners get a co-branded landing page and referral link. Your logo, your colors, your voice — pointing at our intake.</p>
      </details>
      <details>
        <summary>Do you share member contact info?<span class="pl">+</span></summary>
        <p>Only with explicit member consent, and only the fields you need for follow-up. Members can revoke at any time, and you will see consent state on every record.</p>
      </details>
      <details>
        <summary>What notifications do we get?<span class="pl">+</span></summary>
        <p>Email + in-portal alerts on every milestone: application started, enrolled, certification earned, placed. You choose digest cadence in your partner settings.</p>
      </details>
      <details>
        <summary>Can we bulk-import referrals?<span class="pl">+</span></summary>
        <p>Yes — CSV upload with column mapping. We validate rows, deduplicate against existing members, and surface errors row-by-row before commit.</p>
      </details>
      <details>
        <summary>Is there a fee to be a partner?<span class="pl">+</span></summary>
        <p>No. We do not charge partners to refer. Member services are funded by grants and partnerships, so there is no cost to the members who qualify through scholarship/grant funded membership.</p>
      </details>
      <details>
        <summary>How do reports work?<span class="pl">+</span></summary>
        <p>Pull placement, completion, and demographic reports straight from your partner dashboard. Schedule monthly exports to your inbox or your funder's data warehouse.</p>
      </details>
    </div>
  </div></section>

  <!-- ============================================================
       CLOSING CTA — DEPTH crimson stage with photo luminosity.
       ============================================================ -->
  <section class="close">
    <div class="close__media" aria-hidden="true"></div>
    <div class="close__veil" aria-hidden="true"></div>
    <div class="close__inner wrap">
      <h2>Start a Partnership</h2>
      <p>Clear next steps, real outcomes, and a team that follows up on every referral.</p>
      <div class="acts acts--center">
        <a class="bbtn bbtn--gold" href={partnerSignupHref}>Register as a referral partner →</a>
        <a class="bbtn bbtn--outline" href={employersHref}>I am hiring (employers)</a>
      </div>
    </div>
  </section>

</div>

<style>
  /* ===================================================================
     PARTNERS — DEPTH-LED restyle to match the new home.
     short depth stage hero + glass card → light alternating bands
     with bold blocks/cards → depth crimson closing CTA.
     =================================================================== */
  .pdepth{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18);overflow-x:clip}

  /* ---------------- DEPTH HERO STAGE (shorter) ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:84px 0 96px;
  }
  .stage-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;position:relative;z-index:2}

  /* glow auras — gold + crimson + white */
  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:520px;height:520px;top:-160px;right:-120px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:460px;height:460px;bottom:-200px;left:-140px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:380px;height:380px;top:30%;left:42%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%)}

  /* luminosity-masked real photo bleeding in from the right */
  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:soft-light;pointer-events:none;
    background-image:var(--wap-hero-photo-url);background-size:cover;background-position:center 35%;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,rgba(0,0,0,.35) 28%,#000 72%);
    mask-image:linear-gradient(90deg,transparent 0%,rgba(0,0,0,.35) 28%,#000 72%);opacity:.42}

  /* gold PILL — fully visible, never clipped */
  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:var(--grad-gold);color:var(--gold-ink);font-weight:800;font-size:13px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{font-size:13px;opacity:.95}
  @media(max-width:430px){.pill{white-space:normal;text-align:left}}

  .lede h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(40px,5.4vw,66px);
    line-height:1.04;letter-spacing:-.03em;margin:20px 0 0}
  .shimmer{background:var(--grad-gold-shimmer);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .lede .sub{font-size:20px;line-height:1.55;color:rgba(255,255,255,.82);max-width:32em;margin:22px 0 30px}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}

  /* ---------------- TRANSLUCENT GLASS HERO CARD ---------------- */
  .hero-card{position:relative;border-radius:22px;padding:26px;
    background:rgba(255,255,255,.13);border:1px solid var(--glass-line);backdrop-filter:blur(18px);
    box-shadow:var(--shadow-glass);color:#fff}
  .hc-row{display:flex;align-items:center;justify-content:space-between}
  .hc-row small{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.72);font-weight:700}
  .dot-live{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:#fff;
    background:rgba(74,155,79,.32);border:1px solid rgba(120,220,130,.4);padding:4px 10px;border-radius:999px}
  .dot-live::before{content:"";width:7px;height:7px;border-radius:50%;background:#7fe389;box-shadow:0 0 8px #7fe389}
  .hc-big{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:24px;margin:10px 0 18px}
  .hc-track{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
  .hc-track i{height:8px;border-radius:5px;background:rgba(255,255,255,.2)}
  .hc-track i.t-done{background:linear-gradient(90deg,var(--gold-lift),#fff)}
  .hc-track i.t-now{background:#fff;box-shadow:0 0 12px rgba(255,255,255,.8)}
  .hc-labels{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:9px 0 20px}
  .hc-labels span{font-size:13px;color:rgba(255,255,255,.7);text-align:center}
  .hc-meter{display:flex;align-items:baseline;justify-content:space-between;padding:14px 16px;border-radius:13px;
    background:rgba(0,0,0,.18);border:1px solid rgba(255,255,255,.12);margin-bottom:14px}
  .hc-meter span{font-size:13px;color:rgba(255,255,255,.8)}
  .hc-meter strong{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:26px;color:var(--gold-glow)}
  .hc-chips{display:flex;flex-wrap:wrap;gap:8px}
  .hc-chips span{font-size:13px;font-weight:700;padding:6px 12px;border-radius:999px;
    background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18)}

  @media (prefers-reduced-motion: no-preference){
    .hero-card{animation:pdepth-float 8s ease-in-out infinite}
    @keyframes pdepth-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
  }

  /* ---------------- PARTNERSHIP LANES (creds band) ---------------- */
  .creds{background:var(--surface);border-top:3px solid var(--gold);border-bottom:1px solid var(--border);padding:30px 0}
  .creds .row{align-items:center;justify-content:center;gap:clamp(20px,4vw,44px);flex-wrap:wrap}
  .creds .lab{color:var(--muted);font-size:13px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;max-width:14em}
  .creds .lane{font-size:14px;font-weight:600;color:#4a4440;opacity:.85;max-width:14em;text-align:center;line-height:1.4}

  /* ---------------- ALTERNATING LIGHT BANDS ---------------- */
  .band{padding:var(--sec-pad) 0}
  .band--cream{background:var(--bg);color:var(--text)}
  .band--surface{background:var(--surface);color:var(--text)}

  .sec-head{text-align:center;max-width:680px;margin:0 auto 52px}
  .sec-head h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(32px,4.6vw,54px);line-height:1.04;letter-spacing:-.025em;margin:14px 0 12px}
  .sec-head p{color:var(--muted);font-size:18px;line-height:1.55}

  /* steps */
  .steps{display:grid;gap:22px}
  .stepcard{position:relative;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:30px;box-shadow:var(--shadow);border-top:5px solid var(--crimson);transition:transform .2s,box-shadow .25s}
  .stepcard:nth-child(2){border-top-color:var(--blue)}
  .stepcard:nth-child(3){border-top-color:var(--gold)}
  .stepcard:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}
  .stepcard .num{width:42px;height:42px;border-radius:12px;background:var(--grad);color:#fff;display:grid;place-items:center;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:19px;margin-bottom:16px}
  .stepcard:nth-child(2) .num{background:var(--blue)}
  .stepcard:nth-child(3) .num{background:linear-gradient(135deg,var(--gold-hi),var(--gold))}
  .stepcard h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:20px;font-weight:800;margin-bottom:8px}
  .stepcard p{color:var(--muted);font-size:15px;line-height:1.55}

  /* Value grid (why partners pick us) */
  .vgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}
  .vcard{display:flex;gap:16px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:26px;box-shadow:var(--shadow);transition:transform .2s,box-shadow .25s}
  .vcard:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
  .vcard .ic{width:48px;height:48px;border-radius:13px;display:grid;place-items:center;flex-shrink:0;font-size:22px}
  .vcard h3{font-size:19px;font-weight:700;margin-bottom:6px}
  .vcard p{color:var(--muted);font-size:15px;line-height:1.55}
  .ic--c{background:rgba(173,44,77,.12);color:var(--crimson)}
  .ic--b{background:rgba(43,123,185,.12);color:var(--blue)}
  .ic--g{background:rgba(164,127,56,.14);color:var(--gold-dark)}
  .ic--gr{background:rgba(74,155,79,.12);color:var(--green)}

  /* Walkthrough CTA */
  .demo-cta{display:flex;align-items:center;gap:22px;background:color-mix(in srgb,var(--crimson) 5%,var(--surface));border:1px solid var(--border);border-radius:var(--radius);padding:30px;box-shadow:var(--shadow-lg);flex-wrap:wrap;border-left:4px solid var(--crimson)}
  .demo-ic{width:58px;height:58px;border-radius:16px;background:rgba(173,44,77,.1);color:var(--crimson);display:grid;place-items:center;font-size:22px;flex-shrink:0}
  .demo-body{flex:1;min-width:240px}
  .demo-body h2{font-family:'Plus Jakarta Sans',sans-serif;font-size:24px;font-weight:800;margin:10px 0 6px}
  .demo-body p{color:var(--muted);font-size:15px}

  /* Pathway cards */
  .pgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}
  .pcard{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:30px;box-shadow:var(--shadow);transition:transform .18s,box-shadow .2s;border-top:6px solid var(--crimson)}
  .pcard:nth-child(2){border-top-color:var(--blue)}
  .pcard:nth-child(3){border-top-color:var(--green)}
  .pcard:nth-child(4){border-top-color:var(--gold)}
  .pcard:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
  .pcard .ic{width:50px;height:50px;border-radius:13px;display:grid;place-items:center;margin-bottom:14px;font-size:22px}
  .pcard .typetag{display:inline-block;font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:6px}
  .pcard h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:22px;font-weight:800;margin-bottom:10px}
  .pcard .who{font-size:14px;font-weight:600;color:var(--text);margin-bottom:12px}
  .pcard .why{color:var(--muted);font-size:15px;line-height:1.6;margin-bottom:16px}
  .pcard .go{display:inline-flex;align-items:center;min-height:44px;color:var(--crimson);font-weight:800;text-decoration:none;transition:gap .18s,opacity .18s}
  .pcard .go:hover{opacity:.8}

  /* Signup section */
  .signup{display:grid;grid-template-columns:.85fr 1.15fr;gap:48px;align-items:start}
  .signup-intro .eyebrow{margin-bottom:4px}
  .signup-intro h2{font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(28px,3.4vw,40px);font-weight:800}
  .signup-sub{color:var(--muted);font-size:18px;margin:14px 0 18px;line-height:1.55}
  .signup-alt{font-size:15px;color:var(--muted);margin-bottom:8px}
  .signup-alt a{color:var(--crimson);font-weight:700}
  .signup-form{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:30px;box-shadow:var(--shadow-lg)}
  .fg{margin-bottom:16px}
  .fg label{display:block;font-size:14px;font-weight:700;margin-bottom:6px;color:var(--text)}
  .fg input,.fg select,.fg textarea{width:100%;padding:11px 14px;border:1px solid var(--border);border-radius:11px;font:inherit;font-size:15px;background:#fff;color:var(--text)}
  .fg input:focus,.fg select:focus,.fg textarea:focus{outline:none;border-color:var(--crimson);box-shadow:0 0 0 3px rgba(173,44,77,.12)}
  .fg textarea{resize:vertical}
  .fg .hint{display:block;font-size:13px;color:var(--muted);margin-top:5px}
  .fineprint{font-size:13px;color:var(--muted);text-align:center;margin-top:14px}

  /* inline submit status (success / error) */
  .form-status{font-size:15px;font-weight:600;line-height:1.5;border-radius:12px;padding:12px 16px;margin:0}
  .form-status--ok{background:rgba(74,155,79,.12);color:#2f6b34;border:1px solid rgba(74,155,79,.3);margin-top:14px}
  .form-status--err{background:rgba(173,44,77,.1);color:var(--crimson);border:1px solid rgba(173,44,77,.3);margin-bottom:16px}

  /* Split: digital integration */
  .split{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
  .split .sec-head{text-align:left;max-width:none;margin:0 0 24px}
  .feat-rows{display:flex;flex-direction:column;gap:20px}
  .feat-row{display:flex;gap:16px}
  .feat-row .ic{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;flex-shrink:0;font-size:20px}
  .feat-row h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:18px;font-weight:800;margin-bottom:5px}
  .feat-row p{color:var(--muted);font-size:15px;line-height:1.55}
  .split-fig{margin:0;border-radius:var(--radius);min-height:340px;background:var(--grad);background-image:linear-gradient(135deg,rgba(45,8,22,.35),rgba(0,0,0,0)),var(--wap-hero-photo-url-2);background-size:cover;background-position:center 40%;box-shadow:var(--shadow-lg)}

  /* FAQ */
  .faq{max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:12px}
  .faq details{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:0 20px;box-shadow:var(--shadow)}
  .faq summary{display:flex;align-items:center;justify-content:space-between;gap:14px;cursor:pointer;list-style:none;padding:18px 0;font-weight:700;font-size:17px;color:var(--text)}
  .faq summary::-webkit-details-marker{display:none}
  .faq .pl{flex-shrink:0;width:26px;height:26px;border-radius:8px;background:rgba(173,44,77,.1);color:var(--crimson);display:grid;place-items:center;font-size:18px;font-weight:700;transition:transform .2s}
  .faq details[open] .pl{transform:rotate(45deg)}
  .faq p{color:var(--muted);font-size:15px;line-height:1.6;padding:0 0 20px}

  /* ---------------- DEPTH CLOSING CTA ---------------- */
  .close{
    position:relative;overflow:hidden;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
  }
  .close__media{position:absolute;inset:0;background:var(--wap-hero-photo-url-3) center 40%/cover no-repeat}
  .close__veil{position:absolute;inset:0;
    background:var(--wap-hero-close-veil)}
  .close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:92px 24px 100px;max-width:var(--max)}
  .close__inner h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(34px,5.5vw,62px);line-height:1;letter-spacing:-.03em;margin-bottom:16px}
  .close__inner p{font-size:clamp(17px,2.2vw,21px);color:rgba(255,255,255,.92);max-width:38em;margin:0 auto 30px;line-height:1.5}

  /* ---------------- RESPONSIVE ---------------- */
  @media(max-width:900px){
    .stage{padding:64px 0 80px}
    .stage-grid{grid-template-columns:1fr;gap:56px}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
    .vgrid,.pgrid,.signup,.split{grid-template-columns:1fr}
    .steps{grid-template-columns:1fr !important}
    .split-fig{min-height:240px;order:-1}
  }
  @media(max-width:560px){
    .band{padding:60px 0}
    .acts .bbtn{width:100%;justify-content:center}
  }
</style>
</Layout>
