---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { PROGRAM_COMPARISON_TRACKS, STARTER_SLUGS } from '../data/programComparison';
import { PROGRAMS, partnerBadge } from '../data/programs';
import { languageSupportLine } from '../data/languageSupport';

// Preserve the familiar grouping while using the same current syllabus facts
// as program details. Historical salary/demand scores are not outcome evidence.
const tracks = PROGRAM_COMPARISON_TRACKS.map((track) => {
  const program = PROGRAMS.find((entry) => entry.slug === track.slug);
  if (!program) throw new Error(`Comparison program missing: ${track.slug}`);
  return {
    slug: program.slug,
    shortName: track.shortName,
    title: program.title,
    duration: program.duration,
    categoryLabel: track.categoryLabel,
    categoryOrder: track.categoryOrder,
    provider: partnerBadge(program),
    languages: languageSupportLine(program.languagesSupported) ?? 'English',
    preparation: program.syllabus?.recommendedPrerequisite
      ?? (program.syllabus
        ? 'No recommended prerequisite listed in the syllabus; confirm fit with an advisor.'
        : 'Confirm preparation with an advisor.'),
    bestFor: program.slug === 'aws-cloud-technology-amazon'
      ? 'Tech-curious learners ready for cloud.'
      : (program.extra?.bestFor ?? program.description),
    roles: program.extra?.jobOutcomes ?? [],
  };
});

// Recommended starting points (real STARTER_SLUGS from ProgramComparisonClient).
const starterTracks = STARTER_SLUGS
  .map((slug) => tracks.find((t) => t.slug === slug))
  .filter((t): t is (typeof tracks)[number] => Boolean(t));

// Group tracks by category, preserving category order (mirrors the pick table).
const categories = [...new Map(
  tracks
    .slice()
    .sort((a, b) => a.categoryOrder - b.categoryOrder)
    .map((t) => [t.categoryLabel, t.categoryOrder]),
).entries()].map(([label]) => ({
  label,
  tracks: tracks.filter((t) => t.categoryLabel === label),
}));

const trackCount = tracks.length;

// "How to choose" factors (verbatim guidance from ProgramComparisonClient).
const factors = [
  {
    icon: 'clock',
    label: 'Time',
    desc: 'Compare published course hours and delivery format with the study time you can protect each week.',
  },
  {
    icon: 'star',
    label: 'Preparation',
    desc: 'Check the syllabus prerequisites. An advisor can help you decide what to learn first.',
  },
  {
    icon: 'laptop',
    label: 'Tech comfort',
    desc: 'Uncomfortable with computers? Start with Digital Literacy, then stack into IT Support or another track.',
  },
  {
    icon: 'trending-up',
    label: 'Career research',
    desc: 'Compare current job requirements and local pay for the occupation you want to enter.',
  },
];
---
<Layout
  title="Compare Programs — Side-by-Side Career Tracks"
  description="Compare WorkforceAP career tracks side-by-side: course hours, delivery format, preparation, roles to research, and training providers."
>
<div class="cmpdepth">

<!-- ══════════════════════════════ HERO — DEPTH STAGE ══════════════════════════════ -->
<section class="stage">
  <div class="aura aura--1"></div>
  <div class="aura aura--2"></div>
  <div class="aura aura--3"></div>
  <div class="grain"></div>

  <div class="wrap stage-grid">
    <div class="lede">
      <span class="pill"><span class="pill__star"><Icon name="bar-chart" size={12} /></span>Program comparison</span>
      <h1>Which program fits <span class="shimmer">your goals?</span></h1>
      <p class="sub">Compare the time commitment, preparation, and skills behind each career path. Choose a program that fits your life and the work you want to do.</p>
      <div class="acts">
        <a class="dbtn dbtn--solid" href="/find-your-path">Not sure? Find your path <span>→</span></a>
        <a class="dbtn dbtn--glass" href="#compare-table">Jump to the comparison</a>
      </div>
    </div>

    <!-- glass stat card -->
    <div class="hero-glass">
      <div class="hg-tag">Career tracks compared</div>
      <div class="hg-meter">
        <span>Tracks in this comparison</span>
        <strong>{trackCount}</strong>
      </div>
      <div class="hg-rows">
        <div class="hg-row"><span><Icon name="clock" size={16} /> Your schedule</span><b>Compare course hours</b></div>
        <div class="hg-row"><span><Icon name="book-open" size={16} /> Your background</span><b>Check preparation</b></div>
        <div class="hg-row"><span><Icon name="target" size={16} /> Your next role</span><b>Research requirements</b></div>
      </div>
      <div class="hg-chips">
        <span>No cost to qualifying members</span>
        <span>WIOA &amp; grant funded</span>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════ HOW TO USE THIS PAGE ══════════════════════════════ -->
<section class="band"><div class="wrap">
  <div class="sec-head">
    <span class="eyebrow">How to use this page</span>
    <h2>Pick based on <span class="grad-text">what matters most</span></h2>
    <p>Start with your interests and available study time. Select 2 to 4 tracks to open the side-by-side matrix. Use the published preparation notes and an advisor conversation to narrow your choices.</p>
  </div>
  <div class="choose">
    {factors.map((f, i) => (
      <div class="fcard">
        <span class="fcard-idx">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="fcard-hero">{f.label}</h3>
        <p>{f.desc}</p>
      </div>
    ))}
  </div>
  <p class="cmp-truth">Still unsure? <a href="/find-your-path">Find programs to explore with the pathfinder.</a> For pay and job requirements, <a href="/salary-guide">use our career research guide.</a></p>
</div></section>

<!-- ══════════════════════════════ RECOMMENDED STARTING POINTS ══════════════════════════════ -->
<section class="band band--surface"><div class="wrap">
  <div class="sec-head">
    <span class="eyebrow">Recommended starting points</span>
    <h2>Three common <span class="grad-text">front doors</span></h2>
    <p>Explore these starting points, then compare preparation and course content before choosing a track.</p>
  </div>
  <div class="tri">
    {starterTracks.map((t) => (
      <article class="acard">
        <span class="eyebrow" style="margin-bottom:12px">{t.categoryLabel}</span>
        <h3>{t.title}</h3>
        <p>{t.bestFor}</p>
        <div class="acard-meta">
          <span><Icon name="clock" size={15} /> {t.duration}</span>
        </div>
        <div class="acard-acts">
          <a class="btn btn--ghost" href={`/programs/${t.slug}`}>Program detail</a>
          <label class="cmp-check">
            <input type="checkbox" data-compare-slug={t.slug} aria-label={`Add ${t.shortName} to comparison`} />
            <span>Compare</span>
          </label>
          <a class="btn btn--primary" href={`/apply?program=${t.slug}`}>Apply →</a>
        </div>
      </article>
    ))}
  </div>
  <p class="starters-more">
    <a href="/find-your-path">Find your path</a> for suggestions based on your interests, or <a href="/programs">browse all programs</a>.
  </p>
</div></section>

<!-- ══════════════════════════════ SIDE-BY-SIDE COMPARISON TABLE ══════════════════════════════ -->
<section class="band" id="compare-table"><div class="wrap">
  <div class="sec-head sec-head--left">
    <span class="eyebrow">Side-by-side</span>
    <h2>Compare all {trackCount} career tracks</h2>
    <p>Check 2 to 4 programs, then scan the matrix. Published study commitment, Coursera language support, preparation, training providers, and roles to research — grouped by field.</p>
  </div>

  <div class="cmp-toolbar">
    <p id="compare-status" aria-live="polite">
      <strong>Select 2–4 programs</strong> from the starters or the table. <span class="cmp-toolbar-count">0 selected — add 2 more.</span>
    </p>
  </div>

  <section class="cmp-sidebyside" id="compare-matrix" hidden aria-labelledby="sidebyside-heading">
    <div class="cmp-sidebyside-header">
      <h3 id="sidebyside-heading">Side-by-side comparison</h3>
      <button type="button" class="btn btn--ghost btn--sm" id="clear-compare">Clear selection</button>
    </div>
    <div class="cmp-matrix-wrap" role="region" aria-label="Selected program comparison" tabindex="0" aria-describedby="compare-matrix-hint">
      <p class="cmp-scroll-hint" id="compare-matrix-hint">Scroll sideways to see every selected track.</p>
      <table class="cmp-matrix">
        <thead>
          <tr id="compare-matrix-head">
            <th scope="col">Criteria</th>
          </tr>
        </thead>
        <tbody id="compare-matrix-body"></tbody>
      </table>
    </div>
  </section>

  <!-- Wide table wraps with horizontal scroll on narrow screens -->
  <div class="cmp-wrap" role="region" aria-label="Program comparison table" tabindex="0" aria-describedby="compare-table-hint">
    <p class="cmp-scroll-hint" id="compare-table-hint">On a wide screen, the track name stays in view while you scroll.</p>
    <table class="cmp">
      <thead>
        <tr>
          <th scope="col" class="cmp-pick">Compare</th>
          <th scope="col" class="cmp-track">Track</th>
          <th scope="col">Duration</th>
          <th scope="col">Languages</th>
          <th scope="col">Preparation</th>
          <th scope="col">Roles to research</th>
          <th scope="col">Training providers</th>
          <th scope="col" class="cmp-act"><span class="sr-only">Apply</span></th>
        </tr>
      </thead>
      <tbody>
        {categories.map((cat) => (
          <>
            <tr class="cmp-cat"><th scope="colgroup" colspan="8">{cat.label}</th></tr>
            {cat.tracks.map((t) => (
              <tr
                class="cmp-track-row"
                data-slug={t.slug}
                data-short={t.shortName}
                data-href={`/programs/${t.slug}`}
                data-apply={`/apply?program=${t.slug}`}
                data-duration={t.duration}
                data-languages={t.languages}
                data-preparation={t.preparation}
                data-roles={t.roles.join(' · ')}
                data-provider={t.provider}
              >
                <td class="cmp-pick" data-label="Compare">
                  <label class="cmp-check">
                    <input type="checkbox" data-compare-slug={t.slug} aria-label={`Include ${t.shortName} in comparison`} />
                    <span class="cmp-check-text">Compare</span>
                  </label>
                </td>
                <th scope="row" class="cmp-track" data-label="Track">
                  <a href={`/programs/${t.slug}`}>{t.title}</a>
                </th>
                <td data-label="Duration">{t.duration}</td>
                <td data-label="Languages">{t.languages}</td>
                <td data-label="Preparation">{t.preparation}</td>
                <td data-label="Roles to research">{t.roles.join(' · ')}</td>
                <td data-label="Training providers">{t.provider}</td>
                <td data-label="Apply" class="cmp-act">
                  <a class="btn btn--ghost btn--sm" href={`/apply?program=${t.slug}`}>Apply</a>
                </td>
              </tr>
            ))}
          </>
        ))}
      </tbody>
    </table>
  </div>

  <p class="catalog-foot">Program details use the current WorkforceAP catalog and supplied syllabi. A suggested role is a research direction; employers may require additional education or experience. <a href="/salary-guide">Check occupational pay and entry requirements</a> before deciding.</p>
</div></section>

<!-- ══════════════════════════════ HELP / NO-COST BAND ══════════════════════════════ -->
<section class="band band--surface"><div class="wrap">
  <div class="sec-head">
    <span class="eyebrow">After you compare</span>
    <h2>Need a hand choosing?</h2>
    <p>An advisor can map a sequence from the tracks you just compared. Qualifying members train at no cost.</p>
  </div>
  <div class="help-grid">
    <div class="help-card">
      <div class="help-ic"><Icon name="map" size={24} /></div>
      <h3>Need a personalized path?</h3>
      <p>Our career advisors can help map a custom program sequence based on your background, goals, and timeline. No cost, no obligation.</p>
      <div class="help-acts">
        <a class="btn btn--primary" href="/find-your-path">Take the quiz</a>
        <a class="btn btn--ghost" href="/programs">Explore programs</a>
      </div>
    </div>
    <div class="help-card help-card--accent">
      <div class="help-ic help-ic--light"><Icon name="graduation-cap" size={24} /></div>
      <h3>No cost for qualifying members</h3>
      <p>WorkforceAP programs are offered at no cost for members who qualify through scholarship/grant funded membership. Training is available through WorkforceAP and partner-backed pathways.</p>
      <div class="help-acts">
        <a class="btn btn--light" href="/salary-guide">Research pay and job requirements</a>
        <a class="btn btn--translucent" href="/apply">Apply now</a>
      </div>
    </div>
  </div>
</div></section>

<!-- ══════════════════════════════ CLOSING CTA — DEPTH crimson band ══════════════════════════════ -->
<section class="close">
  <div class="close__media" aria-hidden="true"></div>
  <div class="close__veil" aria-hidden="true"></div>
  <div class="close__inner wrap">
    <span class="pill pill--solid"><span class="pill__star"><Icon name="star" size={11} /></span>Reviewed by a real team in 1–2 business days</span>
    <h2>Found your fit?</h2>
    <p>Apply in minutes. A member advisor will follow up within 1–2 business days.</p>
    <div class="acts acts--center">
      <a class="bbtn bbtn--gold" href="/apply">Apply Now →</a>
      <a class="bbtn bbtn--outline" href="/programs">Explore programs</a>
    </div>
  </div>
</section>

</div>

<script is:inline>
  // Pick 2–4 tracks → side-by-side matrix (progressive enhancement).
  (function () {
    var MIN_PICK = 2;
    var MAX_PICK = 4;
    var CRITERIA = [
      { key: 'duration', label: 'Duration' },
      { key: 'languages', label: 'Languages' },
      { key: 'preparation', label: 'Preparation' },
      { key: 'roles', label: 'Roles to research' },
      { key: 'provider', label: 'Training providers' }
    ];
    var boxes = Array.prototype.slice.call(document.querySelectorAll('input[data-compare-slug]'));
    var rows = Array.prototype.slice.call(document.querySelectorAll('.cmp-track-row'));
    var matrix = document.getElementById('compare-matrix');
    var headRow = document.getElementById('compare-matrix-head');
    var body = document.getElementById('compare-matrix-body');
    var status = document.getElementById('compare-status');
    var countEl = status ? status.querySelector('.cmp-toolbar-count') : null;
    var clearBtn = document.getElementById('clear-compare');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!boxes.length || !matrix || !headRow || !body) return;

    var selected = [];
    var wasOpen = false;

    function uniqueSlugs() {
      var seen = {};
      var out = [];
      selected.forEach(function (slug) {
        if (!seen[slug]) { seen[slug] = true; out.push(slug); }
      });
      return out;
    }

    function rowFor(slug) {
      for (var i = 0; i < rows.length; i++) {
        if (rows[i].getAttribute('data-slug') === slug) return rows[i];
      }
      return null;
    }

    function syncBoxes() {
      var picked = uniqueSlugs();
      var atMax = picked.length >= MAX_PICK;
      boxes.forEach(function (box) {
        var slug = box.getAttribute('data-compare-slug');
        var on = picked.indexOf(slug) !== -1;
        box.checked = on;
        box.disabled = !on && atMax;
      });
    }

    function setStatus() {
      var n = uniqueSlugs().length;
      var more = Math.max(0, MIN_PICK - n);
      var text;
      if (n >= MIN_PICK) text = n + ' selected — matrix is on above.';
      else if (n === 0) text = '0 selected — add ' + MIN_PICK + ' more.';
      else text = n + ' selected — add ' + more + ' more.';
      if (countEl) countEl.textContent = text;
    }

    function writeUrl() {
      var slugs = uniqueSlugs();
      var url = new URL(window.location.href);
      if (slugs.length >= MIN_PICK) url.searchParams.set('compare', slugs.join(','));
      else url.searchParams.delete('compare');
      history.replaceState({}, '', url);
    }

    function cell(tag, text, attrs) {
      var el = document.createElement(tag);
      if (text) el.textContent = text;
      if (attrs) Object.keys(attrs).forEach(function (k) { el.setAttribute(k, attrs[k]); });
      return el;
    }

    function renderMatrix() {
      var slugs = uniqueSlugs();
      var open = slugs.length >= MIN_PICK;
      matrix.hidden = !open;
      if (!open) {
        headRow.replaceChildren(cell('th', 'Criteria', { scope: 'col' }));
        body.replaceChildren();
        wasOpen = false;
        return;
      }
      var tracks = slugs.map(rowFor).filter(Boolean);
      headRow.replaceChildren();
      headRow.appendChild(cell('th', 'Criteria', { scope: 'col' }));
      tracks.forEach(function (row) {
        var name = row.getAttribute('data-short') || row.getAttribute('data-slug');
        var href = row.getAttribute('data-href') || '#';
        var th = cell('th', '', { scope: 'col' });
        var a = cell('a', name, { href: href });
        th.appendChild(a);
        headRow.appendChild(th);
      });
      body.replaceChildren();
      CRITERIA.forEach(function (crit) {
        var tr = document.createElement('tr');
        tr.appendChild(cell('th', crit.label, { scope: 'row' }));
        tracks.forEach(function (row) {
          var td = cell('td', row.getAttribute('data-' + crit.key) || '—', {
            'data-label': row.getAttribute('data-short') || ''
          });
          tr.appendChild(td);
        });
        body.appendChild(tr);
      });
      var next = document.createElement('tr');
      next.appendChild(cell('th', 'Next step', { scope: 'row' }));
      tracks.forEach(function (row) {
        var name = row.getAttribute('data-short') || 'program';
        var apply = row.getAttribute('data-apply') || '/apply';
        var td = cell('td', '', { 'data-label': name });
        td.appendChild(cell('a', 'Apply', {
          class: 'btn btn--ghost btn--sm',
          href: apply
        }));
        next.appendChild(td);
      });
      body.appendChild(next);
      if (!wasOpen) {
        matrix.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest' });
      }
      wasOpen = true;
    }

    function apply() {
      syncBoxes();
      setStatus();
      renderMatrix();
      writeUrl();
    }

    function toggle(slug, on) {
      var i = selected.indexOf(slug);
      if (on) {
        if (i === -1 && uniqueSlugs().length < MAX_PICK) selected.push(slug);
      } else if (i !== -1) {
        selected = selected.filter(function (s) { return s !== slug; });
      }
      apply();
    }

    boxes.forEach(function (box) {
      box.addEventListener('change', function () {
        toggle(box.getAttribute('data-compare-slug'), box.checked);
      });
    });
    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        selected = [];
        apply();
        var first = boxes[0];
        if (first) first.focus();
      });
    }

    var raw = new URL(window.location.href).searchParams.get('compare');
    if (raw) {
      raw.split(',').forEach(function (part) {
        var slug = part.trim();
        if (!slug) return;
        if (!rowFor(slug)) return;
        if (uniqueSlugs().length < MAX_PICK) selected.push(slug);
      });
    }
    apply();
  })();
</script>

<style is:global>
  /* ===================================================================
     PROGRAM COMPARISON — DEPTH aesthetic (matches programs.astro).
     depth stage hero + glass card → light alternating bands w/ a clean
     responsive comparison table → depth crimson closing CTA.
     =================================================================== */
  .cmpdepth{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}

  /* ---------------- DEPTH HERO STAGE ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:84px 0 92px;
  }
  .stage-grid{display:grid;grid-template-columns:1.06fr .94fr;gap:56px;align-items:center;position:relative;z-index:2}

  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:520px;height:520px;top:-170px;right:-120px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:460px;height:460px;bottom:-200px;left:-140px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:360px;height:360px;top:24%;left:44%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%)}

  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:soft-light;pointer-events:none;
    background-image:var(--wap-hero-photo-url);background-size:cover;background-position:center 35%;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,rgba(0,0,0,.35) 28%,#000 72%);
    mask-image:linear-gradient(90deg,transparent 0%,rgba(0,0,0,.35) 28%,#000 72%);opacity:.42}

  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:var(--grad-gold);color:var(--gold-ink);font-weight:800;font-size:13px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{display:inline-flex;font-size:13px;opacity:.95}
  @media(max-width:430px){.pill{white-space:normal;text-align:left}}

  .lede h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(38px,5.4vw,64px);
    line-height:1.04;letter-spacing:-.03em;margin:22px 0 0}
  .shimmer{background:var(--grad-gold-shimmer);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .lede .sub{font-size:19px;line-height:1.55;color:rgba(255,255,255,.82);max-width:34em;margin:22px 0 30px}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}

  /* hero glass stat card */
  .hero-glass{position:relative;border-radius:22px;padding:28px;
    background:rgba(255,255,255,.13);border:1px solid var(--glass-line);backdrop-filter:blur(18px);
    box-shadow:var(--shadow-glass);color:#fff}
  .hg-tag{font-size:13px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.72);margin-bottom:14px}
  .hg-meter{display:flex;align-items:baseline;justify-content:space-between;padding:14px 16px;border-radius:13px;
    background:rgba(0,0,0,.18);border:1px solid rgba(255,255,255,.12);margin-bottom:14px}
  .hg-meter span{font-size:13px;color:rgba(255,255,255,.8)}
  .hg-meter strong{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:34px;color:var(--gold-glow);line-height:1}
  .hg-rows{display:flex;flex-direction:column;gap:10px;margin-bottom:16px}
  .hg-row{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:13px;color:rgba(255,255,255,.82)}
  .hg-row span{display:inline-flex;align-items:center;gap:7px}
  .hg-row b{color:#fff;font-weight:800}
  .hg-chips{display:flex;flex-wrap:wrap;gap:8px}
  .hg-chips span{font-size:13px;font-weight:700;padding:6px 12px;border-radius:999px;
    background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18)}

  /* ---------------- LIGHT BODY BANDS ---------------- */
  .band{padding:var(--sec-pad) 0}
  .band--surface{background:var(--surface)}

  .sec-head{max-width:720px;margin:0 auto 44px;text-align:center;display:flex;flex-direction:column;align-items:center}
  .sec-head--left{text-align:left;align-items:flex-start;max-width:46rem;margin-left:0;margin-right:auto}
  .sec-head h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(30px,4.4vw,48px);line-height:1.05;letter-spacing:-.02em;margin-bottom:12px}
  .sec-head h3{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(22px,3vw,32px);line-height:1.15;letter-spacing:-.02em;margin:0}
  .sec-head p{color:var(--muted);font-size:19px;line-height:1.55}
  .eyebrow{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--crimson);margin-bottom:14px}
  .btn--sm{padding:12px 16px;font-size:16px;min-height:44px;justify-content:center}

  /* how-to-choose grid — stat-led cards: the factor becomes a big headline
     (the "number" of the card) over a small colored index chip, instead of
     an icon-in-circle (was an icon-in-circle card grid; distinct from the
     other icon-card treatments elsewhere on the site). */
  .choose{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
  .fcard{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:26px 24px;box-shadow:var(--shadow)}
  .fcard-idx{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:9px;
    font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:13px;margin-bottom:16px;
    background:rgba(173,44,77,.1);color:var(--crimson)}
  /* text colors below are darkened from --blue/--green for AA text contrast
     on their tint chips (≥4.5:1) — the lighter tokens stay in the background tint */
  .fcard:nth-child(2) .fcard-idx{background:rgba(43,123,185,.12);color:#1d5c8a}
  .fcard:nth-child(3) .fcard-idx{background:rgba(164,127,56,.14);color:var(--gold-dark)}
  .fcard:nth-child(4) .fcard-idx{background:rgba(74,155,79,.12);color:#2f6b34}
  .fcard-hero{font-family:'Plus Jakarta Sans',sans-serif;font-size:20px;font-weight:800;letter-spacing:-.01em;line-height:1.15;margin-bottom:8px}
  .fcard p{color:var(--muted);font-size:16px;line-height:1.55}
  @media(max-width:880px){.choose{grid-template-columns:1fr 1fr}}
  @media(max-width:520px){.choose{grid-template-columns:1fr}}

  .cmp-truth{max-width:720px;margin:36px auto 0;text-align:center;color:var(--muted);font-size:14px;
    background:var(--surface-2);border:1px dashed var(--border);border-radius:14px;padding:18px 22px}
  .cmp-truth a{color:var(--crimson);font-weight:800}

  /* recommended starters */
  .tri{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .acard{display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
    padding:28px;box-shadow:var(--shadow);border-top:6px solid var(--crimson);transition:transform .2s,box-shadow .25s}
  .acard:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}
  .acard h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:22px;font-weight:800;margin-bottom:10px}
  .acard p{color:var(--muted);font-size:16px;line-height:1.55;margin-bottom:18px}
  .acard-meta{display:flex;flex-wrap:wrap;align-items:center;gap:14px;font-size:14px;color:var(--muted);margin-bottom:18px}
  .acard-meta span{display:inline-flex;align-items:center;gap:6px}
  .acard-stars{color:var(--gold-dark);letter-spacing:1px}
  .acard-sal{color:var(--crimson);font-weight:800}
  .acard-acts{margin-top:auto;display:flex;gap:8px;flex-wrap:wrap}
  .starters-more{text-align:center;margin-top:28px;color:var(--muted);font-size:15px}
  .starters-more a{color:var(--crimson);font-weight:800}
  @media(max-width:880px){.tri{grid-template-columns:1fr}}

  /* ---------------- COMPARISON TABLE ---------------- */
  .cmp-toolbar{margin:0 0 16px;padding:14px 18px;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);font-size:16px;line-height:1.5}
  .cmp-toolbar p{margin:0}
  .cmp-toolbar-count{color:var(--muted)}
  .cmp-check{display:inline-flex;align-items:center;gap:8px;min-height:44px;min-width:44px;cursor:pointer;font-size:16px;font-weight:700;color:var(--text)}
  .cmp-check input{width:20px;height:20px;accent-color:var(--crimson);flex-shrink:0}
  .cmp-scroll-hint{font-size:13px;color:var(--muted);margin:0 0 10px}
  .cmp-sidebyside{margin:0 0 24px;padding:20px 22px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow)}
  .cmp-sidebyside[hidden]{display:none}
  .cmp-sidebyside-header{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}
  .cmp-sidebyside-header h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(22px,3vw,32px);font-weight:800;letter-spacing:-.02em;margin:0;color:var(--text)}
  .cmp-matrix-wrap,.cmp-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);background:var(--surface);-webkit-overflow-scrolling:touch}
  .cmp-matrix-wrap{box-shadow:none}
  .cmp-wrap:focus-visible,.cmp-matrix-wrap:focus-visible{outline:2px solid var(--crimson);outline-offset:2px}
  .cmp,.cmp-matrix{width:100%;border-collapse:collapse;min-width:760px;font-size:16px}
  .cmp-matrix{min-width:520px}
  .cmp thead th,.cmp-matrix thead th{text-align:left;padding:14px 16px;font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
    color:var(--muted);background:var(--surface-2);border-bottom:1px solid var(--border);white-space:nowrap}
  .cmp tbody td,.cmp tbody th,.cmp-matrix tbody td,.cmp-matrix tbody th{padding:14px 16px;border-bottom:1px solid var(--border);vertical-align:top;text-align:left;font-weight:400}
  .cmp tbody tr:hover td,.cmp tbody tr:hover th{background:var(--surface-2)}
  .cmp .cmp-track{font-weight:700;position:sticky;left:3.5rem;z-index:1;background:var(--surface)}
  .cmp thead .cmp-track{left:3.5rem;z-index:2}
  .cmp .cmp-pick{width:3.5rem;text-align:center;position:sticky;left:0;z-index:2;background:var(--surface-2)}
  .cmp tbody .cmp-pick{background:var(--surface)}
  .cmp .cmp-check-text{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}
  .cmp .cmp-track a,.cmp-matrix thead a{color:var(--text);font-weight:700;text-decoration:none}
  .cmp .cmp-track a:hover,.cmp-matrix thead a:hover{color:var(--crimson);text-decoration:underline}
  .cmp .cmp-sal{color:var(--crimson);font-weight:800;white-space:nowrap}
  .cmp .cmp-act{text-align:right}
  .cmp tr.cmp-cat th{background:color-mix(in srgb, var(--crimson) 7%, var(--surface));color:var(--crimson);font-size:13px;font-weight:800;letter-spacing:.08em;
    text-transform:uppercase;padding:8px 16px;border-top:1px solid color-mix(in srgb, var(--crimson) 18%, var(--border));border-bottom:1px solid color-mix(in srgb, var(--crimson) 18%, var(--border));position:sticky;left:0}
  .cmp-matrix tbody th[scope="row"]{background:var(--surface-2);font-weight:700;white-space:nowrap;position:sticky;left:0;z-index:1}
  .cmp-matrix thead th:first-child{position:sticky;left:0;z-index:2}
  .demand{display:inline-flex;align-items:center;gap:5px;font-size:13px;font-weight:700;padding:4px 10px;border-radius:999px;
    background:var(--surface-2);border:1px solid var(--border);color:var(--muted)}
  .demand--vh{background:color-mix(in srgb, var(--green) 12%, transparent);border-color:transparent;color:var(--green)}

  .catalog-foot{margin-top:18px;font-size:13px;color:var(--muted);max-width:760px;line-height:1.5}

  /* card-stack the table on phones so nothing overflows the viewport */
  @media(max-width:680px){
    .cmp-scroll-hint{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}
    .cmp-wrap,.cmp-matrix-wrap{overflow-x:visible;border:none;box-shadow:none;background:transparent}
    .cmp,.cmp-matrix{min-width:0;border-collapse:separate;border-spacing:0 0;display:block}
    .cmp thead{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}
    .cmp tbody tr:not(.cmp-cat){display:block;background:var(--surface);border:1px solid var(--border);
      border-radius:var(--radius);box-shadow:var(--shadow);padding:6px 4px;margin-bottom:14px}
    .cmp tbody tr.cmp-cat{display:block;margin:18px 0 10px}
    .cmp tr.cmp-cat th{display:block;border-radius:8px;position:static}
    .cmp tbody td,.cmp tbody th{display:flex;justify-content:space-between;gap:16px;align-items:center;
      border-bottom:1px solid var(--border);padding:10px 14px;text-align:right}
    .cmp tbody tr:not(.cmp-cat) :last-child{border-bottom:none}
    .cmp tbody td::before,.cmp tbody th[data-label]::before{content:attr(data-label);font-size:13px;font-weight:800;
      letter-spacing:.04em;text-transform:uppercase;color:var(--muted);text-align:left}
    .cmp .cmp-track,.cmp .cmp-pick{position:static;justify-content:space-between;background:transparent}
    .cmp .cmp-track::before{content:'Track'}
    .cmp .cmp-check-text{position:static;width:auto;height:auto;margin:0;overflow:visible;clip:unset;clip-path:none}
    .cmp .cmp-act{justify-content:flex-end}
    .cmp tbody tr:hover td,.cmp tbody tr:hover th{background:transparent}
    .cmp-matrix thead{display:none}
    .cmp-matrix tbody{display:block}
    .cmp-matrix tbody tr{display:block;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
      box-shadow:var(--shadow);padding:14px;margin-bottom:14px}
    .cmp-matrix tbody th[scope="row"]{display:block;position:static;padding:0 0 10px;margin-bottom:8px;border-bottom:1px solid var(--border);white-space:normal}
    .cmp-matrix tbody td{display:block;padding:8px 0;border-bottom:none}
    .cmp-matrix tbody td + td{border-top:1px solid var(--border);margin-top:6px;padding-top:10px}
    .cmp-matrix tbody td::before{content:attr(data-label);display:block;font-size:13px;font-weight:800;letter-spacing:.04em;
      text-transform:uppercase;color:var(--muted);margin-bottom:4px;text-align:left}
  }

  /* ---------------- HELP / NO-COST GRID ---------------- */
  .help-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
  @media(max-width:780px){.help-grid{grid-template-columns:1fr}}
  .help-card{display:flex;flex-direction:column;gap:14px;background:var(--surface);border:1px solid var(--border);
    border-radius:var(--radius);padding:30px;box-shadow:var(--shadow)}
  .help-card h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:21px;font-weight:800}
  .help-card p{color:var(--muted);font-size:16px;line-height:1.6}
  .help-ic{width:48px;height:48px;border-radius:12px;background:rgba(173,44,77,.12);display:grid;place-items:center;color:var(--crimson)}
  .help-acts{margin-top:auto;display:flex;gap:10px;flex-wrap:wrap}
  .help-card--accent{background:var(--crimson);color:#fff;border-color:transparent}
  .help-card--accent p{color:rgba(255,255,255,.92)}
  .help-ic--light{background:rgba(255,255,255,.2);color:#fff}

  /* ---------------- DEPTH CLOSING CTA ---------------- */
  .close{position:relative;overflow:hidden;width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw}
  .close__media{position:absolute;inset:0;background:var(--wap-hero-photo-url-3) center 40%/cover no-repeat}
  .close__veil{position:absolute;inset:0;
    background:var(--wap-hero-close-veil)}
  .close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:88px 24px 96px;max-width:var(--max)}
  .pill--solid{margin-bottom:24px}
  .close__inner h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(34px,5.5vw,64px);line-height:.98;letter-spacing:-.03em;margin-bottom:18px}
  .close__inner p{font-size:clamp(17px,2.2vw,21px);color:rgba(255,255,255,.92);max-width:38em;margin:0 auto 30px;line-height:1.5}

  /* ---------------- RESPONSIVE HERO ---------------- */
  @media(max-width:880px){
    .stage{padding:64px 0 76px}
    .stage-grid{grid-template-columns:1fr;gap:44px}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
  }
  @media(max-width:560px){
    .acts .dbtn,.acts .bbtn{width:100%;justify-content:center}
  }
</style>
</Layout>
