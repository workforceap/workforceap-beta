---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="About WorkforceAP"
  description="WorkforceAP has spent 25+ years bridging the gap between education and industry, connecting skilled individuals with meaningful employment opportunities."
>
<div class="aboutd">

  <!-- ============================================================
       HERO — SHORTER DEPTH STAGE: crimson→plum depth band with
       glow auras + luminosity-masked photo, gold pill, white text.
       ============================================================ -->
  <section class="stage">
    <div class="aura aura--1"></div>
    <div class="aura aura--2"></div>
    <div class="aura aura--3"></div>
    <div class="grain"></div>

    <div class="wrap stage-grid">
      <div class="lede">
        <span class="pill"><span class="pill__star">★</span>501(c)(3) nonprofit · 25+ years in workforce development</span>
        <h1>About WorkforceAP</h1>
        <p class="sub">Advancing careers through employer-aligned training and career support.</p>
      </div>

      <!-- translucent glass stat card -->
      <div class="glass-stat">
        <div class="gs-row">
          <small>Why we exist</small>
        </div>
        <div class="gs-big">Bridging education &amp; industry</div>
        <div class="gs-grid">
          <div class="gs-i"><b>25+</b><span>years of workforce development leadership</span></div>
          <div class="gs-i"><b>$0</b><span>for members who qualify through scholarship/grant funded membership</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       MISSION — light band, bold prose block + depth photo card.
       ============================================================ -->
  <section class="band band--surface"><div class="wrap">
    <div class="head sec-head">
      <span class="kick">Our mission</span>
      <h2>Bridging education and industry</h2>
    </div>
    <div class="about-split">
      <div class="about-prose">
        <p>
          WorkforceAP is dedicated to advancing careers and connecting skilled individuals
          with meaningful employment opportunities. Our mission is to bridge the gap between
          education and industry, ensuring that every participant is ready for the demands of
          the modern workforce.
        </p>
        <p>
          With over 25 years of workforce development leadership, we provide employer-aligned
          training, comprehensive career support, and funded pathways for qualifying members.
          Our programs are built around real industry needs—so graduates are job-ready from
          day one.
        </p>
      </div>
      <div class="about-photo" aria-hidden="true"></div>
    </div>
  </div></section>

  <!-- ============================================================
       CLOSING CTA — BOLD full-bleed crimson, photo luminosity.
       ============================================================ -->
  <section class="close">
    <div class="close__media" aria-hidden="true"></div>
    <div class="close__veil" aria-hidden="true"></div>
    <div class="close__inner wrap">
      <h2>Your next step starts with one application.</h2>
      <p>Apply in about 5 minutes — no cost for members who qualify through scholarship/grant funded membership. A real team reviews it and follows up in 1 to 2 business days.</p>
      <div class="acts acts--center">
        <a class="bbtn bbtn--gold" href="/apply">Start your application</a>
        <a class="bbtn bbtn--outline" href="/find-your-path">Find Your Path</a>
      </div>
    </div>
  </section>

</div>

<style>
  /* ===================================================================
     ABOUT — DEPTH-LED restyle to match the home design language.
     shorter depth stage hero → light mission band w/ depth photo →
     bold full-bleed crimson closing CTA.
     =================================================================== */
  .aboutd{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}

  /* ---------------- SHORTER DEPTH HERO STAGE ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:84px 0 92px;
  }
  .stage-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;position:relative;z-index:2}

  /* glow auras — gold + crimson + white */
  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:480px;height:480px;top:-150px;right:-110px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:420px;height:420px;bottom:-180px;left:-130px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:340px;height:340px;top:24%;left:44%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%)}

  /* luminosity-masked real photo bleeding in from the right */
  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:overlay;pointer-events:none;
    background-image:var(--wap-hero-photo-url);background-size:cover;background-position:center;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);opacity:.18}

  /* gold PILL — fully visible, never clipped */
  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:linear-gradient(135deg,#e3bd6a,#a47f38);color:#3a2c10;font-weight:800;font-size:13px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{font-size:13px;opacity:.95}
  @media(max-width:520px){.pill{white-space:normal;text-align:left}}

  .lede h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(40px,6vw,68px);
    line-height:1.02;letter-spacing:-.03em;margin:22px 0 0}
  .lede .sub{font-size:20px;line-height:1.55;color:rgba(255,255,255,.84);max-width:34em;margin:20px 0 0}

  /* translucent glass stat card */
  .glass-stat{position:relative;border-radius:22px;padding:28px;
    background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(18px);
    box-shadow:var(--shadow-glass);color:#fff}
  .gs-row{margin-bottom:0}
  .gs-row small{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.72);font-weight:700}
  .gs-big{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:24px;margin:10px 0 22px;letter-spacing:-.01em}
  .gs-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  .gs-i{display:flex;flex-direction:column;gap:4px}
  .gs-i b{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:32px;color:#f3d28f;line-height:1}
  .gs-i span{font-size:13px;color:rgba(255,255,255,.78);line-height:1.4}

  /* ---------------- LIGHT MISSION BAND ---------------- */
  /* left-align over the asymmetric prose/photo split below instead of the
     shared .sec-head centered default — a centered kicker above a 1.1fr/.9fr
     split read as a layout mismatch. */
  .head{margin:0 0 32px;text-align:left;max-width:640px}
  .kick{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--crimson)}

  .about-split{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}
  .about-prose p{font-size:18px;color:var(--text);margin-bottom:18px;line-height:1.7}
  .about-prose p:last-child{margin-bottom:0}

  .about-photo{
    min-height:340px;border-radius:var(--radius);box-shadow:var(--shadow-lg);
    background:
      linear-gradient(135deg,rgba(173,44,77,.55),rgba(91,33,98,.55)),
      var(--wap-hero-photo-url-2) center/cover no-repeat;
  }

  /* ---------------- BOLD FULL-BLEED CLOSING CTA ---------------- */
  .close{
    position:relative;overflow:hidden;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
  }
  .close__media{position:absolute;inset:0;background:var(--wap-hero-photo-url-3) center 40%/cover no-repeat}
  .close__veil{position:absolute;inset:0;
    background:var(--wap-hero-close-veil)}
  .close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:92px 24px 100px;max-width:var(--max)}
  .close__inner h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(34px,5.5vw,66px);line-height:.98;letter-spacing:-.03em;margin-bottom:18px}
  .close__inner p{font-size:clamp(17px,2.2vw,21px);color:rgba(255,255,255,.92);max-width:38em;margin:0 auto 30px;line-height:1.5}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}

  /* a11y: white focus ring on the crimson CTA band (crimson ring would be invisible here) */
  .close .bbtn:focus-visible{outline:2px solid #fff;outline-offset:3px}

  /* ---------------- RESPONSIVE ---------------- */
  @media(max-width:880px){
    .stage{padding:64px 0 76px}
    .stage-grid{grid-template-columns:1fr;gap:44px}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
    .about-split{grid-template-columns:1fr;gap:36px}
    .about-photo{min-height:240px}
  }
  @media(max-width:560px){
    .gs-grid{grid-template-columns:1fr}
    .acts .bbtn{width:100%;justify-content:center}
  }
</style>
</Layout>
