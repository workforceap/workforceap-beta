---
import Layout from '../layouts/Layout.astro';
import { PROGRAMS as CATALOG } from '../data/programs';
import { languageSupportLine } from '../data/languageSupport';
import Icon from '../components/Icon.astro';

// Card rows derive title/duration/partner/funding/skills from the
// canonical data file so the listing can never drift from the detail pages
// again (it did: three programs were renamed for TWC/EdVera alignment).
// Grouping, category labels, and icons stay page-local, keyed by slug.
const CATALOG_BY_SLUG = new Map(CATALOG.map((p) => [p.slug, p]));
function fundingLabel(source: string) {
  return source === 'WIOA' ? 'WIOA/Grant' : source;
}
function row(slug: string, category: string, cat: string, icon: string) {
  const p = CATALOG_BY_SLUG.get(slug);
  if (!p) throw new Error(`programs.astro: slug not in data/programs.ts: ${slug}`);
  return {
    slug,
    category,
    cat,
    icon,
    title: p.title,
    duration: p.duration,
    partner: p.partner,
    funding: fundingLabel(p.fundingSource ?? 'WIOA'),
    skills: p.skills.slice(0, 3),
    languages: languageSupportLine(p.languagesSupported),
    external: p.externalCourseUrl ?? '',
  };
}


// ── Quick-start lanes (verbatim from messages/en.json marketing.programs.quickStartCard*) ──
const lanes = [
  {
    eyebrow: 'Beginner-friendly',
    title: 'Digital Literacy',
    desc: 'Build confidence with computers, email, and online tools.',
    href: '/programs/digital-literacy-empowerment-class',
    cta: 'Start here',
  },
  {
    eyebrow: 'In-demand',
    title: 'IT Support',
    desc: 'Learn troubleshooting, networking, and security basics.',
    href: '/programs/it-support-professional-certificate-ibm',
    cta: 'View program',
  },
  {
    eyebrow: 'Business-friendly',
    title: 'Project Management',
    desc: 'No tech background required. Agile and Scrum skills that transfer across industries.',
    href: '/programs/project-management-professional-certificate-microsoft',
    cta: 'View program',
  },
];

// ── "How to choose" factors (verbatim labels + copy from marketing.programs.howToChooseFactor*) ──
const factors = [
  { label: 'Your interests', desc: 'What work feels natural or exciting to you?', icon: 'heart' },
  { label: 'Device access', desc: 'Some programs work on phones; others need a laptop.', icon: 'laptop' },
  { label: 'Time available', desc: 'Most programs need 5–10 hours per week for 3–5 months.', icon: 'clock' },
  { label: 'Earning goal', desc: 'Research pay for a specific occupation and location, then compare current job requirements.', icon: 'dollar' },
  { label: 'Growth path', desc: 'Some certificates lead directly to jobs; others are stepping stones.', icon: 'trending-up' },
];

// ── Enrollment-to-employment journey (verbatim marketing.programs.journeyStep*) ──
const journey = [
  { num: '1', title: 'Find your path', desc: 'Use the pathfinder to align your interests, timeline, and goals with the right program.' },
  { num: '2', title: 'Build skills', desc: 'Complete training at your own pace or in cohort and earn an industry-recognized certificate.' },
  { num: '3', title: 'Get job-ready', desc: 'Resume review, mock interviews, and practical prep for the roles you’re targeting.' },
  { num: '4', title: 'Connect to work', desc: 'Employer-facing support, job-search guidance, and help finding openings that match your training.' },
];

// ════════════════════════════════════════════════════════════════════
// FULL CATALOG — all 20 real programs from lib/content/programs.ts (PROGRAMS).
// Real titles / category labels / durations / partners / funding sources /
// skills (first 3). Occupational pay research is separate from program facts.
// Grouped by the real subgroups (lib/content/programSubgroup.ts) in real order.
// ════════════════════════════════════════════════════════════════════
type P = {
  slug: string; category: string; cat: string; icon: string; title: string;
  duration: string; partner: string; funding: string; skills: string[];
  languages: string | null; external: string;
};

// Category accent → blend pill class (crimson / gold / blue / green / neutral)
// c=IT&Cyber(crimson) g=AI/Business(gold) b=Cloud/Net(blue) gr=Digital(green) h=Healthcare(crimson) m=Manufacturing(neutral)
const subgroups: { id: string; label: string; description: string; programs: P[] }[] = [
  {
    id: 'digital-literacy',
    label: 'Digital Literacy',
    description: 'Foundational digital skills and confidence for today’s workplace.',
    programs: [
      row('digital-literacy-empowerment-class', 'Digital Literacy', 'gr', 'laptop'),
    ],
  },
  {
    id: 'it-support',
    label: 'IT Support',
    description: 'Help desk, hardware, and core IT pathways.',
    programs: [
      row('it-support-professional-certificate-ibm', 'IT & Cybersecurity', 'c', 'laptop'),
      row('it-support-and-entry-level-cyber-security-certificate', 'IT & Cybersecurity', 'c', 'shield'),
      row('comptia-a-professional-certificate', 'IT & Cybersecurity', 'c', 'shield'),
      row('comptia-network-professional-certificate', 'IT & Cybersecurity', 'c', 'shield'),
      row('comptia-security-professional-certificate', 'IT & Cybersecurity', 'c', 'shield'),
      row('cybersecurity-professional-certificate-google', 'IT & Cybersecurity', 'c', 'shield'),
    ],
  },
  {
    id: 'database',
    label: 'Database & Data Platforms',
    description: 'Data storage, analytics, and data-centric roles.',
    programs: [
      row('data-analytics-professional-certificate-google', 'Cloud & Data', 'g', 'bar-chart'),
      row('data-science-professional-certificate-ibm', 'Cloud & Data', 'g', 'bar-chart'),
      row('aws-cloud-technology-amazon', 'Cloud & Data', 'b', 'globe'),
    ],
  },
  {
    id: 'programming',
    label: 'Programming & Software',
    description: 'Software development, automation, and engineering tracks.',
    programs: [
      row('ai-practitioner-professional-certificate-aws', 'AI & Software Dev', 'g', 'sparkle'),
      row('software-developer-professional-certificate-ibm', 'AI & Software Dev', 'g', 'sparkle'),
      row('it-automation-with-python-google', 'IT & Cybersecurity', 'c', 'laptop'),
    ],
  },
  {
    id: 'web-programming',
    label: 'Web & Front End',
    description: 'Web technologies, UX, and product-facing builds.',
    programs: [
      row('ux-design-professional-certificate-google', 'Business', 'g', 'briefcase'),
    ],
  },
  {
    id: 'leadership',
    label: 'Leadership, Business, & Marketing',
    description: 'Project management, marketing, UX, and business skills.',
    programs: [
      row('project-management-professional-certificate-microsoft', 'Business', 'g', 'briefcase'),
      row('digital-marketing-e-commerce-google', 'Business', 'g', 'briefcase'),
    ],
  },
  {
    id: 'medical',
    label: 'Medical & Health IT',
    description: 'Healthcare information and coding pathways.',
    programs: [
      row('health-information-technology-mchit', 'Healthcare', 'gr', 'heart'),
    ],
  },
  {
    id: 'manufacturing-logistics',
    label: 'Manufacturing & Logistics',
    description: 'Production, supply chain, and technician credentials.',
    programs: [
      row('certified-production-technician-cpt', 'Manufacturing', 'm', 'building'),
      row('certified-logistics-technician-clt', 'Manufacturing', 'm', 'building'),
    ],
  },
  {
    id: 'construction',
    label: 'Construction & Trades',
    description: 'Safety, trades readiness, and construction fundamentals.',
    programs: [
      row('core-construction-training-certificate', 'Construction & Trades', 'm', 'building'),
    ],
  },
];

const subgroupsWithPrograms = subgroups.filter((s) => s.programs.length > 0);

const catalogSize = subgroupsWithPrograms.reduce((n, s) => n + s.programs.length, 0);

// Filter chips (real labels + counts from ProgramsContent.tsx)
const filterChips = [
  { label: `All programs (${catalogSize})`, cat: 'all', active: true },
  ...subgroupsWithPrograms
    .filter((s) => s.programs.length > 0)
    .map((s) => ({ label: `${s.id === 'digital-literacy' ? 'Digital Literacy' : s.id === 'it-support' ? 'IT Support' : s.id === 'database' ? 'Database' : s.id === 'programming' ? 'Programming' : s.id === 'web-programming' ? 'Web' : s.id === 'leadership' ? 'Leadership' : s.id === 'medical' ? 'Medical' : s.id === 'manufacturing-logistics' ? 'Mfg & Logistics' : s.id === 'construction' ? 'Construction' : 'Other'} (${s.programs.length})`, cat: s.id, active: false })),
];
---
<Layout
  title="Career Training Programs — Nationwide Certificates"
  description="Explore career training programs offered through Workforce Funded Training for qualified members, with industry certifications from IBM, Google, AWS, Microsoft, and CompTIA. Nationwide pathways supported by grants and partnerships."
>
<div class="progdepth">

<!-- ══════════════════════════════════════════════ HERO — DEPTH STAGE (shorter band) ══════════════════════════════════════════════ -->
<section class="stage">
  <div class="aura aura--1"></div>
  <div class="aura aura--2"></div>
  <div class="aura aura--3"></div>
  <div class="grain"></div>

  <div class="wrap stage-grid">
    <div class="lede">
      <span class="pill"><span class="pill__star"><Icon name="star" size={11} /></span>Career training programs</span>
      <h1>Find the right program <span class="shimmer">for your goals</span></h1>
      <p class="sub">Explore career training programs offered through Workforce Funded Training for qualified members, with certifications from IBM, Google, AWS, Microsoft, and CompTIA.</p>
      <div class="acts">
        <a class="dbtn dbtn--solid" href="#programs-quick-start">Quick start <span>→</span></a>
        <a class="dbtn dbtn--glass" href="/find-your-path">Find your path</a>
      </div>
    </div>

    <!-- glass stat card -->
    <div class="hero-glass">
      <div class="hg-tag">Recognized credentials</div>
      <div class="hg-logos">
        <span>IBM</span><span>Google</span><span>Microsoft</span><span>AWS</span><span>CompTIA</span>
      </div>
      <div class="hg-meter">
        <span>Programs in the catalog</span>
        <strong>{catalogSize}</strong>
      </div>
      <div class="hg-chips">
        <span>No cost to qualifying members</span>
        <span>WIOA &amp; grant funded</span>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════ QUICK START — lanes that fit you best ══════════════════════════════════════════════ -->
<section class="band band--surface" id="programs-quick-start"><div class="wrap">
  <div class="sec-head qs-head">
    <div>
      <span class="eyebrow">Quick start</span>
      <h2>Start with the lane that <span class="grad-text">fits you best.</span></h2>
    </div>
    <a class="qs-link" href="/find-your-path">Not sure? Take the 2-minute pathfinder&nbsp;→</a>
  </div>
  <div class="tri">
    {lanes.map((l) => (
      <a class="acard" href={l.href}>
        <span class="eyebrow" style="margin-bottom:14px">{l.eyebrow}</span>
        <h3>{l.title}</h3>
        <p>{l.desc}</p>
        <span style="font-weight:700;color:var(--crimson)">{l.cta} →</span>
      </a>
    ))}
  </div>
</div></section>

<!-- ══════════════════════════════════════════════ TOOL ROUTING ══════════════════════════════════════════════ -->
<section class="band" style="padding-bottom:0"><div class="wrap">
  <div class="tools-row">
    <a class="btn btn--primary" href="/find-your-path">Not sure? Take the 2-minute pathfinder</a>
    <a class="btn btn--ghost" href="/program-comparison">Compare Programs</a>
    <a class="btn btn--ghost" href="/salary-guide">Research pay and job requirements</a>
  </div>
</div></section>

<!-- ══════════════════════════════════════════════ HOW TO CHOOSE ══════════════════════════════════════════════ -->
<section class="band"><div class="wrap">
  <div class="sec-head">
    <span class="eyebrow">Decision guide</span>
    <h2>How to <span class="grad-text">choose a program</span></h2>
    <p>Pick what fits your life: your current skills, how much time you have, and the kind of work you want.</p>
  </div>
  <div class="choose">
    {factors.map((f) => (
      <div class="fcard">
        <div class="fic"><Icon name={f.icon} size={22} /></div>
        <h3>{f.label}</h3>
        <p>{f.desc}</p>
      </div>
    ))}
  </div>
  <p class="truth">Still unsure? <a href="/find-your-path">The pathfinder guide helps in about two minutes.</a></p>
</div></section>

<!-- ══════════════════════════════════════════════ PROGRAM CATALOG ══════════════════════════════════════════════ -->
<section class="band band--surface" id="program-catalog"><div class="wrap">
  <div class="sec-head" style="text-align:left;align-items:flex-start;max-width:42rem">
    <h2 style="margin-bottom:8px">Browse all {catalogSize} programs</h2>
    <p>Search by name, skill, partner, or topic — or browse by category.</p>
  </div>

  <!-- Live search + category filter (progressive enhancement; works once JS loads) -->
  <div class="catalog-controls">
    <label class="searchbox" for="prog-search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <input id="prog-search" type="search" autocomplete="off" placeholder="Search programs by name, skill, partner, or topic…" aria-label="Search programs" />
    </label>
    <div class="chips" role="group" aria-label="Filter programs by category">
      {filterChips.map((c) => (
        <button type="button" class={c.active ? 'chip active' : 'chip'} data-cat={c.cat} aria-pressed={c.active ? 'true' : 'false'}>{c.label}</button>
      ))}
    </div>
  </div>
  <p class="no-results" hidden>No programs match your search. <button type="button" class="linkbtn" id="clear-filters">Clear filters</button></p>

  <!-- All programs, grouped by real subgroup (fully expanded) -->
  <div id="all-programs"></div>
  {subgroupsWithPrograms.map((sg) => (
    <section class="subgroup" id={`subgroup-${sg.id}`} data-cat={sg.id}>
      <div class="subgroup-head">
        <h3>{sg.label}</h3>
        <span class="subgroup-count">{sg.programs.length} program{sg.programs.length !== 1 ? 's' : ''}</span>
      </div>
      <p class="subgroup-desc">{sg.description}</p>
      <div class="pgrid">
        {sg.programs.map((p) => (
          <div class="pcard" data-cat={sg.id} data-text={`${p.title} ${p.skills.join(' ')} ${p.partner} ${p.category} ${p.languages ?? ''}`.toLowerCase()}>
            <div class="pcard-top">
              <div class="ptags">
                <span class={`cat-pill cat--${p.cat}`}>{p.category}</span>
                <span class="fund-pill">{p.funding}</span>
              </div>
              <span class="picon"><Icon name={p.icon} size={26} /></span>
            </div>
            <h4>{p.title}</h4>
            <div class="pmeta"><span><Icon name="clock" size={16} /> {p.duration}</span></div>
            {p.languages ? <p class="plang">Languages: {p.languages}</p> : null}
            <div class="pskills">{p.skills.map((s) => <span class="stag">{s}</span>)}</div>
            <div class="pcard-foot">
              <span class="ppartner">Partner: {p.partner}</span>
              <div class="pacts">
                <a class="btn btn--ghost btn--sm" href={`/programs/${p.slug}`}>View Program</a>
                {p.external
                  ? <a class="btn btn--primary btn--sm" href={p.external} target="_blank" rel="noopener noreferrer">Start the free course →</a>
                  : <a class="btn btn--primary btn--sm" href={`/apply?program=${p.slug}`}>Get Started →</a>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <p class="catalog-foot">Compare course content and preparation before applying. Use the career research guide to check occupational pay and local job requirements with public sources.</p>
  <div class="catalog-actions">
    <a class="btn btn--primary" href="/find-your-path">Find Your Path — Take the Quiz</a>
    <a class="btn btn--ghost" href="/program-comparison">Compare Programs</a>
    <a class="btn btn--ghost" href="/salary-guide">Research pay and job requirements</a>
  </div>
</div></section>

<script is:inline>
  // Live program search + category filter (progressive enhancement).
  (function () {
    var input = document.getElementById('prog-search');
    var chips = Array.prototype.slice.call(document.querySelectorAll('.chips .chip'));
    var sections = Array.prototype.slice.call(document.querySelectorAll('#all-programs ~ .subgroup, .subgroup[data-cat]'));
    var cards = Array.prototype.slice.call(document.querySelectorAll('.subgroup[data-cat] .pcard'));
    var noResults = document.querySelector('.no-results');
    var clearBtn = document.getElementById('clear-filters');
    if (!input || !cards.length) return;
    var activeCat = 'all';

    function apply() {
      var q = (input.value || '').trim().toLowerCase();
      var shown = 0;
      cards.forEach(function (card) {
        var okCat = activeCat === 'all' || card.getAttribute('data-cat') === activeCat;
        var okText = !q || (card.getAttribute('data-text') || '').indexOf(q) !== -1;
        var vis = okCat && okText;
        card.hidden = !vis;
        if (vis) shown++;
      });
      sections.forEach(function (sec) {
        var any = sec.querySelector('.pcard:not([hidden])');
        sec.hidden = !any;
      });
      if (noResults) noResults.hidden = shown !== 0;
    }

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        activeCat = chip.getAttribute('data-cat') || 'all';
        chips.forEach(function (c) {
          var on = c === chip;
          c.classList.toggle('active', on);
          c.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        apply();
      });
    });
    input.addEventListener('input', apply);
    if (clearBtn) clearBtn.addEventListener('click', function () {
      input.value = ''; activeCat = 'all';
      chips.forEach(function (c) {
        var on = c.getAttribute('data-cat') === 'all';
        c.classList.toggle('active', on); c.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      apply(); input.focus();
    });
  })();
</script>

<!-- ══════════════════════════════════════════════ JOURNEY — 4-step flow ══════════════════════════════════════════════ -->
<section class="band band--surface"><div class="wrap">
  <div class="sec-head" style="max-width:660px">
    <span class="eyebrow">The journey</span>
    <h2>From enrollment to <span class="grad-text">employment</span></h2>
    <p>WorkforceAP supports members at every step, from choosing a program to preparing for the job search in your field.</p>
  </div>
  <div class="steps">
    {journey.map((s) => (
      <div class="stepcard"><div class="num">0{s.num}</div><h3>{s.title}</h3><p>{s.desc}</p></div>
    ))}
  </div>
</div></section>

<!-- ══════════════════════════════════════════════ CLOSING CTA — DEPTH crimson band ══════════════════════════════════════════════ -->
<section class="close">
  <div class="close__media" aria-hidden="true"></div>
  <div class="close__veil" aria-hidden="true"></div>
  <div class="close__inner wrap">
    <span class="pill pill--solid"><span class="pill__star"><Icon name="star" size={11} /></span>Reviewed by a real team — decision by email</span>
    <h2>Ready to start?</h2>
    <p>Apply in minutes. A member advisor reviews every application and follows up by email.</p>
    <div class="acts acts--center">
      <a class="bbtn bbtn--gold" href="/apply">Apply Now →</a>
      <a class="bbtn bbtn--outline" href="/find-your-path">Find your path</a>
    </div>
  </div>
</section>

</div>

<style>
  /* ===================================================================
     PROGRAMS — DEPTH aesthetic (matches home index.astro).
     depth stage hero + glass card → light alternating bands w/ existing
     catalog cards → depth crimson closing CTA.
     =================================================================== */
  .progdepth{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}

  /* ---------------- DEPTH HERO STAGE (shorter band) ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:84px 0 92px;
  }
  .stage-grid{display:grid;grid-template-columns:1.06fr .94fr;gap:56px;align-items:center;position:relative;z-index:2}

  /* glow auras — gold + crimson + white */
  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:520px;height:520px;top:-170px;right:-120px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:460px;height:460px;bottom:-200px;left:-140px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:360px;height:360px;top:24%;left:44%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%)}

  /* luminosity-masked real photo bleeding in from the right */
  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:soft-light;pointer-events:none;
    background-image:var(--wap-hero-photo-url);background-size:cover;background-position:center 35%;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,rgba(0,0,0,.35) 28%,#000 72%);
    mask-image:linear-gradient(90deg,transparent 0%,rgba(0,0,0,.35) 28%,#000 72%);opacity:.42}

  /* gold PILL — fully visible, never clipped */
  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:var(--grad-gold);color:var(--gold-ink);font-weight:800;font-size:13px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{font-size:13px;opacity:.95}
  @media(max-width:430px){.pill{white-space:normal;text-align:left}}

  .lede h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(38px,5.4vw,64px);
    line-height:1.04;letter-spacing:-.03em;margin:22px 0 0}
  .shimmer{background:var(--grad-gold-shimmer);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .lede .sub{font-size:19px;line-height:1.55;color:rgba(255,255,255,.82);max-width:34em;margin:22px 0 30px}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}

  /* hero glass stat card */
  .hero-glass{position:relative;border-radius:22px;padding:28px;
    background:rgba(255,255,255,.13);border:1px solid var(--glass-line);backdrop-filter:blur(18px);
    box-shadow:var(--shadow-glass);color:#fff}
  .hg-tag{font-size:13px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.72);margin-bottom:14px}
  .hg-logos{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:20px}
  .hg-logos span{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:15px;color:rgba(255,255,255,.92);
    background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.16);padding:6px 12px;border-radius:10px}
  .hg-meter{display:flex;align-items:baseline;justify-content:space-between;padding:14px 16px;border-radius:13px;
    background:rgba(0,0,0,.18);border:1px solid rgba(255,255,255,.12);margin-bottom:14px}
  .hg-meter span{font-size:13px;color:rgba(255,255,255,.8)}
  .hg-meter strong{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:34px;color:var(--gold-glow);line-height:1}
  .hg-chips{display:flex;flex-wrap:wrap;gap:8px}
  .hg-chips span{font-size:13px;font-weight:700;padding:6px 12px;border-radius:999px;
    background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18)}

  /* ---------------- LIGHT BODY BANDS ---------------- */
  .band{padding:var(--sec-pad) 0}
  .band--surface{background:var(--surface)}

  .sec-head{max-width:720px;margin:0 auto 44px;text-align:center;display:flex;flex-direction:column;align-items:center}
  .sec-head h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(30px,4.4vw,48px);line-height:1.05;letter-spacing:-.02em;margin-bottom:12px}
  .sec-head p{color:var(--muted);font-size:19px;line-height:1.55}
  .eyebrow{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--crimson);margin-bottom:14px}

  /* quick-start head row */
  .qs-head{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;text-align:left;flex-wrap:wrap;max-width:none}
  .qs-head h2{margin-top:6px}
  /* Wraps on phones (WAP-208): nowrap ran the 45-character link 8px past a
     390px screen, where body overflow-x:hidden clipped the arrow. The arrow
     stays glued to "pathfinder" with a no-break space in the markup. */
  .qs-link{font-weight:700;color:var(--crimson);white-space:nowrap}
  @media(max-width:620px){.qs-link{white-space:normal;max-width:100%}}

  /* shared tri-card grid (quick start lanes) */
  .tri{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .acard{display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
    padding:30px 28px;box-shadow:var(--shadow);border-top:6px solid var(--crimson);transition:transform .2s,box-shadow .25s}
  .acard:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}
  .acard h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:22px;font-weight:800;margin-bottom:10px}
  .acard p{color:var(--muted);font-size:16px;line-height:1.55;margin-bottom:20px}
  @media(max-width:880px){.tri{grid-template-columns:1fr}}

  /* tool routing */
  .tools-row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}

  /* how-to-choose grid */
  .choose{display:grid;grid-template-columns:repeat(5,1fr);gap:18px}
  .fcard{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:24px;box-shadow:var(--shadow)}
  .fcard .fic{width:46px;height:46px;border-radius:12px;background:rgba(173,44,77,.1);display:grid;place-items:center;margin-bottom:14px;color:var(--crimson)}
  .fcard h3{font-size:16px;font-weight:700;margin-bottom:6px}
  .fcard p{color:var(--muted);font-size:14px}
  @media(max-width:980px){.choose{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:620px){.choose{grid-template-columns:1fr 1fr}}

  .truth{max-width:720px;margin:36px auto 0;text-align:center;color:var(--muted);font-size:14px;
    background:var(--surface-2);border:1px dashed var(--border);border-radius:14px;padding:18px 22px}
  .truth a{color:var(--crimson);font-weight:800}

  /* catalog controls */
  .catalog-controls{margin-bottom:30px}
  .searchbox{display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:14px 18px;color:var(--muted);box-shadow:var(--shadow);margin:0 0 18px;cursor:text}
  .searchbox:focus-within{border-color:var(--crimson);box-shadow:0 0 0 3px rgba(173,44,77,.1)}
  .searchbox input{flex:1;min-width:0;border:0;background:transparent;outline:none;font:inherit;font-size:15px;color:var(--text)}
  .searchbox input::placeholder{color:var(--muted)}
  /* Row gap 0 and a -5px block margin (WAP-209): the 44px chip boxes carry
     5px of transparent hit area above and below each 34px pill, so wrapped
     pills stay 10px apart and the group keeps its old outer spacing. */
  .chips{display:flex;flex-wrap:wrap;gap:0 10px;margin-block:-5px}
  /* 44px tap target, 34px pill (WAP-209): the button is the full 44px hit
     area and stays transparent; the visible pill is its ::before, inset 5px
     top and bottom, so the chips look exactly as before. */
  .chip{position:relative;isolation:isolate;min-height:44px;font-size:14px;font-weight:600;padding:0 17px;border:0;border-radius:999px;background:transparent;color:var(--muted);cursor:pointer;transition:color .15s}
  .chip::before{content:"";position:absolute;inset:5px 0;z-index:-1;border-radius:999px;background:var(--surface);border:1px solid var(--border);transition:border-color .15s,background .15s}
  .chip:hover{color:var(--crimson)}
  .chip:hover::before{border-color:var(--crimson)}
  .chip.active{color:#fff}
  .chip.active::before{background:var(--grad);border-color:transparent}
  .chip.active:hover{color:#fff}
  .no-results{margin:0 0 24px;color:var(--muted);font-size:15px}
  .linkbtn{background:none;border:0;color:var(--crimson);font:inherit;font-weight:700;cursor:pointer;text-decoration:underline;padding:0}


  /* subgroup sections */
  .subgroup{margin-bottom:40px;padding-bottom:32px;border-bottom:1px solid var(--border);scroll-margin-top:6rem}
  .subgroup:last-of-type{border-bottom:none}
  .subgroup-head{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
  .subgroup-head h3{font-size:22px;font-weight:800}
  .subgroup-count{font-size:14px;color:var(--muted);font-weight:500}
  .subgroup-desc{font-size:15px;color:var(--muted);max-width:42rem;margin:6px 0 20px}

  /* program cards */
  .pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  @media(max-width:980px){.pgrid{grid-template-columns:1fr 1fr}}
  @media(max-width:680px){.pgrid{grid-template-columns:1fr}}
  /* Categories with only 1-2 programs shouldn't stretch cards across the full
     3-col row — that leaves a large dead-space rectangle beside the card(s). */
  .pgrid:has(.pcard:only-child){grid-template-columns:minmax(0,380px)}
  .pgrid:has(.pcard:nth-child(2):last-child){grid-template-columns:repeat(2,minmax(0,380px))}
  .pcard{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:24px;box-shadow:var(--shadow);display:flex;flex-direction:column;transition:transform .18s,box-shadow .2s}
  /* Search/filter state uses the native hidden attribute. Keep that state
     stronger than the card's flex layout so nonmatches leave the layout. */
  .pcard[hidden]{display:none}
  .pcard:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
  .pcard-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px}
  .ptags{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .cat-pill{color:#fff;padding:5px 12px;border-radius:999px;font-size:13px;font-weight:700}
  .cat--c{background:var(--crimson)}.cat--g{background:var(--gold-dark)}.cat--b{background:var(--blue)}.cat--gr{background:#2f7a34}.cat--m{background:#3a3a3a}
  .fund-pill{font-size:13px;font-weight:700;padding:5px 12px;border-radius:999px;background:rgba(74,155,79,.12);color:#2f6b34}
  .picon{color:var(--crimson)}
  .pcard h4{font-size:18px;font-weight:700;margin-bottom:10px;min-height:3.6em}
  .pmeta{display:flex;flex-wrap:wrap;gap:14px;font-size:14px;color:var(--muted);margin-bottom:8px}
  .pmeta span{display:inline-flex;align-items:center;gap:6px}
  .plang{font-size:13px;color:var(--muted);line-height:1.4;margin:0 0 12px}
  .prange-inline b{color:var(--crimson)}
  .pdisc{font-size:13px;color:var(--muted);margin-bottom:14px;line-height:1.45}
  .pskills{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:18px}
  .stag{background:var(--surface-2);border:1px solid var(--border);color:var(--text);padding:4px 10px;border-radius:6px;font-size:13px}
  .pcard-foot{margin-top:auto;padding-top:16px;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:12px}
  .ppartner{font-size:13px;color:var(--muted)}
  .pacts{display:flex;flex-wrap:wrap;gap:8px}
  .btn--sm{padding:12px 16px;font-size:14px;min-height:44px;justify-content:center}

  .catalog-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:24px}
  .catalog-foot{text-align:center;margin-top:28px;font-size:13px;color:var(--muted);max-width:640px;margin-left:auto;margin-right:auto}

  /* journey steps */
  .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
  .stepcard{position:relative;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:28px;box-shadow:var(--shadow);transition:transform .2s,box-shadow .25s}
  .stepcard:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}
  .stepcard .num{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:30px;
    background:var(--grad-text);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:12px;line-height:1}
  .stepcard h3{font-size:18px;font-weight:800;margin-bottom:8px}
  .stepcard p{color:var(--muted);font-size:15px;line-height:1.55}
  @media(max-width:900px){.steps{grid-template-columns:1fr 1fr}}
  @media(max-width:520px){.steps{grid-template-columns:1fr}}

  /* ---------------- DEPTH CLOSING CTA (full-bleed crimson) ---------------- */
  .close{
    position:relative;overflow:hidden;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
  }
  .close__media{position:absolute;inset:0;background:var(--wap-hero-photo-url-3) center 40%/cover no-repeat}
  .close__veil{position:absolute;inset:0;background:var(--wap-hero-close-veil)}
  .close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:88px 24px 96px;max-width:var(--max)}
  .pill--solid{margin-bottom:24px}
  .close__inner h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(34px,5.5vw,64px);line-height:.98;letter-spacing:-.03em;margin-bottom:18px}
  .close__inner p{font-size:clamp(17px,2.2vw,21px);color:rgba(255,255,255,.92);max-width:38em;margin:0 auto 30px;line-height:1.5}

  /* ---------------- RESPONSIVE ---------------- */
  @media(max-width:880px){
    .stage{padding:64px 0 76px}
    .stage-grid{grid-template-columns:1fr;gap:44px}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
  }
  @media(max-width:560px){
    .acts .bbtn{width:100%;justify-content:center}
  }
</style>
</Layout>
</output>
