---
import Layout from '../layouts/Layout.astro';

// Date this accessibility statement was last reviewed end-to-end.
const ACCESSIBILITY_LAST_REVIEWED_AT = '2026-05-19';
const lastReviewed = new Date(ACCESSIBILITY_LAST_REVIEWED_AT + 'T00:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---
<Layout
  title="Accessibility Statement"
  description="Read Workforce Advancement Project accessibility commitments, our WCAG 2.1 AA target, known exceptions, and how to report an accessibility barrier."
>
<div class="a11y">

  <!-- ============================================================
       HERO — DEPTH STAGE (shorter): deep radial crimson→plum band,
       gold/crimson/white glow auras, luminosity-masked photo,
       white text, gold pill + a translucent glass card.
       ============================================================ -->
  <section class="stage">
    <div class="aura aura--1"></div>
    <div class="aura aura--2"></div>
    <div class="aura aura--3"></div>
    <div class="grain"></div>

    <div class="wrap stage-grid">
      <div class="lede">
        <span class="pill"><span class="pill__star" aria-hidden="true">★</span>Accessibility</span>
        <h1>Accessibility Statement</h1>
        <p class="intro">Workforce Advancement Project works to make this site easier to use for members, partners, employers, and community supporters. We aim to provide clear content, readable layouts, keyboard-usable navigation, and mobile-friendly access on slow devices and limited connections.</p>
        <p class="reviewed">Last reviewed: {lastReviewed}</p>
      </div>

      <!-- translucent glass card: conformance target at a glance -->
      <div class="hero-card" aria-hidden="true">
        <div class="hc-tag">Our target</div>
        <div class="hc-big">WCAG 2.1<br><span>Level AA</span></div>
        <div class="hc-row">
          <span class="hc-chip">Public site</span>
          <span class="hc-chip">Member portal</span>
        </div>
        <div class="hc-meter">
          <span>Tested on every pull request</span>
          <strong><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></strong>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="band band--surface">
    <div class="wrap">
      <div class="a11y-stack">
        <!-- Conformance commitment -->
        <article class="acard a11y-card">
          <div class="a11y-head">
            <span class="ic ic--c" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M12 3l8 4v5c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V7z"/></svg>
            </span>
            <h2>Our conformance commitment</h2>
          </div>
          <p>We target conformance with the Web Content Accessibility Guidelines (WCAG) 2.1 Level AA across both the public marketing site and the member portal. That includes meaningful page structure, descriptive link text, keyboard operability, sufficient color contrast, alternative text for informational images, captions or transcripts for prerecorded media we publish, and form fields with associated labels and error messaging that screen readers can announce.</p>
          <p>We test against this target with automated tooling on every pull request and with periodic manual screen-reader review. Where a third-party component or partner system is embedded in our pages, we work with that provider to surface accessibility issues to them and to substitute components when a fix is not available.</p>
        </article>

        <!-- Known exceptions -->
        <article class="acard a11y-card">
          <div class="a11y-head">
            <span class="ic ic--g" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
            </span>
            <h2>Known exceptions we are actively fixing</h2>
          </div>
          <p>We track every known accessibility gap. The following items are open as of the last reviewed date above and are on our active burn-down list:</p>
          <ul class="a11y-list">
            <li>A small number of admin-only data tables are rendered as bare HTML tables without full header semantics. These are not member-facing. Tracked in our internal QA queue and being migrated to our standard accessible table component.</li>
            <li>One marketing image is missing meaningful alternative text and is currently presented as decorative. Replacement copy is queued for the next content review.</li>
            <li>Some AI-generated outputs (resume drafts, interview feedback) may not yet include landmark structure consistent with the rest of the portal. We are adding semantic wrappers to the AI-tool result views.</li>
          </ul>
        </article>

        <!-- Help -->
        <article class="acard a11y-card">
          <div class="a11y-head">
            <span class="ic ic--b" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </span>
            <h2>If you need help using this site</h2>
          </div>
          <p>If you run into a barrier while using WorkforceAP.org — anything that prevents you from completing an application, reading content, or using a tool — please contact us. We will respond within five business days and will do our best to provide the information or support you need in another format while we work on a permanent fix.</p>
          <ul class="a11y-contact">
            <li><span class="lab">Email:</span> <a href="mailto:info@workforceap.org">info@workforceap.org</a></li>
            <li><span class="lab">Phone:</span> <a href="tel:+15127771808">(512) 777-1808</a></li>
            <li><span class="lab">Form:</span> <a href="/contact?topic=accessibility">Report an accessibility issue via our contact form</a></li>
          </ul>
        </article>

        <!-- Ongoing improvements -->
        <article class="acard a11y-card">
          <div class="a11y-head">
            <span class="ic ic--gr" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg>
            </span>
            <h2>Ongoing improvements</h2>
          </div>
          <p>We continue improving content clarity, color contrast, tap targets, and responsive behavior across public and member-facing pages. New components ship with an accessibility review checklist; existing surfaces are audited on a rolling basis.</p>
          <p>If something is hard to read, navigate, or complete, please tell us. That feedback helps us improve access for the people this work is meant to serve.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CLOSING CTA — BOLD full-bleed crimson, photo luminosity.
       ============================================================ -->
  <section class="close">
    <div class="close__media" aria-hidden="true"></div>
    <div class="close__veil" aria-hidden="true"></div>
    <div class="close__inner wrap">
      <span class="pill pill--solid"><span class="pill__star" aria-hidden="true">★</span>We respond within five business days</span>
      <h2>If something is hard to read,<br><span class="gold">navigate, or complete.</span></h2>
      <p>Please tell us. That feedback helps us improve access for the people this work is meant to serve.</p>
      <div class="acts acts--center">
        <a class="bbtn bbtn--gold" href="mailto:info@workforceap.org">info@workforceap.org</a>
        <a class="bbtn bbtn--outline" href="/contact?topic=accessibility">Report an accessibility issue via our contact form</a>
      </div>
    </div>
  </section>

</div>

<style>
  /* ===================================================================
     ACCESSIBILITY — DEPTH-LED restyle.
     shorter depth stage hero → light card stack → bold crimson CTA.
     =================================================================== */
  .a11y{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}

  /* ---------------- DEPTH HERO STAGE (shorter) ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:84px 0 92px;
  }
  .stage-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center;position:relative;z-index:2}

  /* glow auras — gold + crimson + white */
  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:520px;height:520px;top:-160px;right:-120px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:460px;height:460px;bottom:-200px;left:-140px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:380px;height:380px;top:30%;left:42%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%)}

  /* luminosity-masked real photo bleeding in from the right */
  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:overlay;pointer-events:none;
    background-image:var(--wap-hero-photo-url);background-size:cover;background-position:center;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 38%,#000 100%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 38%,#000 100%);opacity:.18}

  /* gold PILL — fully visible, never clipped */
  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:linear-gradient(135deg,#e3bd6a,#a47f38);color:#3a2c10;font-weight:800;font-size:13px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{font-size:13px;opacity:.95}
  @media(max-width:430px){.pill{white-space:normal;text-align:left}}

  .lede h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(38px,5.4vw,62px);
    line-height:1.03;letter-spacing:-.03em;margin:20px 0 0}
  .lede .intro{font-size:19px;line-height:1.55;color:rgba(255,255,255,.86);max-width:50em;margin:20px 0 0}
  .lede .reviewed{margin-top:16px;font-size:14px;color:rgba(255,255,255,.78)}

  /* ---------------- HERO GLASS CARD ---------------- */
  .hero-card{position:relative;border-radius:22px;padding:28px;
    background:rgba(255,255,255,.13);border:1px solid var(--glass-line);backdrop-filter:blur(18px);
    box-shadow:var(--shadow-glass);color:#fff}
  .hc-tag{font-size:13px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.72);margin-bottom:12px}
  .hc-big{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:34px;line-height:1.05;letter-spacing:-.02em}
  .hc-big span{background:linear-gradient(100deg,#fff,#f3d28f);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .hc-row{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0}
  .hc-chip{font-size:13px;font-weight:700;padding:6px 12px;border-radius:999px;
    background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18)}
  .hc-meter{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border-radius:13px;
    background:rgba(0,0,0,.18);border:1px solid rgba(255,255,255,.12)}
  .hc-meter span{font-size:13px;color:rgba(255,255,255,.82)}
  .hc-meter strong{flex-shrink:0;width:34px;height:34px;border-radius:10px;display:grid;place-items:center;
    background:rgba(74,155,79,.32);border:1px solid rgba(120,220,130,.4);color:#caffce;font-weight:800;font-size:16px}

  /* ---------------- LIGHT CONTENT BAND ---------------- */
  .band{padding:var(--sec-pad) 0}
  .band--surface{background:var(--surface)}

  .a11y-stack { display: flex; flex-direction: column; gap: 22px; max-width: 860px; margin: 0 auto; }
  .acard{background:color-mix(in srgb,var(--crimson) 5%,var(--bg));border:1px solid var(--border);border-radius:var(--radius);padding:34px 32px;
    box-shadow:var(--shadow);border-left:4px solid var(--crimson);transition:transform .2s,box-shadow .25s}
  .acard:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
  .a11y-card:nth-child(2){border-left-color:var(--gold);background:color-mix(in srgb,var(--gold) 5%,var(--bg))}
  .a11y-card:nth-child(3){border-left-color:var(--blue);background:color-mix(in srgb,var(--blue) 5%,var(--bg))}
  .a11y-card:nth-child(4){border-left-color:var(--green);background:color-mix(in srgb,var(--green) 5%,var(--bg))}

  .a11y-card .a11y-head { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
  .a11y-card .a11y-head h2 { font-family:'Plus Jakarta Sans',sans-serif; font-size: clamp(21px, 2.6vw, 27px); font-weight: 800; letter-spacing:-.01em; }
  .a11y-card .ic { margin-bottom: 0; flex-shrink: 0; width:44px; height:44px; border-radius:13px; display:grid; place-items:center; }
  .ic--c{background:rgba(173,44,77,.12);color:var(--crimson)}
  .ic--g{background:rgba(164,127,56,.14);color:var(--gold-dark)}
  .ic--b{background:rgba(43,123,185,.12);color:var(--blue)}
  .ic--gr{background:rgba(74,155,79,.14);color:var(--green)}
  .a11y-card p { color: var(--muted); font-size: 16px; line-height:1.6; margin-bottom: 14px; }
  .a11y-card p:last-child { margin-bottom: 0; }

  .a11y-list { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .a11y-list li { position: relative; padding-left: 26px; color: var(--muted); font-size: 16px; line-height:1.6; }
  .a11y-list li::before { content: ""; position: absolute; left: 0; top: 9px; width: 9px; height: 9px; border-radius: 50%; background: var(--gold-dark); }

  .a11y-contact { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-top: 4px; }
  .a11y-contact li { display: flex; gap: 8px; font-size: 16px; flex-wrap: wrap; }
  .a11y-contact .lab { min-width: 56px; font-weight: 700; color: var(--text); }
  .a11y-contact a { color: var(--crimson); font-weight: 700; }
  .a11y-contact a:hover { text-decoration: underline; }

  /* ---------------- BOLD FULL-BLEED CLOSING CTA ---------------- */
  .close{position:relative;overflow:hidden;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw}
  .close__media{position:absolute;inset:0;background:var(--wap-hero-photo-url-3) center 40%/cover no-repeat}
  .close__veil{position:absolute;inset:0;
    background:var(--wap-hero-close-veil)}
  .close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:84px 24px 92px;max-width:var(--max)}
  .pill--solid{margin-bottom:24px}
  .close__inner h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(32px,5vw,58px);line-height:1;letter-spacing:-.03em;margin-bottom:18px}
  .gold{color:#e9c879}
  .close__inner p{font-size:clamp(17px,2.2vw,21px);color:rgba(255,255,255,.92);max-width:38em;margin:0 auto 30px;line-height:1.5}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}

  /* ---------------- RESPONSIVE ---------------- */
  @media(max-width:880px){
    .stage{padding:64px 0 72px}
    .stage-grid{grid-template-columns:1fr;gap:40px}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
  }
  @media (max-width: 560px) {
    .band{padding:60px 0}
    .acard{padding:28px 24px}
    .a11y-card .a11y-head { align-items: flex-start; }
    .acts .bbtn{width:100%;justify-content:center}
  }
</style>
</Layout>
