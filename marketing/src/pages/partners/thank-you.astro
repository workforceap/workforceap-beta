---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

// ── Content mirrored verbatim from messages/en.json → marketing.thankYou.partners ──
// (Next route: app/partners/thank-you/page.tsx → ConversionThankYouPage funnel="partners")
const title = 'Welcome aboard.';
const lead = 'Our partnerships team reviews every request and will reach out by email.';

const bullets = [
  { icon: 'check-circle', title: 'Account review', desc: 'We verify your organization details and referral capacity.' },
  { icon: 'unlock', title: 'Portal activation', desc: "You'll get login access to track referrals, progress, and placements." },
  { icon: 'calendar', title: 'Onboarding call', desc: 'A quick walkthrough of referral workflows and support resources.' },
];

const resource = { label: 'Partner referral flyer', href: '/partner-resources/partner-referral-flyer.html' };

const ctas = [
  { label: 'Open partner portal', href: '/partner', variant: 'solid' },
  { label: 'Partner overview', href: '/partners', variant: 'glass' },
  { label: 'Back to home', href: '/', variant: 'muted' },
];
---
<Layout
  title="Partner signup received"
  description="Thanks for signing up. We will activate your partner portal soon."
>
<meta slot="head" name="robots" content="noindex, nofollow" />
<div class="ptdepth">

  <!-- ══════════════ HERO — DEPTH STAGE ══════════════ -->
  <section class="stage">
    <div class="aura aura--1"></div>
    <div class="aura aura--2"></div>
    <div class="aura aura--3"></div>
    <div class="grain"></div>

    <div class="wrap stage-grid">
      <div class="lede">
        <span class="pill"><span class="pill__star"><Icon name="check-circle" size={13} /></span>Partner signup received</span>
        <h1>{title.replace(/\.$/, '')}<span class="shimmer">.</span></h1>
        <p class="sub">{lead}</p>
        <div class="acts">
          {ctas.map((c) => (
            c.variant === 'solid'
              ? <a class="dbtn dbtn--solid" href={c.href}>{c.label} <span>→</span></a>
              : c.variant === 'glass'
                ? <a class="dbtn dbtn--glass" href={c.href}>{c.label}</a>
                : <a class="dbtn dbtn--glass dbtn--muted" href={c.href}>{c.label}</a>
          ))}
        </div>
      </div>

      <!-- What happens next — translucent glass card -->
      <div class="nextglass">
        <span class="ng-eyebrow"><span class="ng-dot"></span>What happens next</span>
        <h2>Your next steps</h2>
        <ul class="ng-list">
          {bullets.map((b) => (
            <li>
              <span class="ng-ic"><Icon name={b.icon} size={18} /></span>
              <div>
                <span class="ng-t">{b.title}</span>
                <span class="ng-d">{b.desc}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════════ RESOURCE BAND ══════════════ -->
  <section class="band band--surface"><div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Resource</span>
      <h2>Take this with <span class="grad-text">you.</span></h2>
      <p>A handout to share referral details with your team while we activate your portal.</p>
    </div>
    <a class="resource" href={resource.href} target="_blank" rel="noopener noreferrer">
      <span class="resource-ic"><Icon name="file-text" size={26} /></span>
      <span class="resource-body">
        <span class="resource-t">{resource.label}</span>
        <span class="resource-d">Opens in a new tab</span>
      </span>
      <span class="resource-go">Download →</span>
    </a>
  </div></section>

  <!-- ══════════════ CLOSING CTA — DEPTH crimson band ══════════════ -->
  <section class="close">
    <div class="close__media" aria-hidden="true"></div>
    <div class="close__veil" aria-hidden="true"></div>
    <div class="close__inner wrap">
      <span class="pill pill--solid"><span class="pill__star"><Icon name="handshake" size={11} /></span>Reviewed by a real team — decision by email</span>
      <h2>Welcome to the network.</h2>
      <p>Open your partner portal to track referrals, or revisit the partner overview while we get you set up.</p>
      <div class="acts acts--center">
        <a class="bbtn bbtn--gold" href="/partner">Open partner portal →</a>
        <a class="bbtn bbtn--outline" href="/partners">Partner overview</a>
      </div>
    </div>
  </section>

</div>

<style>
  /* ===================================================================
     PARTNERS — THANK YOU — DEPTH aesthetic (matches programs/how-it-works).
     depth stage hero + glass "next steps" card → light resource band →
     depth crimson closing CTA.
     =================================================================== */
  .ptdepth{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}

  /* ---------------- DEPTH HERO STAGE ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:84px 0 96px;
  }
  .stage-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:54px;align-items:center;position:relative;z-index:2}

  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:520px;height:520px;top:-160px;right:-120px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:460px;height:460px;bottom:-200px;left:-140px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:380px;height:380px;top:30%;left:44%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%)}

  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:overlay;pointer-events:none;
    background-image:var(--wap-hero-photo-url);background-size:cover;background-position:center;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);opacity:.18}

  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:var(--grad-gold);color:var(--gold-ink);font-weight:800;font-size:13px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{display:inline-flex;font-size:13px;opacity:.95}
  @media(max-width:430px){.pill{white-space:normal;text-align:left}}

  .lede h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(40px,5.4vw,66px);
    line-height:1.03;letter-spacing:-.03em;margin:22px 0 0}
  .shimmer{background:var(--grad-gold-shimmer);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .lede .sub{font-size:19px;line-height:1.55;color:rgba(255,255,255,.84);max-width:34em;margin:22px 0 30px}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}
  .dbtn--muted{opacity:.85}

  /* What-happens-next — translucent glass card on the stage */
  .nextglass{position:relative;z-index:2;border-radius:22px;padding:30px 32px;
    background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(18px);
    box-shadow:var(--shadow-glass);color:#fff}
  .ng-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:800;letter-spacing:.1em;
    text-transform:uppercase;color:rgba(255,255,255,.8)}
  .ng-dot{width:8px;height:8px;border-radius:50%;background:var(--gold-glow);box-shadow:0 0 10px var(--gold-glow)}
  .nextglass h2{font-family:'Plus Jakarta Sans',sans-serif;font-size:26px;font-weight:800;margin:12px 0 18px}
  .ng-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:16px}
  .ng-list li{display:flex;gap:14px;align-items:flex-start}
  .ng-ic{width:38px;height:38px;border-radius:11px;flex-shrink:0;display:grid;place-items:center;
    background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);color:var(--gold-glow)}
  .ng-t{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:16px;margin-bottom:3px}
  .ng-d{display:block;color:rgba(255,255,255,.82);font-size:14.5px;line-height:1.55}

  /* ---------------- LIGHT BANDS ---------------- */
  .band{padding:var(--sec-pad) 0}
  .band--surface{background:var(--surface)}

  .sec-head{text-align:center;max-width:720px;margin:0 auto 40px;display:flex;flex-direction:column;align-items:center}
  .eyebrow{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--crimson);margin-bottom:14px}
  .sec-head h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(30px,4.4vw,48px);line-height:1.05;letter-spacing:-.02em;margin-bottom:12px}
  .sec-head p{color:var(--muted);font-size:18px;line-height:1.55}
  .grad-text{background:linear-gradient(100deg,var(--crimson),var(--gold-dark));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}

  /* resource download card */
  .resource{display:flex;align-items:center;gap:18px;max-width:560px;margin:0 auto;
    background:var(--surface-2);border:1px solid var(--border);border-radius:var(--radius);
    padding:22px 24px;box-shadow:var(--shadow);text-decoration:none;color:var(--text);
    transition:transform .18s,box-shadow .2s,border-color .18s}
  .resource:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:var(--crimson)}
  .resource-ic{width:54px;height:54px;border-radius:15px;flex-shrink:0;display:grid;place-items:center;
    background:rgba(173,44,77,.1);color:var(--crimson)}
  .resource-body{display:flex;flex-direction:column;flex:1;min-width:0}
  .resource-t{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:18px}
  .resource-d{color:var(--muted);font-size:14px;margin-top:2px}
  .resource-go{font-weight:800;color:var(--crimson);white-space:nowrap}

  /* ---------------- DEPTH CLOSING CTA (full-bleed crimson) ---------------- */
  .close{
    position:relative;overflow:hidden;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
  }
  .close__media{position:absolute;inset:0;background:var(--wap-hero-photo-url-3) center 40%/cover no-repeat}
  .close__veil{position:absolute;inset:0;
    background:var(--wap-hero-close-veil)}
  .close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:88px 24px 96px;max-width:var(--max)}
  .pill--solid{margin-bottom:24px}
  .close__inner h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(32px,5vw,60px);line-height:1;letter-spacing:-.03em;margin-bottom:18px}
  .close__inner p{font-size:clamp(17px,2.2vw,21px);color:rgba(255,255,255,.92);max-width:38em;margin:0 auto 30px;line-height:1.5}

  /* ---------------- RESPONSIVE ---------------- */
  @media(max-width:880px){
    .stage{padding:64px 0 76px}
    .stage-grid{grid-template-columns:1fr;gap:44px}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
  }
  @media(max-width:560px){
    .acts .bbtn,.acts .dbtn{width:100%;justify-content:center}
    .resource{flex-wrap:wrap}
  }
</style>
</Layout>
