---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { heroPhotoForKey } from '../../../lib/marketing/heroPhotos';
const homeHeroPhoto = heroPhotoForKey('/');
---
<Layout title="WorkforceAP — Empowering People. Advancing Futures.">
<Fragment slot="head">
  <!-- LCP: the hero stage paints this photo as its background — preload it. -->
  <link rel="preload" as="image" href={homeHeroPhoto} fetchpriority="high" />
</Fragment>
<div class="mix3">

  <!-- ============================================================
       HERO — DEPTH STAGE (lead): deep radial crimson→plum stage,
       gold/crimson/white glow auras, luminosity-masked photo,
       stacked rotated glass cards (credentials → pathway → $0).
       ============================================================ -->
  <section class="stage">
    <div class="aura aura--1"></div>
    <div class="aura aura--2"></div>
    <div class="aura aura--3"></div>
    <div class="grain"></div>

    <div class="wrap hero-solo">
      <div class="lede">
        <div class="pill-row">
          <span class="pill"><span class="pill__star">★</span>501(c)(3) nonprofit · Employer-recognized certificates</span>
          <a class="pill pill--donate" href="/donate">Donate</a>
        </div>
        <h1>Empowering People.<br><span class="shimmer">Advancing Futures.</span></h1>
        <div class="hero-card hero-card--mission">
          <span class="hero-card__label">Our mission</span>
          <p>Workforce Advancement Project (WorkforceAP) is a 501(c)(3) nonprofit that equips individuals, nonprofits, counselors, and community ambassadors with workforce readiness tools, occupational training and professional certificates, and AI-powered resume, interview, and job placement assistance to help secure meaningful employment, build lasting careers, and a better life — at no cost to members who qualify through scholarship/grant funded membership.</p>
        </div>
        <div class="acts">
          <a class="dbtn dbtn--solid" href="/apply">Start your application <span>→</span></a>
          <a class="dbtn dbtn--glass" href="/find-your-path">Find your path</a>
        </div>
        <p class="scroll-cue" aria-hidden="true">See what you get<span>↓</span></p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       VALUE DECK — the three white cards on a crimson band below the
       hero. Each card reveals (pops in) as it enters the viewport
       (data-reveal wired in Layout.astro).
       ============================================================ -->
  <section class="value-deck value-deck--crimson">
    <div class="wrap">
      <p class="vd-eyebrow">What you get</p>
      <div class="vd-grid">
        <div class="card card--back">
          <div class="card-tag">Recognized credentials</div>
          <div class="logos">
            <span>IBM</span><span>Google</span><span>Microsoft</span><span>AWS</span><span>CompTIA</span>
          </div>
        </div>

        <div class="card card--mid">
          <div class="mid-row">
            <small>Your pathway</small>
            <span class="dot-live">Live</span>
          </div>
          <div class="mid-big">From apply to hired</div>
          <div class="track">
            <i class="t-done"></i><i class="t-done"></i><i class="t-now"></i><i></i>
          </div>
          <div class="track-labels"><span>Apply</span><span>Match</span><span>Certify</span><span>Launch</span></div>
        </div>

        <div class="card card--front">
          <div class="front-head">
            <div class="ic"><Icon name="check" size={18} /></div>
            <div>
              <b>Application reviewed</b>
              <span>A real team reviews your application and follows up.</span>
            </div>
          </div>
          <div class="meter">
            <span>Cost to members who qualify through scholarship/grant funded membership</span>
            <strong>$0</strong>
          </div>
          <div class="chips">
            <span>~5 min to apply</span>
            <span>No cost to qualifying members</span>
            <span>Real career support</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       HOW IT WORKS — IMMERSIVE full-bleed photo section.
       100vw cinematic photo, crimson veil, headline over it.
       The 4-step journey sits on the photo backdrop.
       ============================================================ -->
  <section class="imm-band">
    <div class="imm-band__media" aria-hidden="true"></div>
    <div class="imm-band__veil" aria-hidden="true"></div>
    <div class="imm-band__inner wrap">
      <div class="imm-head">
        <span class="imm-eyebrow">The journey</span>
        <h2>From apply to <span class="imm-grad">hired</span>, with a team behind you</h2>
        <p>Four steps from application to a recognized credential and real career support — fully supported the whole way.</p>
      </div>
      <div class="imm-journey">
        <div class="imm-jcard">
          <div class="imm-jnum">01</div>
          <h3>Apply</h3>
          <p>Takes about 5 minutes. No cost for members who qualify through scholarship/grant funded membership — a real team reviews it.</p>
          <span class="imm-tag">~5 min</span>
        </div>
        <div class="imm-jcard">
          <div class="imm-jnum">02</div>
          <h3>Get matched</h3>
          <p>We match you to the program track that fits your goals and background.</p>
        </div>
        <div class="imm-jcard">
          <div class="imm-jnum">03</div>
          <h3>Train &amp; certify</h3>
          <p>Build job-ready skills and earn an employer-recognized professional certificate.</p>
        </div>
        <div class="imm-jcard">
          <div class="imm-jnum">04</div>
          <h3>Launch</h3>
          <p>Move into the workforce with resume, interview, and mentor support behind you.</p>
        </div>
      </div>
      <p class="imm-note">A real team reviews your application and follows up about next steps.</p>
    </div>
  </section>

  <!-- ============================================================
       WHO WE SERVE — BOLD tri-cards (high-contrast, top-accent).
       ============================================================ -->
  <section class="blk blk--cream">
    <div class="wrap">
      <div class="head">
        <span class="kick kick--crimson">A connected network</span>
        <h2>Built for members,<br>partners, and employers.</h2>
      </div>
      <div class="tri">
        <div class="tcard">
          <span class="tcard__tag tcard__tag--c">Members</span>
          <p>Employer-aligned training, professional certificates, and a team that supports you to job-ready — at no cost to members who qualify through scholarship/grant funded membership.</p>
          <a class="tlink" href="/apply">Start your application →</a>
        </div>
        <div class="tcard">
          <span class="tcard__tag tcard__tag--g">Partners</span>
          <p>Extend workforce impact in your community through referral and program partnerships.</p>
          <a class="tlink" href="/partners">Explore partnership →</a>
        </div>
        <div class="tcard">
          <span class="tcard__tag tcard__tag--b">Employers</span>
          <p>Build a pipeline of training-aligned candidates for in-demand roles — no per-placement fees.</p>
          <a class="tlink" href="/employers">Talk with us about hiring →</a>
        </div>
      </div>
      <p class="truth">We're a nonprofit — so we don't inflate outcomes. We publish verified placement data as cohorts complete, with the methodology shown.</p>
    </div>
  </section>

  <!-- ============================================================
       TRUST FACTS — BOLD crimson block, big gold numbers.
       ============================================================ -->
  <section class="blk blk--crimson">
    <div class="wrap facts">
      <div class="fact"><div class="fk">25+</div><p>years in workforce development</p></div>
      <div class="fact"><div class="fk fk--sm">501(c)(3)</div><p>nonprofit organization</p></div>
      <div class="fact"><div class="fk">$0</div><p>for members who qualify through scholarship/grant funded membership</p></div>
      <div class="fact"><div class="fk">20</div><p>employer-recognized certification tracks</p></div>
    </div>
    <div class="wrap donate-standalone">
      <a class="bbtn bbtn--gold" href="/donate">Donate</a>
    </div>
  </section>

  <!-- ============================================================
       CLOSING CTA — BOLD full-bleed crimson, photo luminosity.
       ============================================================ -->
  <section class="close">
    <div class="close__media" aria-hidden="true"></div>
    <div class="close__veil" aria-hidden="true"></div>
    <div class="close__inner wrap">
      <span class="pill pill--solid"><span class="pill__star">★</span>Reviewed by a real team</span>
      <h2>Your next step starts with<br><span class="gold">one application.</span></h2>
      <p>Apply in about 5 minutes — no cost for members who qualify through scholarship/grant funded membership. A real team reviews your application and follows up about next steps.</p>
      <div class="acts acts--center">
        <a class="bbtn bbtn--gold" href="/apply">Start your application</a>
        <a class="bbtn bbtn--outline" href="/find-your-path">Find your path</a>
        <a class="bbtn bbtn--outline" href="/employers">For employers</a>
        <a class="bbtn bbtn--gold" href="/donate">Donate</a>
      </div>
    </div>
  </section>

</div>

<style>
  /* ===================================================================
     MIX3 — DEPTH-LED fusion.
     depth stage hero → immersive full-bleed photo how-it-works →
     bold tri-cards + bold facts → bold full-bleed closing CTA.
     =================================================================== */
  .mix3{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}

  /* ---------------- HERO STAGE — translucent crimson veil over the people photo
     (per founder: same immersive treatment as the "From apply to hired" band). ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:
      var(--wap-hero-stage-gradient),
      var(--wap-hero-photo-url) center 30%/cover no-repeat;
    color:#fff;padding:96px 0 84px;
  }
  /* text-led hero: single column. The glass cards now live in their own
     .value-deck band directly below (see VALUE DECK). */
  .hero-solo{position:relative;z-index:2;max-width:660px}

  /* veil handles the crimson now; the old glow auras + mix-blend grain overlay
     are not needed (kept in markup, hidden via CSS). */
  .aura,.grain{display:none}

  /* gold PILL — fully visible, never clipped */
  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:linear-gradient(135deg,#e3bd6a,#a47f38);color:#3a2c10;font-weight:800;font-size:13px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{font-size:13px;opacity:.95}
  @media(max-width:430px){.pill{white-space:normal;text-align:left}}

  /* hero top row: 501(c)(3) pill + Donate — same pill geometry, both gold */
  .pill-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  a.pill--donate{cursor:pointer;transition:transform .15s,box-shadow .2s}
  a.pill--donate:hover{transform:translateY(-2px);box-shadow:0 14px 32px -8px rgba(164,127,56,.68),0 1px 0 rgba(255,255,255,.45) inset}

  /* standalone Donate CTA under the trust-facts band */
  .donate-standalone{display:flex;justify-content:center;margin-top:44px}

  .lede h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(42px,6vw,74px);
    line-height:1.02;letter-spacing:-.03em;margin:22px 0 0}
  .shimmer{background:linear-gradient(100deg,#fff 10%,#f3d28f 50%,#fff 90%);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .lede .sub{font-size:20px;line-height:1.55;color:rgba(255,255,255,.82);max-width:30em;margin:22px 0 30px}
  /* compact glass card for the hero sub / vision statement (smaller, contained) */
  .hero-card{max-width:28em;margin:22px 0 30px;padding:15px 19px;border-radius:16px;
    background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);backdrop-filter:blur(10px);
    box-shadow:0 14px 44px -18px rgba(58,10,30,.55),0 1px 0 rgba(255,255,255,.18) inset}
  .hero-card .hero-card__label{display:block;font-size:13px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#f3d28f;margin-bottom:8px}
  .hero-card p{font-size:16px;line-height:1.5;color:rgba(255,255,255,.92);margin:0}
  /* mission-as-hero: wider + slightly larger lead so the founder statement reads as the hero message */
  .hero-card--mission{max-width:44em;padding:20px 24px}
  .hero-card--mission p{font-size:clamp(15.5px,1.5vw,18px);line-height:1.62}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}

  /* small scroll affordance under the hero CTAs — invites the card reveal */
  .scroll-cue{display:inline-flex;align-items:center;gap:9px;margin-top:32px;
    font-size:13px;font-weight:700;letter-spacing:.04em;color:rgba(255,255,255,.82)}
  .scroll-cue span{display:inline-grid;place-items:center;width:24px;height:24px;border-radius:50%;
    background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.26);font-size:13px;line-height:1;
    animation:cue-bob 1.8s ease-in-out infinite}
  @media (prefers-reduced-motion: reduce){.scroll-cue span{animation:none}}
  @keyframes cue-bob{0%,100%{transform:translateY(0)}50%{transform:translateY(3px)}}

  /* ---------------- VALUE DECK (cards on a crimson band below the hero) ----------------
     White cards (kept light for readability) pop off a deep crimson band, in a
     3-up row on desktop, stacked on mobile; each pops in on scroll (data-reveal
     wired in Layout.astro), so on mobile you scroll past them one after another. */
  .value-deck--crimson{position:relative;color:#fff;
    background:linear-gradient(180deg,#4a0e26 0%,var(--plum) 50%,#3d0a20 100%);
    border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.12);
    box-shadow:0 14px 40px -24px rgba(35,6,18,.6) inset;
    padding:clamp(44px,6vw,76px) 0}
  .vd-eyebrow{text-align:center;font-size:13px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.85);margin-bottom:clamp(22px,3.4vw,34px)}
  .vd-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;align-items:start}

  /* Light cards — white surface, dark text, brand top-accent, soft shadow. */
  .card{position:relative;border-radius:var(--radius);padding:26px 24px;
    background:var(--surface);border:1px solid var(--border);border-top:5px solid var(--crimson);
    box-shadow:var(--shadow);transition:transform .2s,box-shadow .25s;color:var(--text)}
  .card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
  .card--back{border-top-color:var(--gold)}
  .card--mid{border-top-color:var(--blue)}
  .card--front{border-top-color:var(--green)}

  /* Scroll-pop: the value cards get a stronger overshoot (rise + scale) than
     the shared site-wide reveal — they're the hero moment. Rides the shared
     html.js-reveal / [data-reveal] / .is-in hooks (observer + per-card stagger
     wired globally in Layout.astro); reduced-motion / no-JS render fully. */
  @media (prefers-reduced-motion: no-preference){
    html.js-reveal .value-deck .card[data-reveal]{transform:translateY(64px) scale(.88);
      transition:opacity .34s ease, transform .58s cubic-bezier(.3,1.7,.5,1)}
  }

  .card-tag{font-size:13px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--crimson);margin-bottom:14px}
  .logos{display:flex;flex-wrap:wrap;gap:10px}
  .logos span{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:15px;color:var(--text);
    background:var(--surface-2);border:1px solid var(--border);padding:6px 12px;border-radius:10px}

  .mid-row{display:flex;align-items:center;justify-content:space-between}
  .mid-row small{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:800}
  .dot-live{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:#1c6b35;
    background:rgba(74,155,79,.12);border:1px solid rgba(74,155,79,.4);padding:4px 10px;border-radius:999px}
  .dot-live::before{content:"";width:7px;height:7px;border-radius:50%;background:#3fae5a;box-shadow:0 0 7px rgba(63,174,90,.7)}
  .mid-big{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:22px;margin:10px 0 18px;color:var(--text)}
  .track{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
  .track i{height:8px;border-radius:5px;background:var(--border)}
  .track i.t-done{background:linear-gradient(90deg,#caa148,#e3bd6a)}
  .track i.t-now{background:var(--crimson);box-shadow:0 0 0 3px rgba(173,44,77,.18)}
  .track-labels{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}
  .track-labels span{font-size:13px;font-weight:700;color:var(--muted);text-align:center}

  .front-head{display:flex;align-items:flex-start;gap:13px;margin-bottom:18px}
  .front-head .ic{flex-shrink:0;width:38px;height:38px;border-radius:11px;display:grid;place-items:center;
    background:rgba(74,155,79,.15);border:1px solid rgba(74,155,79,.4);color:#2f8f4a;font-weight:800;font-size:17px}
  .front-head b{display:block;font-weight:800;font-size:15px;color:var(--text)}
  .front-head span{font-size:13px;color:var(--muted)}
  .meter{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:14px 16px;border-radius:13px;
    background:var(--surface-2);border:1px solid var(--border);margin-bottom:14px}
  .meter span{font-size:13px;color:var(--muted)}
  .meter strong{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:26px;color:var(--gold-dark)}
  .chips{display:flex;flex-wrap:wrap;gap:8px}
  .chips span{font-size:13px;font-weight:700;color:var(--text);padding:6px 12px;border-radius:999px;
    background:var(--surface-2);border:1px solid var(--border)}

  /* MOBILE: stack the cards so each scrolls into view (and pops) on its own. */
  @media(max-width:880px){
    .vd-grid{grid-template-columns:1fr;gap:16px;max-width:460px;margin:0 auto}
  }

  /* ---------------- IMMERSIVE FULL-BLEED PHOTO HOW-IT-WORKS ---------------- */
  .imm-band{
    position:relative;overflow:hidden;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
    padding:0;
  }
  .imm-band__media{
    position:absolute;inset:0;
    background:var(--wap-hero-photo-url-2) center 35%/cover no-repeat;
    transform:scale(1.04);
  }
  .imm-band__veil{
    position:absolute;inset:0;
    background:
      linear-gradient(180deg,rgba(187,0,0,.68) 0%,rgba(140,15,55,.52) 40%,rgba(173,44,77,.6) 100%),
      linear-gradient(115deg,rgba(200,16,46,.28) 0%,rgba(109,20,55,.2) 100%);
  }
  .imm-band__inner{position:relative;z-index:2;color:#fff;padding:var(--sec-pad) 24px;max-width:var(--max)}
  .imm-head{text-align:center;max-width:720px;margin:0 auto 52px}
  .imm-eyebrow{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
    color:#f3d28f;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);padding:7px 15px;border-radius:999px;margin-bottom:18px}
  .imm-head h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(32px,4.6vw,54px);line-height:1.05;letter-spacing:-.02em;margin-bottom:14px;
    text-shadow:0 2px 40px rgba(45,8,22,.5)}
  .imm-grad{background:linear-gradient(100deg,#ffd98a,#ffb4c4);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .imm-head p{color:rgba(255,255,255,.9);font-size:19px;line-height:1.55;text-shadow:0 1px 20px rgba(45,8,22,.4)}

  .imm-journey{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
  .imm-jcard{position:relative;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:22px;padding:30px 26px;
    backdrop-filter:blur(16px);box-shadow:0 30px 70px -34px rgba(35,6,18,.7),0 1px 0 rgba(255,255,255,.18) inset;
    transition:transform .22s,box-shadow .26s,border-color .2s;color:#fff}
  .imm-jcard:hover{transform:translateY(-6px);border-color:rgba(255,255,255,.36);box-shadow:0 40px 84px -34px rgba(35,6,18,.8)}
  .imm-jnum{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:42px;line-height:1;
    background:linear-gradient(100deg,#ffd98a,#ffb4c4);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:16px}
  .imm-jcard h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:20px;font-weight:800;margin-bottom:8px}
  .imm-jcard p{color:rgba(255,255,255,.82);font-size:15px}
  .imm-tag{display:inline-flex;margin-top:14px;font-size:13px;font-weight:700;padding:5px 11px;border-radius:999px;
    background:rgba(243,210,143,.2);color:#f3d28f;border:1px solid rgba(243,210,143,.3)}
  .imm-note{text-align:center;color:rgba(255,255,255,.78);font-size:14px;margin-top:34px}
  @media(max-width:900px){.imm-journey{grid-template-columns:1fr 1fr}}
  @media(max-width:520px){.imm-journey{grid-template-columns:1fr}}

  /* ---------------- BOLD ALTERNATING BLOCKS ---------------- */
  .blk{width:100%;padding:var(--sec-pad) 0}
  .blk--crimson{background:var(--grad);color:#fff}
  .blk--cream{background:var(--bg);color:var(--text)}
  .gold{color:#e9c879}

  .head{margin-bottom:56px}
  .head h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(38px,6vw,72px);line-height:.96;letter-spacing:-.03em}
  .kick{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin-bottom:18px}
  .kick--crimson{color:var(--crimson)}

  /* BOLD tri-cards */
  .tri{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .tcard{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:34px 30px;box-shadow:var(--shadow);
    border-top:6px solid var(--crimson);transition:transform .2s,box-shadow .25s}
  .tcard:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}
  .tcard__tag{display:inline-flex;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:22px;margin-bottom:14px}
  .tcard__tag--c{color:var(--crimson)}
  .tcard__tag--b{color:var(--blue)}
  .tcard__tag--g{color:var(--gold-dark)}
  .tcard:nth-child(2){border-top-color:var(--gold)}
  .tcard:nth-child(3){border-top-color:var(--blue)}
  .tcard p{color:var(--muted);font-size:16px;line-height:1.55;margin-bottom:20px}
  .tlink{display:inline-flex;align-items:center;min-height:44px;font-weight:800;color:var(--crimson);font-size:15px}
  .tcard:nth-child(2) .tlink{color:var(--gold-dark)}
  .tcard:nth-child(3) .tlink{color:var(--blue)}
