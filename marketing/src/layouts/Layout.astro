---
// Canonical WorkforceAP design tokens. This is the same file app/layout.tsx
// loads on every Next route (css/wa-brand-tokens.css, WAP-106); importing it
// here is what puts the static public pages on the same brand token layer as
// the portals instead of a second hand-maintained copy of the palette.
// It must stay ahead of blend.css, which reads these tokens.
import '../../../css/wa-brand-tokens.css';
import '../styles/blend.css';
import '../styles/hero-media.css';
import AnalyticsHead from '../components/AnalyticsHead.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { heroPhotoCssUrl, heroPhotoForKey, heroPhotoSequenceForKey } from '../../../lib/marketing/heroPhotos';
export interface Props {
  title?: string;
  description?: string;
  lang?: string;
}
const {
  title = 'WorkforceAP — Employer-aligned training & career support',
  description = 'WorkforceAP is a 501(c)(3) nonprofit providing employer-aligned training, professional certificates, and career support at no cost to members who qualify through scholarship/grant funded membership.',
  lang = 'en',
} = Astro.props;
// Primary nav with dropdowns — mirrors the portal/Next MainNav structure so
// chrome is consistent across the whole site (parity with components/MainNav).
const nav = [
  { href: '/about', label: 'About Us', children: [
    { href: '/what-we-do', label: 'What We Do' },
    { href: '/how-it-works', label: 'How It Works' },
    { href: '/apply', label: 'Membership' },
    { href: '/leadership', label: 'Leadership' },
    { href: '/faq', label: 'FAQ' },
    { href: '/donate', label: 'Donate' },
  ] },
  { href: '/programs', label: 'Programs', children: [
    { href: '/programs', label: 'All Programs' },
    { href: '/find-your-path', label: 'Find Your Path' },
    { href: '/career-quiz', label: 'Free Career Quiz' },
    { href: '/program-comparison', label: 'Compare Programs' },
    { href: '/salary-guide', label: 'Salary Guide' },
  ] },
  { href: '/partners', label: 'Partners' },
  { href: '/employers', label: 'Employers' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact Us' },
];
// Role-based sign-in (mirrors MainNav GUEST_LOGIN_SUBMENU).
const signInMenu = [
  { href: '/login?redirectTo=/dashboard', label: 'Member Sign In' },
  { href: '/login?redirectTo=/counselor', label: 'Counselor Sign In' },
  { href: '/login?redirectTo=/employer', label: 'Employer Sign In' },
  { href: '/login?redirectTo=/partner', label: 'Partner Sign In' },
  { href: '/login?redirectTo=/admin', label: 'Admin Sign In' },
];
// Comprehensive mobile drawer (every route + role logins; flat for touch).
const mobileNav = [
  { href: '/programs', label: 'Programs' },
  { href: '/find-your-path', label: 'Find your path' },
  { href: '/career-quiz', label: 'Free career quiz' },
  { href: '/program-comparison', label: 'Compare programs' },
  { href: '/salary-guide', label: 'Salary guide' },
  { href: '/how-it-works', label: 'How it works' },
  { href: '/what-we-do', label: 'What we do' },
  { href: '/employers', label: 'For employers' },
  { href: '/partners', label: 'Partners' },
  { href: '/mentor', label: 'Become a mentor' },
  { href: '/about', label: 'About' },
  { href: '/leadership', label: 'Leadership' },
  { href: '/impact', label: 'Impact' },
  // Outcomes nav link hidden — page archived at src/_archive/outcomes.astro
  { href: '/faq', label: 'FAQ' },
  { href: '/blog', label: 'Blog' },
  { href: '/donate', label: 'Donate' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
// Static marketing owns these clean URLs; omit campaign and quiz query strings
// so search engines and shared links identify the same page.
const publicOrigin = 'https://www.workforceap.org';
const canonicalUrl = new URL(path.replace(/\/+$/, '') || '/', publicOrigin).href;
const socialImage = new URL('/images/image-asset.webp', publicOrigin).href;
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  '@id': `${publicOrigin}/#organization`,
  name: 'Workforce Advancement Project',
  alternateName: 'WorkforceAP',
  url: publicOrigin,
  logo: `${publicOrigin}/images/wap_logo.png`,
  description: 'A nonprofit providing occupational training, professional certificates, and career support.',
};
const heroPhotoPath = heroPhotoForKey(path);
const heroPhotoUrl = heroPhotoCssUrl(path);
// distinct photos for the page's mid-band and closing CTA so no section
// repeats the hero frame (stakeholder ask: diverse pics, don't reuse one)
const [, heroPhoto2, heroPhoto3] = heroPhotoSequenceForKey(path, 3);
const heroPhotoUrl2 = `url('${heroPhoto2}')`;
const heroPhotoUrl3 = `url('${heroPhoto3}')`;
---
<!DOCTYPE html>
<html lang={lang} style={`--wap-hero-photo-url: ${heroPhotoUrl}; --wap-hero-photo-url-2: ${heroPhotoUrl2}; --wap-hero-photo-url-3: ${heroPhotoUrl3}`}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="WorkforceAP" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:alt" content="WorkforceAP — career training and career support" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema).replace(/</g, '\\u003c')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
  <AnalyticsHead />
  <slot name="head" />
  <style is:global>
    /* token modifiers for chrome elements that live only in Layout.astro
       (kept here so blend.css is untouched; mirrors .btn / .fbottom rules) */
    .btn--nav{padding:12px 20px;font-size:15px;min-height:44px}
    .flegal{display:flex;gap:18px}
    .flegal a{color:var(--muted)}
    .flegal a:hover{color:var(--crimson)}
  </style>
</head>
<body>
  <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${(import.meta.env.PUBLIC_GTM_ID ?? process.env.NEXT_PUBLIC_GTM_ID ?? 'GTM-53JCT6WN').trim()}`} height="0" width="0" style="display:none;visibility:hidden" title="gtm"></iframe></noscript>
  <a class="skiplink" href="#main-content">Skip to content</a>
  <input class="navtoggle" type="checkbox" id="navtoggle" />
  <label class="hamburger" for="navtoggle" aria-label="Toggle menu"><span></span><span></span><span></span></label>
  <nav class="top">
    <div class="wrap row">
      <a class="brand" href="/" aria-label="Workforce Advancement Project — home"><img class="brand-logo" src="/images/wap_logo.png" alt="Workforce Advancement Project" width="210" height="107" /></a>
      <div class="navlinks">
        {nav.map((n) => n.children ? (
          <div class="navdrop">
            <a class="navdrop-trigger" href={n.href} aria-haspopup="true">{n.label}<svg class="navchev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></a>
            <div class="navdrop-menu">
              {n.children.map((c) => <a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a>)}
            </div>
          </div>
        ) : (
          <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
        ))}
      </div>
      <div class="navactions">
        <div class="navdrop navdrop--end">
          <a class="navdrop-trigger signin" href="/login">Log in<svg class="navchev" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></a>
          <div class="navdrop-menu navdrop-menu--right">
            {signInMenu.map((s) => <a href={s.href}>{s.label}</a>)}
          </div>
        </div>
        <a class="btn btn--apply btn--nav" href="/apply">Apply now</a>
      </div>
    </div>
  </nav>
  <nav class="mobilemenu" aria-label="Mobile">
    {nav.map((n) => n.children ? (
      <details class="mob-acc">
        <summary>{n.label}<svg class="mob-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        <div class="mob-acc__body">
          {n.children.map((c) => <a class="mobilemenu-sub" href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a>)}
        </div>
      </details>
    ) : (
      <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
    ))}
    <details class="mob-acc">
      <summary>Sign in<svg class="mob-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
      <div class="mob-acc__body">
        {signInMenu.map((s) => <a class="mobilemenu-sub" href={s.href}>{s.label}</a>)}
      </div>
    </details>
    <a class="btn btn--apply" href="/apply">Apply now</a>
  </nav>

  <main id="main-content">
    <slot />
  </main>

  <footer><div class="wrap">
    <div class="fgrid">
      <div class="fbrand">
        <a class="brand brand--footer" href="/" aria-label="Workforce Advancement Project — home"><img class="brand-logo" src="/images/wap_logo.png" alt="Workforce Advancement Project" width="210" height="107" /></a>
        <p>A 501(c)(3) nonprofit providing employer-aligned training, professional certificates, and career support at no cost to members who qualify through scholarship/grant funded membership.</p>
        <span class="fseal"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>501(c)(3) nonprofit · EIN 41-2612389</span>
      </div>
      <div><h2>Explore</h2><ul><li><a href="/programs">Programs</a></li><li><a href="/how-it-works">How it works</a></li><li><a href="/find-your-path">Find your path</a></li><li><a href="/impact">Impact</a></li></ul></div>
      <div><h2>Get involved</h2><ul><li><a href="/apply">Apply</a></li><li><a href="/employers">For employers</a></li><li><a href="/partners">Partners</a></li><li><a href="/mentor">Become a mentor</a></li><li><a href="/donate">Donate</a></li></ul></div>
      <div><h2>Organization</h2><ul><li><a href="/about">About</a></li><li><a href="/leadership">Leadership</a></li><li><a href="/careers">Careers</a></li><li><a href="/contact">Contact</a></li></ul></div>
    </div>
    <div class="fbottom">
      <span>© 2026 WorkforceAP · A national 501(c)(3) nonprofit. Available nationwide.</span>
      <span class="flegal"><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/accessibility">Accessibility</a></span>
    </div>
  </div></footer>

  <script is:inline>
    // Progressive enhancement: nav depth-on-scroll + scroll-reveal.
    // The page is fully functional without JS (Astro stays zero-JS-by-default;
    // this is a tiny enhancement, reduced-motion respected by the CSS).
    (function () {
      var nav = document.querySelector('nav.top');
      var onScroll = function () { if (nav) nav.classList.toggle('scrolled', window.scrollY > 20); };
      window.addEventListener('scroll', onScroll, { passive: true }); onScroll();

      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        // Site-wide scroll-pop: every recurring card/stat/section-head family
        // reveals as it enters view (one shared system, not per-page copies).
        var targets = document.querySelectorAll(
          [
            'main section .sec-head', 'main .tool', 'main .stepcard', 'main .acard',
            'main .panel', 'main .cta', 'main .facts', 'main .creds .row', 'main .mission-card',
            // value deck (homepage signature) + interior home bands
            'main .value-deck .card', 'main .tcard', 'main .fact', 'main .imm-jcard', 'main .imm-head',
            // catalog / programs / data pages
            'main .pcard', 'main .statcard', 'main .icard', 'main .phasecard', 'main .si', 'main .fcard',
            // audience / org
            'main .emp-card', 'main .efact', 'main .vcard', 'main .amtcard', 'main .gcard', 'main .gs-i',
            'main .proof-i', 'main .person',
            // credibility / content / landing
            'main .bcard', 'main .stat-card', 'main .qcard', 'main .post-card',
            'main .learn-card', 'main .outcome-card', 'main .wioa-card',
          ].join(', ')
        );
        // Only NOW (JS confirmed) do we allow the hidden start-state — so no-JS,
        // crawlers, and failed hydration always render content. See blend.css.
        document.documentElement.classList.add('js-reveal');
        targets.forEach(function (el, i) {
          el.setAttribute('data-reveal', '');
          el.style.transitionDelay = (Math.min(i % 4, 3) * 70) + 'ms';
        });
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        targets.forEach(function (el) { io.observe(el); });
        // Safety net: only force-reveal elements ALREADY in the viewport that the
        // observer hasn't tripped yet — never below-fold content, so each card
        // still pops as you scroll to it.
        setTimeout(function () {
          var vh = window.innerHeight || 0;
          targets.forEach(function (el) {
            if (el.classList.contains('is-in')) return;
            var r = el.getBoundingClientRect();
            if (r.top < vh && r.bottom > 0) el.classList.add('is-in');
          });
        }, 1400);
      }
    })();
  </script>
  <ConsentBanner />
</body>
</html>
