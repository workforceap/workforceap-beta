#!/bin/sh
# Opt-in pre-push hook (WAP-203). Enable once per clone or worktree with:
#   git config core.hooksPath .githooks
# It runs the same fast checks as `npm run prepush` and CI's static-gates job.
# Skip a single push with `git push --no-verify`.
repo_root=$(git rev-parse --show-toplevel) || exit 1
exec node "$repo_root/scripts/prepush.mjs"
