# ============================================================
# WorkforceAP Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================
# Last updated: 2026-05-13
# Full documentation: docs/ENVIRONMENT-VARIABLES.md
# ============================================================

# -----------------------------------------------------------
# 1. CORE INFRASTRUCTURE (Required)
# -----------------------------------------------------------

# Canonical public URL — used in email links, password resets, redirects
NEXT_PUBLIC_SITE_URL=https://www.workforceap.org

# Employer landing (/employers)
# NEXT_PUBLIC_EMPLOYER_CALENDLY_URL=https://calendly.com/your-org/20min

# Supabase (public — safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (server-only — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage: create a private bucket named member-resumes (Dashboard → Storage) for member resume uploads.

# -----------------------------------------------------------
# 2. DATABASE (Required for server / Prisma)
# -----------------------------------------------------------

# For local dev, use DATABASE_URL or add both from Supabase Dashboard → Project Settings → Database
POSTGRES_PRISMA_URL=postgresql://user:password@host:6543/database?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/database
# Fallback for local dev (scripts/ensure-prisma-env.cjs copies this to POSTGRES_* if missing):
DATABASE_URL=postgresql://user:password@host:5432/database

# -----------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Required)
# -----------------------------------------------------------

# Cron job secret — REQUIRED in production (protects /api/cron/* endpoints)
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# Signing secret for post-placement survey email links.
# REQUIRED if /api/cron/placement-survey runs in this environment.
# Generate with: openssl rand -hex 32
PLACEMENT_SURVEY_TOKEN_SECRET=your-placement-survey-token-secret-here

# Signing secret for admin MFA trust cookies.
# REQUIRED for staff MFA trust feature.
# Generate with: openssl rand -hex 32
AUTH_TRUST_COOKIE_SECRET=your-auth-trust-cookie-secret-here

# Optional: how many days admin MFA trust lasts (default: 7)
ADMIN_MFA_TRUST_DAYS=7

# Staff MFA enforcement. REQUIRED in production.
# Set to 1 to require admin/counselor MFA setup and verification.
STAFF_MFA_ENFORCEMENT=1

# -----------------------------------------------------------
# 4. EMAIL (Required for production)
# -----------------------------------------------------------

# Resend (primary email provider)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@workforceap.org

# Support email fallback (default: info@workforceap.org)
SUPPORT_EMAIL=info@workforceap.org

# Optional HTTPS counselor calendar URL for stalled-training emails.
# If missing/invalid, the email links to the member's /dashboard/messages inbox.
COUNSELOR_BOOKING_URL=

# Optional: workspace email provider (noop | google | microsoft)
WORKSPACE_EMAIL_PROVIDER=noop

# Optional: transcript / digest email recipients (comma-separated)
VOICE_COACH_TRANSCRIPT_EMAILS=
VOICE_INTERVIEW_TRANSCRIPT_EMAILS=
AT_RISK_DIGEST_EMAILS=
COURSERA_UNMATCHED_ACTOR_ALERT_EMAILS=

# WIOA screening notification recipient
WIOA_SCREENING_NOTIFY_EMAIL=info@workforceap.org

# WIOA monthly report recipients (comma-separated; default: info@workforceap.org)
WIOA_REPORT_RECIPIENTS=

# Optional: unsubscribe address for marketing emails (default: unsubscribe@workforceap.org)
EMAIL_UNSUBSCRIBE_ADDRESS=

# Web Push (optional). Generate once: npx web-push generate-vapid-keys
# Public key is shared with the browser subscribe UI; private stays server-side.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:support@workforceap.org

# Optional: Sentry release override for build-time source map tagging
SENTRY_RELEASE=

# -----------------------------------------------------------
# 5. RATE LIMITING (Recommended)
# -----------------------------------------------------------

# Upstash Redis (rate limiting)
# Production boots throw without these unless RATE_LIMIT_ALLOW_MISSING_UPSTASH=1.
# Partner signup, MFA verify, and bulk-email use the security fail-closed path
# (open in production only when RATE_LIMIT_ALLOW_MISSING_UPSTASH=1).
# Apply/signup stay open when RATE_LIMIT_ALLOW_MISSING_UPSTASH=1 unless
# WAP_APPLY_RATE_LIMIT_FAIL_CLOSED=1 is also set.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
# RATE_LIMIT_ALLOW_MISSING_UPSTASH=1
# WAP_APPLY_RATE_LIMIT_FAIL_CLOSED=1

# -----------------------------------------------------------
# 6. AI & LLM PROVIDERS (At least one required for member AI tools)
# -----------------------------------------------------------

# Provider fallback chain: Anthropic → Groq → Gemini
# All three recommended for production (single provider outage won't break experience).
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...

# Optional: override models
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Tavily for web search when drafting blog posts (blog AI tools)
# TAVILY_API_KEY=tvly-...

# Optional: Firecrawl for employer job import from URLs (LinkedIn, JS-rendered sites)
# When set, used as fallback when plain fetch fails.
# FIRECRAWL_API_KEY=fc-...

# Optional: Proxycurl for LinkedIn profile enrichment
# PROXYCURL_API_KEY=

# -----------------------------------------------------------
# 7. ELEVENLABS VOICE & CONVERSATIONAL AI (Recommended)
# -----------------------------------------------------------

# https://elevenlabs.io/app/settings/api-keys
# Without ELEVENLABS_API_KEY, interview coach uses text-only; voice UIs return 503.
ELEVENLABS_API_KEY=

# Conversational AI agent IDs (ElevenLabs → Agents).
# Most portal agents have code fallbacks. Staff counselor mode does not: configure its ID explicitly.
# Agent IDs for ConvAI (see lib/ai/elevenlabsPortalContext.ts for dynamic variables passed per route).
ELEVENLABS_INTERVIEW_AGENT_ID=
# Optional member-facing Lilley override. Unreviewed IDs are ignored so students cannot reach a staff/unknown voice.
ELEVENLABS_COUNSELOR_AGENT_ID=
# Required for governed member Lilley voice. Copy only the attended-reviewed,
# non-archived main branch ID; never guess it or use an unreviewed traffic-split branch.
ELEVENLABS_LILLEY_BRANCH_ID=
# Required to enable counselor/admin-only caseload, outreach, and staff portal voice guidance.
# If unset, explicit staff voice sessions fail closed with 503; member Lilley remains available.
ELEVENLABS_COUNSELOR_STAFF_AGENT_ID=
ELEVENLABS_EMPLOYER_AGENT_ID=
ELEVENLABS_READINESS_AGENT_ID=
ELEVENLABS_RESUME_COACH_AGENT_ID=
ELEVENLABS_PARTNER_AGENT_ID=
ELEVENLABS_WIOA_PREQUAL_AGENT_ID=
# Legacy member career/business entry point; also restricted to the reviewed Lilley student agent.
ELEVENLABS_CAREER_BUSINESS_AGENT_ID=

# Optional public TTS override IDs for specific portal voice surfaces.
# WIOA defaults to Sarah (female, mature, reassuring) with slightly slower, steadier delivery.
NEXT_PUBLIC_ELEVENLABS_WIOA_VOICE_ID=
# Legacy fallback used only by the WIOA guide when its dedicated voice ID is unset.
# This does not control Lilley or staff ConvAI voices; configure those on their ElevenLabs agents.
NEXT_PUBLIC_ELEVENLABS_COUNSELOR_VOICE_ID=
NEXT_PUBLIC_ELEVENLABS_INTERVIEWER_FEMALE_VOICE_ID=
NEXT_PUBLIC_ELEVENLABS_INTERVIEWER_MALE_VOICE_ID=

# -----------------------------------------------------------
# 8. COURSERA / LEARNING INTEGRATION (Optional)
# -----------------------------------------------------------

# API base for the LEGACY Enterprise skillset client (lib/coursera/configCore.ts)
# ONLY. Do not point the B4B client here — its paths already include
# /api/businesses.v1 and this rest/v1 base would 404 every B4B call.
COURSERA_API_BASE_URL=https://api.coursera.com/ent/api/rest/v1
# API base for the B4B client (lib/coursera/b4bClient.ts). Leave unset for the
# default https://api.coursera.com/ent — set only if Coursera changes the host.
COURSERA_B4B_API_BASE_URL=
# Bearer token for Coursera Enterprise API access.
COURSERA_API_TOKEN=
# Default Coursera program ID, or use the JSON map below for per-program overrides.
COURSERA_PROGRAM_ID=
COURSERA_PROGRAM_ID_MAP={}
# Member launch destination. Use either a fixed URL or a template with {programId}, {programSlug}, {userId}, {email}.
COURSERA_PROGRAM_HOME_URL=
COURSERA_PROGRAM_URL_TEMPLATE=
# Default skillset ids for learner-progress sync, comma-separated.
COURSERA_DEFAULT_SKILLSET_IDS=
# Optional per-program skillset mapping, JSON object of slug -> string[].
COURSERA_SKILLSET_ID_MAP={}
# Shared secret for inbound Coursera completion webhooks.
COURSERA_WEBHOOK_SECRET=
# Fallback webhook secret (used if COURSERA_WEBHOOK_SECRET is not set)
WEBHOOK_SECRET=

# Optional: learning path deep-linking (preferred over course-level deep-linking)
# URL template with {learningPathId}, {programId}, {programSlug}, {userId}, {email}
COURSERA_LEARNING_PATH_URL_TEMPLATE=
# Per-program learning path ID mapping: programSlug -> Coursera learning path ID
COURSERA_LEARNING_PATH_ID_MAP={}

# xAPI / LRS configuration
COURSERA_XAPI_CLIENT_ID=
COURSERA_XAPI_CLIENT_SECRET=
# Fallback xAPI credentials (used when COURSERA_XAPI_CLIENT_ID/SECRET not set)
XAPI_CLIENT_ID=
XAPI_CLIENT_SECRET=
XAPI_TENANT_SERVER_URL=

# Optional: Business-to-Business (B4B) client credentials
COURSERA_APP_ID=
COURSERA_APP_KEY=
COURSERA_APP_SECRET=

# Business-to-Business (B4B) client credentials
COURSERA_B4B_CLIENT_ID=
COURSERA_B4B_CLIENT_SECRET=

# Required for organization-scoped Coursera B4B reads/enrollment actions; no default.
# Verify this is the intended provider organization before enabling B4B.
COURSERA_ORG_ID=
COURSERA_ORG_SLUG=
COURSERA_OAUTH_TOKEN_URL=
COURSERA_TARGET_BASE_URL=

# Course / skillset mappings
COURSERA_COURSE_ID_MAP={}
COURSERA_COURSE_URL_TEMPLATE=
COURSERA_SKILLSET_SLUG_MAP={}

# Alert emails for unmatched Coursera actors
COURSERA_UNMATCHED_ACTOR_ALERT_EMAILS=

# -----------------------------------------------------------
# 9. STRIPE / PAYMENTS (Required if org onboarding is enabled)
# -----------------------------------------------------------

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Price IDs for org onboarding tiers
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_BASIC_PRICE_ID=

# -----------------------------------------------------------
# 10. ANALYTICS & MONITORING (Optional)
# -----------------------------------------------------------

# Optional: Google Tag Manager (analytics)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Optional: Sentry (error monitoring) — @sentry/nextjs is wired in next.config.ts
# Server/edge: use SENTRY_DSN. Browser: same DSN in NEXT_PUBLIC_SENTRY_DSN for client errors.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Build-time source map upload (used by @sentry/nextjs internally during build):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Replay sample rate (0.01 = 1% of sessions). Default 1% to control cost.
# NEXT_PUBLIC_SENTRY_REPLAY_SAMPLE_RATE=0.01

# Optional: enable analytics debug logging
ENABLE_ANALYTICS_LOGS=false

# -----------------------------------------------------------
# 11. O*NET SKILL MAPPER (Optional)
# -----------------------------------------------------------

# O*NET Web Services v2 — Header: X-API-Key
# https://api-v2.onetcenter.org/
ONET_API_KEY=
ONET_API_BASE_URL=https://api-v2.onetcenter.org/

# -----------------------------------------------------------
# 12. WIOA (Optional)
# -----------------------------------------------------------

# Available by default. Set to "0" to hide portal navigation and Learning Hub discovery links.
NEXT_PUBLIC_WIOA_ENABLED=1
WIOA_SCREENING_NOTIFY_EMAIL=info@workforceap.org

# -----------------------------------------------------------
# 13. PARTNER & ORG (Optional)
# -----------------------------------------------------------

# Partner referral dashboard — illustrative payout estimate per verified placement (USD). Default 500.
PARTNER_PLACEMENT_PAYOUT_USD=
NEXT_PUBLIC_PARTNER_PLACEMENT_PAYOUT_USD=500

# -----------------------------------------------------------
# 14. CLOUDFLARE TURNSTILE CAPTCHA (Optional)
# -----------------------------------------------------------

# Cloudflare Turnstile CAPTCHA — REQUIRED in production.
# Set to true when both keys are configured in Vercel.
NEXT_PUBLIC_CAPTCHA_ENABLED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------
# 15. ADMIN & CRON (Optional)
# -----------------------------------------------------------

# Match suggestions: redirect emails to test inbox (leaves employer email in audit metadata)
ADMIN_MATCH_SUGGESTIONS_TEST_EMAIL=

# Match suggestions: skip Resend send, return { dryRun: true } and record audit
ADMIN_MATCH_SUGGESTIONS_DRY_RUN=0

# Timezone for greeting calculations (default: America/Chicago)
DEFAULT_GREETING_TZ=America/Chicago

# -----------------------------------------------------------
# 16. TESTING & QA (Dev-only)
# -----------------------------------------------------------

# E2E test credentials
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_MEMBER_EMAIL=member-test@workforceap.org
PLAYWRIGHT_PARTNER_EMAIL=partner-test@workforceap.org
PLAYWRIGHT_PORTAL_PASSWORD=TestWfAP2026!
PLAYWRIGHT_STORAGE_STATE=
PLAYWRIGHT_ADMIN_STORAGE_STATE=
PLAYWRIGHT_VERCEL_SHARE_URL=
PLAYWRIGHT_SCREENSHOT=off
PLAYWRIGHT_TRACE=off
PLAYWRIGHT_VIDEO=off

# Portal audit filtering
PORTAL_AUDIT_SECTION=all

# E2E artifacts output directory
ARTIFACTS_DIR=

# Coursera E2E
E2E_MEMBER_EMAIL=
E2E_MEMBER_PASSWORD=
E2E_ISSUE_XAPI_TOKEN=

# Prisma seed flags (dev/staging only)
SEED_TEST_ACCOUNTS=false
SEED_DEMO=false

# -----------------------------------------------------------
# 17. BUILD & INTERNAL (Dev-only / auto-set)
# -----------------------------------------------------------

# Enable bundle analyzer: ANALYZE=true npm run build
ANALYZE=false

# Force DB queries during build (dev override)
# WORKFORCEAP_FORCE_DB_BUILD=1

# Vercel API (for deployment scripts)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Never set WAP_RLS_GUC_ENABLED=true in production without the full RLS milestone.
# WAP_RLS_GUC_ENABLED=
