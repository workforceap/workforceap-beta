# Fake, local-only values for `npm run preview:local` (scripts/local-preview.mjs).
# The preview builds its environment from THIS file only. It never reads .env,
# .env.local or shell DB variables. Nothing here is a real credential.
# Ports are the preview's own: DB 54329, fake auth shim 54331, web 3100.

PREVIEW_DB_PORT=54329
PREVIEW_AUTH_PORT=54331
PREVIEW_WEB_PORT=3100

DATABASE_URL=postgresql://postgres:preview_local_only@127.0.0.1:54329/wap_preview
POSTGRES_PRISMA_URL=postgresql://postgres:preview_local_only@127.0.0.1:54329/wap_preview
POSTGRES_URL_NON_POOLING=postgresql://postgres:preview_local_only@127.0.0.1:54329/wap_preview

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Fake HS256 secret and tokens for the local auth shim (not a Supabase key).
PREVIEW_JWT_SECRET=preview-local-only-secret-not-a-real-key-0123456789
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InByZXZpZXctbG9jYWwifQ.cHJldmlldy1sb2NhbC1vbmx5
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoicHJldmlldy1sb2NhbCJ9.cHJldmlldy1sb2NhbC1vbmx5

ATTENDANCE_SYNTHETIC_DEMO=local
SEED_DEMO=true
LOCAL_PREVIEW=1

PREVIEW_ADMIN_ID=00000000-0000-4000-8000-0000000aa001
PREVIEW_ADMIN_EMAIL=preview-admin@example.test
PREVIEW_ADMIN_PASSWORD=Preview-Admin-1!
PREVIEW_STUDENT_ID=00000000-0000-4000-8000-0000000bb001
PREVIEW_STUDENT_EMAIL=preview-student@example.test
PREVIEW_STUDENT_PASSWORD=Preview-Student-1!
