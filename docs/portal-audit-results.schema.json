{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workforceap.org/schemas/portal-audit-results.schema.json",
  "title": "WorkforceAP authenticated portal audit result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "status",
    "baseURL",
    "generatedAt",
    "completedAt",
    "requestedSections",
    "viewports",
    "targetValidation",
    "inventory",
    "credentialValidation",
    "executionPolicy",
    "attendedGates",
    "accessMatrix",
    "roles",
    "summary",
    "fatalError"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "3.2.0" },
    "status": { "enum": ["passed", "partial", "failed", "blocked"] },
    "baseURL": { "type": ["string", "null"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "requestedSections": {
      "type": "array",
      "items": { "$ref": "#/$defs/roleName" },
      "uniqueItems": true
    },
    "viewports": {
      "type": "array",
      "items": { "$ref": "#/$defs/viewport" },
      "maxItems": 2
    },
    "targetValidation": {
      "type": "object",
      "required": ["ok", "mode", "targetClass", "errors"],
      "properties": {
        "ok": { "type": "boolean" },
        "mode": { "enum": ["local", "isolated_preview", "production_canary", null] },
        "targetClass": { "enum": ["local_loopback", "isolated_preview", "production", null] },
        "errors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "inventory": { "$ref": "#/$defs/inventory" },
    "credentialValidation": {
      "type": "object",
      "required": ["ok", "errors", "sources", "authenticatedIdentitiesDistinct"],
      "properties": {
        "ok": { "type": "boolean" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/credentialError" } },
        "sources": {
          "type": "object",
          "additionalProperties": { "enum": ["canonical", "legacy", "missing"] }
        },
        "authenticatedIdentitiesDistinct": { "type": ["boolean", "null"] }
      }
    },
    "executionPolicy": {
      "type": "object",
      "required": ["mode", "evidenceScope", "mutations", "authState", "dynamicRoutes", "actions", "routeConcurrency", "deadlineMs"],
      "properties": {
        "mode": { "enum": ["local", "isolated_preview", "production_canary", null] },
        "evidenceScope": { "enum": ["complete_five_role_matrix", "production_nonstaff_canary", "local_requested_sections", null] },
        "mutations": { "const": "authentication_login_only" },
        "authState": { "const": "in_memory_per_role" },
        "dynamicRoutes": { "enum": ["safe_visible_link_discovery", "root_access_only"] },
        "actions": { "enum": ["internal_read_only_anchor_navigation", "root_access_only"] },
        "routeConcurrency": { "type": "integer", "minimum": 1, "maximum": 12 },
        "deadlineMs": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "attendedGates": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/roleName" },
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/attendedGate" }
      }
    },
    "accessMatrix": { "$ref": "#/$defs/accessMatrix" },
    "roles": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/roleName" },
      "additionalProperties": { "$ref": "#/$defs/roleResult" }
    },
    "summary": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["totalStaticChecks", "passedStaticChecks", "failedStaticChecks", "failedRoles", "totalAccessProbes", "failedAccessProbes", "totalDynamicChecks", "passedDynamicChecks", "failedDynamicChecks", "notApplicableDynamicRoutes", "totalRedirectChecks", "passedRedirectChecks", "failedRedirectChecks", "notApplicableRedirectChecks", "totalRequiredActions", "satisfiedRequiredActions", "failedRequiredActions", "abortedDataRequestCount"],
          "properties": {
            "totalStaticChecks": { "type": "integer", "minimum": 0 },
            "passedStaticChecks": { "type": "integer", "minimum": 0 },
            "failedStaticChecks": { "type": "integer", "minimum": 0 },
            "failedRoles": { "type": "integer", "minimum": 0 },
            "totalAccessProbes": { "type": "integer", "minimum": 0 },
            "failedAccessProbes": { "type": "integer", "minimum": 0 },
            "totalDynamicChecks": { "type": "integer", "minimum": 0 },
            "passedDynamicChecks": { "type": "integer", "minimum": 0 },
            "failedDynamicChecks": { "type": "integer", "minimum": 0 },
            "notApplicableDynamicRoutes": { "type": "integer", "minimum": 0 },
            "totalRedirectChecks": { "type": "integer", "minimum": 0 },
            "passedRedirectChecks": { "type": "integer", "minimum": 0 },
            "failedRedirectChecks": { "type": "integer", "minimum": 0 },
            "notApplicableRedirectChecks": { "type": "integer", "minimum": 0 },
            "totalRequiredActions": { "type": "integer", "minimum": 0 },
            "satisfiedRequiredActions": { "type": "integer", "minimum": 0 },
            "failedRequiredActions": { "type": "integer", "minimum": 0 },
            "vercelToolbarCspDiagnosticCount": { "type": "integer", "minimum": 0 },
            "abortedDataRequestCount": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "fatalError": { "type": ["string", "null"] }
  },
  "$defs": {
    "roleName": { "enum": ["member", "admin", "employer", "partner", "counselor"] },
    "attendedGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "blockedWriteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "type": "string", "pattern": "^[A-Z]{1,12}$" },
        "path": { "type": "string", "pattern": "^/", "maxLength": 240 }
      }
    },
    "abortedDataRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "resourceType", "prefetch", "rsc"],
      "properties": {
        "method": { "enum": ["GET", "HEAD"] },
        "path": { "type": "string", "pattern": "^/", "maxLength": 240 },
        "resourceType": { "enum": ["fetch", "xhr"] },
        "prefetch": { "type": "boolean" },
        "rsc": { "type": "boolean" }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "height"],
      "properties": {
        "name": { "enum": ["desktop", "mobile"] },
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      }
    },
    "desktopViewport": {
      "allOf": [
        { "$ref": "#/$defs/viewport" },
        { "properties": { "name": { "const": "desktop" }, "width": { "const": 1440 }, "height": { "const": 900 } } }
      ]
    },
    "mobileViewport": {
      "allOf": [
        { "$ref": "#/$defs/viewport" },
        { "properties": { "name": { "const": "mobile" }, "width": { "const": 390 }, "height": { "const": 844 } } }
      ]
    },
    "credentialError": {
      "type": "object",
      "required": ["role", "code", "required"],
      "properties": {
        "role": { "$ref": "#/$defs/roleName" },
        "code": { "enum": ["missing_credentials", "partial_credentials", "reused_identity", "authenticated_identity_reused"] },
        "conflictsWith": { "$ref": "#/$defs/roleName" },
        "required": { "type": "array", "items": { "type": "string" } }
      }
    },
    "inventory": {
      "type": "object",
      "required": ["ok", "generatedAt", "sections", "unexpectedManifestSections"],
      "properties": {
        "ok": { "type": "boolean" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "sections": { "type": "object" },
        "unexpectedManifestSections": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dynamicRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "requirement", "status", "reason", "discoveredFrom", "routeCheck"],
      "properties": {
        "pattern": { "type": "string" },
        "requirement": { "enum": ["required", "when_discoverable"] },
        "status": { "enum": ["passed", "failed", "not_applicable"] },
        "reason": { "type": "string" },
        "discoveredFrom": { "type": ["string", "null"] },
        "routeCheck": { "anyOf": [{ "$ref": "#/$defs/routeRow" }, { "type": "null" }] }
      }
    },
    "accessProbe": {
      "type": "object",
      "required": ["sourceRole", "targetRole", "expectation", "requestedPath", "finalPathname", "targetUsable", "denialEvidence", "failureReasons", "abortedDataRequestCount", "abortedDataRequests", "ok"],
      "properties": {
        "sourceRole": { "$ref": "#/$defs/roleName" },
        "targetRole": { "$ref": "#/$defs/roleName" },
        "expectation": { "enum": ["allowed", "denied"] },
        "requestedPath": { "type": "string" },
        "finalPathname": { "type": ["string", "null"] },
        "targetUsable": { "type": "boolean" },
        "denialEvidence": { "type": ["string", "null"] },
        "failureReasons": { "type": "array", "items": { "type": "string" } },
        "abortedDataRequestCount": { "type": "integer", "minimum": 0 },
        "abortedDataRequests": { "type": "array", "items": { "$ref": "#/$defs/abortedDataRequest" }, "maxItems": 10 },
        "ok": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    "accessMatrix": {
      "type": "object",
      "required": ["policy", "probes", "summary"],
      "properties": {
        "policy": { "type": "object" },
        "probes": { "type": "array", "items": { "$ref": "#/$defs/accessProbe" } },
        "summary": {
          "type": "object",
          "required": ["total", "passed", "failed"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "routeRow": {
      "type": "object",
      "required": [
        "role",
        "viewport",
        "path",
        "expectedPath",
        "finalUrl",
        "originMatched",
        "queryVariantMatched",
        "documentStatus",
        "failureReasons",
        "ok",
        "h1Count",
        "horizontalOverflowPx",
        "errorFallbackDetected",
        "errorFallbackStates",
        "auditSuppressedStates",
        "readOnlyCapabilityActive",
        "blockedWriteRequestCount",
        "blockedWriteRequests",
        "abortedDataRequestCount",
        "abortedDataRequests",
        "blockedTelemetryRequestCount",
        "suppressedSideEffectRequestCount",
        "unnamedInteractiveControls"
      ],
      "properties": {
        "role": { "$ref": "#/$defs/roleName" },
        "viewport": { "enum": ["desktop", "mobile"] },
        "path": { "type": "string" },
        "expectedPath": { "type": "string" },
        "finalUrl": { "type": "string" },
        "originMatched": { "type": "boolean" },
        "queryVariantMatched": { "type": "boolean" },
        "documentStatus": { "type": ["integer", "null"] },
        "failureReasons": { "type": "array", "items": { "type": "string" } },
        "ok": { "type": "boolean" },
        "h1Count": { "type": "integer", "minimum": 0 },
        "horizontalOverflowPx": { "type": "number", "minimum": 0 },
        "errorFallbackDetected": { "type": "boolean" },
        "errorFallbackStates": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
        "auditSuppressedStates": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
        "readOnlyCapabilityActive": { "type": "boolean" },
        "vercelToolbarCspDiagnosticCount": { "type": "integer", "minimum": 0 },
        "blockedWriteRequestCount": { "type": "integer", "minimum": 0 },
        "blockedWriteRequests": { "type": "array", "items": { "$ref": "#/$defs/blockedWriteRequest" }, "maxItems": 10 },
        "abortedDataRequestCount": { "type": "integer", "minimum": 0 },
        "abortedDataRequests": { "type": "array", "items": { "$ref": "#/$defs/abortedDataRequest" }, "maxItems": 10 },
        "blockedTelemetryRequestCount": { "type": "integer", "minimum": 0 },
        "suppressedSideEffectRequestCount": { "type": "integer", "minimum": 0 },
        "unnamedInteractiveControls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "viewportResult": {
      "type": "object",
      "required": ["viewport", "summary", "rows"],
      "properties": {
        "viewport": { "$ref": "#/$defs/viewport" },
        "summary": {
          "type": "object",
          "required": ["total", "passed", "failed"],
          "properties": {
            "total": { "type": "integer" },
            "passed": { "type": "integer" },
            "failed": { "type": "integer" }
          }
        },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/routeRow" } }
      }
    },
    "actionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "required", "requiredWhenApplicable", "sourcePath", "target", "status", "reason", "finalUrl", "failureReasons", "blockedWriteRequestCount", "blockedWriteRequests", "abortedDataRequestCount", "abortedDataRequests", "blockedTelemetryRequestCount", "suppressedSideEffectRequestCount"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["read_only_navigation", "read_only_discovered_navigation"] },
        "required": { "type": "boolean" },
        "requiredWhenApplicable": { "type": "boolean" },
        "sourcePath": { "type": "string" },
        "target": { "type": "string" },
        "status": { "enum": ["passed", "failed", "not_applicable"] },
        "reason": { "type": "string" },
        "finalUrl": { "type": ["string", "null"] },
        "failureReasons": { "type": "array", "items": { "type": "string" } },
        "blockedWriteRequestCount": { "type": "integer", "minimum": 0 },
        "blockedWriteRequests": { "type": "array", "items": { "$ref": "#/$defs/blockedWriteRequest" }, "maxItems": 10 },
        "abortedDataRequestCount": { "type": "integer", "minimum": 0 },
        "abortedDataRequests": { "type": "array", "items": { "$ref": "#/$defs/abortedDataRequest" }, "maxItems": 10 },
        "blockedTelemetryRequestCount": { "type": "integer", "minimum": 0 },
        "suppressedSideEffectRequestCount": { "type": "integer", "minimum": 0 },
        "vercelToolbarCspDiagnosticCount": { "type": "integer", "minimum": 0 }
      }
    },
    "actionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["results", "summary"],
      "properties": {
        "results": { "type": "array", "items": { "$ref": "#/$defs/actionResult" } },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "passed", "failed", "notApplicable", "required", "satisfiedRequired", "failedRequired"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "notApplicable": { "type": "integer", "minimum": 0 },
            "required": { "type": "integer", "minimum": 0 },
            "satisfiedRequired": { "type": "integer", "minimum": 0 },
            "failedRequired": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "redirectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "target", "reason", "resolvedSourcePath", "resolvedTargetPath", "status", "resultReason", "finalUrl", "failureReasons", "blockedWriteRequestCount", "blockedWriteRequests", "abortedDataRequestCount", "abortedDataRequests", "blockedTelemetryRequestCount", "suppressedSideEffectRequestCount"],
      "properties": {
        "path": { "type": "string" },
        "target": { "type": "string" },
        "reason": { "type": "string" },
        "resolvedSourcePath": { "type": ["string", "null"] },
        "resolvedTargetPath": { "type": ["string", "null"] },
        "status": { "enum": ["passed", "failed", "not_applicable"] },
        "resultReason": { "type": "string" },
        "finalUrl": { "type": ["string", "null"] },
        "failureReasons": { "type": "array", "items": { "type": "string" } },
        "blockedWriteRequestCount": { "type": "integer", "minimum": 0 },
        "blockedWriteRequests": { "type": "array", "items": { "$ref": "#/$defs/blockedWriteRequest" }, "maxItems": 10 },
        "abortedDataRequestCount": { "type": "integer", "minimum": 0 },
        "abortedDataRequests": { "type": "array", "items": { "$ref": "#/$defs/abortedDataRequest" }, "maxItems": 10 },
        "blockedTelemetryRequestCount": { "type": "integer", "minimum": 0 },
        "suppressedSideEffectRequestCount": { "type": "integer", "minimum": 0 }
      }
    },
    "redirectCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["results", "summary"],
      "properties": {
        "results": { "type": "array", "items": { "$ref": "#/$defs/redirectResult" } },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "passed", "failed", "notApplicable"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "notApplicable": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "roleResult": {
      "type": "object",
      "required": ["status", "loginRedirect", "auth", "dynamicRoutes", "redirectCoverage", "actionCoverage", "accessProbeFailures", "viewports", "error"],
      "properties": {
        "status": { "enum": ["running", "passed", "failed"] },
        "loginRedirect": { "type": "string" },
        "auth": { "$ref": "#/$defs/roleAuth" },
        "dynamicRoutes": { "type": "array", "items": { "$ref": "#/$defs/dynamicRoute" } },
        "redirectCoverage": { "$ref": "#/$defs/redirectCoverage" },
        "actionCoverage": { "$ref": "#/$defs/actionCoverage" },
        "accessProbeFailures": { "type": "integer", "minimum": 0 },
        "viewports": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/viewportResult" }
        },
        "error": { "type": ["string", "null"] }
      }
    },
    "roleAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentialSource", "storageState", "loginFinalPathname", "identityVerification", "blockedPostLoginWriteRequestCount", "blockedPostLoginTelemetryRequestCount", "suppressedPostLoginSideEffectRequestCount"],
      "properties": {
        "credentialSource": { "enum": ["canonical", "legacy"] },
        "storageState": { "const": "captured_in_memory" },
        "loginFinalPathname": { "type": "string" },
        "identityVerification": { "const": "server_user_id_distinct" },
        "blockedPostLoginWriteRequestCount": { "type": "integer", "minimum": 0 },
        "blockedPostLoginTelemetryRequestCount": { "type": "integer", "minimum": 0 },
        "suppressedPostLoginSideEffectRequestCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
